{
  "env": {
    "GATEGUARD_EXEMPT_GLOBS": ".work/*/*.md,.work/*/*.json,.work/*/specs/**,.work/*/roles/**,.work/*/handoffs/**,.work/*/prompts/**,.work/*/munder/**"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKS_DIR__/stop-guard.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKS_DIR__/bash-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKS_DIR__/write-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKS_DIR__/subagent-log.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
