{
  "env": {
    "GATEGUARD_EXEMPT_GLOBS": ".work/*/*.md,.work/*/*.json,.work/*/specs/**,.work/*/roles/**,.work/*/handoffs/**,.work/*/prompts/**,.work/*/munder/**"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __HOOKS_DIR__/run.mjs stop-guard",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node __HOOKS_DIR__/run.mjs bash-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node __HOOKS_DIR__/run.mjs write-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node __HOOKS_DIR__/run.mjs agent-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __HOOKS_DIR__/run.mjs subagent-log",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node __HOOKS_DIR__/setup.mjs",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
