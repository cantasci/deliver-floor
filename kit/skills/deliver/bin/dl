#!/usr/bin/env bash
# dl — the deterministic half of the /deliver flow.
# The board, phase transitions, worktrees, gates, reviews and merges are run by this script, not by the LLM.
# Michael (the orchestrator) calls these commands through Bash; you can call them from a terminal too.
# Every transition is checked here: a model cannot skip a gate, merge an unreviewed card or exceed the limits.
#
#   dl [-C <repo>] <command> …     -C (or DELIVER_REPO) = run against that repo from any directory
#
#   dl new "<title>" "<request>"   new job: .work/<JOB>/, job/<JOB> branch, integration worktree
#   dl status                      active job's phase + board table + next actions
#   dl next                        the next actions the flow requires, one per line (ACTION args)
#   dl board                       board table only
#   dl phase <phase>               set phase (intake readiness awaiting_clarification planning awaiting_plan_approval executing
#                                  integrating closing awaiting_pr_merge done aborted) — guarded
#   dl jobset '<jq expr>'          update job.json            e.g. dl jobset '.stack=["typescript","react"]'
#   dl readiness                   check the requirements readiness review (readiness.json → readiness.md, QUESTIONS.md)
#   dl clarify <id> "<answer>"     record the human's answer to an open business question (human only)
#   dl decide <id> "<decision>" "<rationale>"   the PM closes an open implementation-detail item (owner pm)
#   dl unfreeze "<reason>"         (human, terminal only) reopen the decisions frozen at planning
#   dl abort "<why>"               (human: /deliver:abort) stop the active job — seats home, worktrees and ACTIVE cleared
#   dl reseal "<reason>"           (human, terminal only) accept an edit made to job.json/board.json outside dl
#   dl roles                       check job.roles against roles.yaml and generate the project's role cards
#                                  (.work/<job>/roles/*.md, ROLES.md) — runs on dl phase planning
#   dl learn <role|all> "<lesson>" --topic <slug> (--card T-xx | --evidence "…") [--scope project|shared|kit]
#                                  propose a lesson, with what happened; it reaches .deliver/knowledge/ with this job's PR
#   dl followup "<finding>" [--card T-xx]   a defect seen outside the job's scope — listed in the PR
#   dl timeline [--json]           where the job's time went: phases, each seat's busy share, per card, nobody working
#   dl knowledge [list|topics|promote <topic> "<rule>"|sync-md]   standards + lessons for the role cards; promote = a new
#                                  standard (with the PR); sync-md → Munder Difflin knowledge graph
#   dl validate                    board.json schema + dependency + scope-overlap check
#   dl ready                       ids of cards that may be dispatched now (deps merged, attempts left)
#   dl wt add <card> [--resume]    card worktree + state=running + attempts+1 (--resume: no bump, after a restart)
#   dl wt rm <card>                remove the card worktree (branch is kept)
#   dl card <card> state <state>   review | blocked | ready (from blocked) | archived ["<reason>" — required after the start]
#   dl card <card> note "<text>"   attach a note to a card (blocked reason, guidance, …)
#   dl reopen <id> "<why>"         before the freeze: an answer that does not answer its question goes back to the human
#   dl pm-decide "<what>" "<why>" [card]   after the start the human is not asked: your decision, logged, listed in the PR
#   dl card <card> retry           human-granted: attempts=0 and state=ready (after guidance)
#   dl card <card> set <field> <value> "<reason>"   change a ready/blocked card's contract (validated, logged, history)
#   dl card add <card.json> "<reason>"              add a card (e.g. a fix card) — gets the next id, validated, logged
#   dl gate <card>                 mechanical gate: right branch, clean tree, commits, in scope, verify passes
#   dl qa <card> pass|fail "<summary>"   record the QA/Test verdict on the card's acceptance criteria
#                                  (needs a passed gate on the current commit)
#   dl review <card> approve|changes "<summary>" [--by <role>]   record a reviewer's verdict (needs gate PASS + QA pass);
#                                  a card with "reviewers": [...] needs every one of them to approve the same commit
#   dl integrate <card>            --no-ff merge into the job branch → merged (needs gate PASS + QA pass +
#                                  review approve, all on the current commit; exit 3 on conflict, 5 when the
#                                  repo's commit rules refuse the merge message)
#   dl baseline                    run verify_full on the job branch before any card (also run by dl phase planning,
#                                  which refuses while it fails: a suite already red is the human's call, at the start)
#   dl suite <card> [--wait]       the whole suite of the card's commit, run in the background since its QA pass
#                                  (dl integrate merges only on its PASS for that commit)
#   dl verify-all                  run verify_full in the integration worktree
#   dl ship                        deliver per merge_mode: human|semi|auto → push + PR (+ auto-merge / merge on green),
#                                  local → merge into the base branch. Needs verify-all PASS + report.md (phase closing)
#   dl pr                          PR state (awaiting_pr_merge): merged → done; closed → aborted; open → checks/review
#   dl approve plan [note]         record the human's plan approval (only when gates.plan is on; off by default)
#   dl reject  plan "<note>"       record the human's rejection of the plan
#   dl md-dispatch <card> <prompt-file>   Munder Difflin: run the card's dev as a worker on the floor
#   dl md-hire                     Munder Difflin: seat one person per role seat (job.roles[].count) — the whole job
#   dl md-seats                    who sits where: pending / starting / live / gone / failed (with why), each seat's open task
#   dl config [--init]            the settings that apply in this repo (kit defaults ⊕ ~/.deliver/config.json ⊕ .deliver.json)
#   dl floor-open "<request>"     /deliver from a terminal in a floor repo: open Munder Difflin on its floor, hand Michael the job
#   dl dispatch munder|subagent "<why>"   (human) switch how this job's roles run: floor seats (default) or subagents
#   dl md-reseat <seat> "<why>" [--model m]   a failed or stuck seat gets a new person (another model for a credit error);
#                                  also spelled dl md-hire --reseat <seat>
#   dl md-send <seat|role> <task> <prompt-file> [--agent a]   a work order to a seat: role card + agent instructions + task
#   dl md-done <seat> "<summary>"  record the seat's "done <task>" report; the seat is free again — refused (the seat is told)
#                                  while the answer file its work order named is missing, empty or invalid JSON
#   dl md-release                  end of job: send every seat home
#   dl md-inbox                    your inbox on the floor: each new message once (sender as seat), then archived; flags unrecorded reports
#   dl agents [card] [--all]       the subagents of this job's cards (from Claude Code's transcripts): id, session, last
#                                  write, API error — continue a stopped one with SendMessage instead of a new agent
#   dl playbook                    the path of the playbook (SKILL.md) of this dl's version — for a CLI that cannot run /deliver
#   dl md-wait [seconds]           wait for the inbox (default 110 s, back within a second of a message), then md-inbox
#   dl cleanup [--all]             remove card worktrees, clear ACTIVE (--all: integration worktree too)
#   dl jobs                        jobs known on this machine (registry)
#   dl seats                       role seats: busy / IDLE, and the card each idle seat should take
#   dl kanban [--html <file>]      the board as kanban columns (To Do · In Progress · QA · Code Review · Done)
#   dl tracker [open|sync|check]   mirror the cards into settings.tracker.kind (local | jira | asana | linear | github) —
#                                  automatic on every step; check: before any job, is the tracker reachable and set up?
#   dl tracker switch <kind> "<why>"  (human: /deliver:tracker) move the active job to another tracker: checked first,
#                                  then the new tool opens the job and every card in its current column
#
# Env: DELIVER_JOB=<id> targets that job instead of .work/ACTIVE · DELIVER_HOME (default ~/.deliver) holds the
#      job registry the hooks use · HIVE_ROOT is set by Munder Difflin (md-dispatch).
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$BIN_DIR/.." && pwd)"
CONFIG="$SKILL_DIR/config.json"
USER_CONFIG="${DELIVER_HOME:-$HOME/.deliver}/config.json"   # the user's settings — install and plugin updates leave it alone
REG="${DELIVER_HOME:-$HOME/.deliver}/jobs"

# Installed as a Claude Code plugin, the kit's agents are namespaced (<plugin>:<agent>, e.g. deliver:backend-dev).
# Job and board files keep the canonical names; agent_call gives the name to invoke. Plugin mode: the kit carries its
# plugin manifest and Claude Code has that plugin installed — it may load it from its cache or, for a marketplace added
# from a local folder, straight from the source folder (seen live). DELIVER_AGENT_NS overrides (claude --plugin-dir kit).
if [[ -z ${DELIVER_AGENT_NS+x} ]]; then
  DELIVER_AGENT_NS=""
  if [[ -f $SKILL_DIR/../../.claude-plugin/plugin.json ]]; then
    _pn="$(jq -r '.name // empty' "$SKILL_DIR/../../.claude-plugin/plugin.json")"
    if [[ -n $_pn ]] && { [[ $SKILL_DIR == */plugins/cache/* ]] \
         || jq -e --arg n "$_pn@" '.plugins // {} | keys | any(startswith($n))' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json" >/dev/null 2>&1; }; then
      DELIVER_AGENT_NS=$_pn
    fi
  fi
fi
export DELIVER_AGENT_NS
agent_call() { # agent_call <canonical agent> → the name to invoke (only the kit's own agents get the namespace)
  if [[ -n $DELIVER_AGENT_NS && $1 != *:* && -f $SKILL_DIR/../../agents/$1.md ]]; then echo "$DELIVER_AGENT_NS:$1"; else echo "$1"; fi
}

die() { echo "dl: $*" >&2; exit 1; }
refuse() { local code=$1; shift; echo "dl: REFUSED — $*" >&2; exit "$code"; }
# Human decisions are never taken inside an unattended session (run-headless.sh sets DELIVER_HEADLESS=1 for claude -p).
# The bash-guard hook stops them too; this check holds whatever name the command is called by.
human_only() { [[ ${DELIVER_HEADLESS:-} == 1 ]] && refuse 8 "$1 is the human's decision and this session is unattended (DELIVER_HEADLESS=1). Write it down (QUESTIONS.md / APPROVAL.md) and stop; the human runs it with its /deliver:<command> in Claude Code (/deliver:approve, /deliver:answer, /deliver:retry …)."; return 0; }
command -v jq >/dev/null || die "jq is required (brew install jq / apt install jq)"
command -v git >/dev/null || die "git is required"

if [[ ${1:-} == -C ]]; then DELIVER_REPO="${2:?dl -C <repo>}"; shift 2; fi

resolve_root() {
  local from=${DELIVER_REPO:-}
  if [[ -z $from && -n ${DELIVER_JOB:-} && -f $REG/$DELIVER_JOB ]]; then from="$(cat "$REG/$DELIVER_JOB")"; fi
  common_dir="$(git -C "${from:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "not inside a git repository (use: dl -C <repo> …)"
  ROOT="$(cd "$common_dir/.." && pwd)"   # the main checkout, even when called from inside a worktree
  WORK="$ROOT/.work"
}

STATES="ready running review merged blocked archived"
PHASES="intake readiness awaiting_clarification planning awaiting_plan_approval executing integrating closing awaiting_pr_merge done aborted"
MERGE_MODES="human semi auto local"
MD_PROVIDERS="claude codex gemini grok kimi qwen opencode crush pi copilot cursor antigravity"
GH="${DELIVER_GH:-gh}"
now() { date -u +%FT%TZ; }

# Parallel dl calls (Michael gating two cards at once, two floor workers finishing together) must not lose
# updates: every read-modify-write of a job file and every git ref/worktree change runs under a lock.
with_lock() { # with_lock <name> <command…>
  local d="${WORK:-/tmp}/.lock-$1" n=0 rc=0
  mkdir -p "$(dirname "$d")"
  until mkdir "$d" 2>/dev/null; do
    if [[ -n "$(find "$d" -maxdepth 0 -mmin +2 2>/dev/null)" ]]; then rmdir "$d" 2>/dev/null; continue; fi  # stale (>2 min)
    sleep 0.1; n=$((n+1)); (( n < 1200 )) || die "lock $1 busy for 2 minutes ($d)"
  done
  "${@:2}" || rc=$?
  rmdir "$d" 2>/dev/null; return $rc
}
_jq_inplace() {
  local f=$1; shift
  local tmp; tmp="$(mktemp "$f.XXXXXX")"
  if jq "$@" "$f" > "$tmp"; then mv "$tmp" "$f"; else rm -f "$tmp"; die "jq update failed on $f"; fi
  seal "$f"
}
# Tamper evidence: dl seals job.json (always) and board.json (once work has started) with a sha256 after every write;
# every dl command checks the seals, so an edit made outside dl — by any tool — stops the flow until a human reseals.
seal() { [[ $1 == */job.json || $1 == */board.json ]] && node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync(process.argv[1])).digest("hex"))' "$1" > "$(dirname "$1")/.seal-$(basename "$1")"; return 0; }
seal_ok() { local f=$1 sf; sf="$(dirname "$f")/.seal-$(basename "$f")"; [[ ! -f $sf ]] || [[ "$(cat "$sf")" == "$(node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync(process.argv[1])).digest("hex"))' "$f")" ]]; }
# A writer replaces the file and then its seal under the file's lock: a mismatch read in between is a write in progress,
# not tampering — look again once the writer is done (seen with parallel dl calls).
seal_settled() { seal_ok "$1" || with_lock "$(basename "$1")" seal_ok "$1"; }
check_seals() {
  seal_settled "$JOBJ" || refuse 7 "job.json was modified outside dl. Flow state changes only through dl; a human inspects the change and runs: dl reseal \"<reason>\""
  case "$(jq -r .phase "$JOBJ")" in intake|readiness|awaiting_clarification|planning|awaiting_plan_approval) return 0 ;; esac
  seal_settled "$BOARD" || refuse 7 "board.json was modified outside dl (use dl card set / dl card add). A human inspects the change and accepts it with /deliver:reseal <reason>"
}
jq_inplace() { with_lock "$(basename "$1")" _jq_inplace "$@"; }   # jq_inplace <file> <jq args...>
git_locked() { with_lock git git "$@"; }

load_job() {
  resolve_root
  JOB="${DELIVER_JOB:-}"
  if [[ -z $JOB ]]; then
    [[ -f "$WORK/ACTIVE" ]] || die "no active job — start one with /deliver:new <request> (Michael: dl new \"<title>\" \"<request>\")"
    JOB="$(cat "$WORK/ACTIVE")"
  fi
  JOB_DIR="$WORK/$JOB"
  JOBJ="$JOB_DIR/job.json"
  BOARD="$JOB_DIR/board.json"
  [[ -f $JOBJ ]] || die "job not found: $JOB"
  JOB_BRANCH="$(jq -r .branch "$JOBJ")"
  IWT="$(jq -r .integration_worktree "$JOBJ")"
  DELIVER_SHARED_KNOWLEDGE="$(jq -r '.settings.knowledge.dir // ""' "$JOBJ")"; export DELIVER_SHARED_KNOWLEDGE
  [[ ${DL_NO_SEAL_CHECK:-} == 1 ]] || check_seals
}

setting() { jq -r ".settings.$1 // empty" "$JOBJ"; }
phase_now() { jq -r .phase "$JOBJ"; }

card_exists() { jq -e --arg id "$1" '.cards[] | select(.id==$id)' "$BOARD" >/dev/null || die "no such card: $1"; }
card_get() { jq -r --arg id "$1" ".cards[] | select(.id==\$id) | $2" "$BOARD"; }
card_set() { local id=$1; shift; jq_inplace "$BOARD" --arg id "$id" "$@"; }
branch_head() { git -C "$ROOT" rev-parse --verify -q "refs/heads/$1" 2>/dev/null || true; }
# files changed between two commits that fall OUTSIDE the given globs (empty = all inside)
outside() { git -C "$ROOT" diff --no-renames --name-only "$1" "$2" | node "$BIN_DIR/scope.mjs" "$3"; }
blob_at() { git -C "$1" rev-parse -q --verify "$2:$3" 2>/dev/null || echo none; }   # blob_at <dir> <rev> <path>
# qa_files <dir> <rev> <globs> → files of <rev> inside the globs
qa_files() { comm -23 <(git -C "$1" ls-tree -r --name-only "$2" | sort) <(git -C "$1" ls-tree -r --name-only "$2" | node "$BIN_DIR/scope.mjs" "$3" | sort); }
# the card's gate still holds on <head>: it passed on <head>, or only QA test files changed since
gate_holds() { # gate_holds <card> <head>
  local g; g="$(card_get "$1" .gate.head)"
  [[ "$(card_get "$1" .gate.result)" == PASS ]] || return 1
  [[ $g == "$2" ]] && return 0
  git -C "$ROOT" merge-base --is-ancestor "$g" "$2" 2>/dev/null && [[ -z "$(outside "$g" "$2" "$(card_get "$1" '.qa_scope // []')")" ]]
}

log_event() { printf '%s\t%s\t%s\n' "$(now)" "$1" "$2" >> "$JOB_DIR/events.log"; }
reset_stop_guard() { rm -f "$JOB_DIR/.stop-blocks"; }

# Mirror a change into the tracker (local kanban / Jira / …). board.json stays the source of truth, so a tracker
# outage never blocks the flow: the error is logged and shown by dl status, and the next sync catches up.
tracker() { # tracker sync [card] [--event text] | note <card> <author> <text> | open
  [[ -f $BOARD ]] || return 0
  local out rc=0; out="$(with_lock board.json node "$BIN_DIR/tracker-cli.mjs" "$1" "$JOB_DIR" "${@:2}" 2>&1)" || rc=$?
  seal "$BOARD"; seal "$JOBJ"; [[ $rc -eq 0 ]] && return 0
  printf '%s\t%s\t%s\n' "$(now)" tracker-error "$out" >> "$JOB_DIR/events.log"
  echo "dl: warning — tracker: $out" >&2; return 0
}

run_setup() { # per-worktree setup command (node_modules, etc.)
  local dir=$1 cmd; cmd="$(setting worktree_setup)"
  [[ -n $cmd ]] || return 0
  (cd "$dir" && ROOT="$ROOT" bash -c "$cmd") >> "$JOB_DIR/setup.log" 2>&1 \
    || echo "dl: warning — worktree_setup failed in $dir, see $JOB_DIR/setup.log" >&2
}

table() { # tab-separated stdin → aligned columns (no dependency on `column`)
  awk -F'\t' '{ for (i=1;i<=NF;i++) { c[NR,i]=$i; if (length($i)>w[i]) w[i]=length($i) } if (NF>n) n=NF; r=NR }
    END { for (j=1;j<=r;j++) { line=""; for (i=1;i<=n;i++) line=line sprintf(i<n?"%-" w[i]+2 "s":"%s", c[j,i]); print line } }'
}

# ---------------------------------------------------------------------------------------------------------------

# Card branches are pushed by dl (never by agents) when settings.push_branches allows it: "auto" = when there is an
# origin and merge_mode is not local. That makes every branch visible on the Git host and in the tracker.
push_card() {
  local card=$1 mode; mode="$(setting push_branches)"; mode=${mode:-auto}
  [[ $mode == false ]] && return 0
  git -C "$ROOT" remote get-url origin >/dev/null 2>&1 || return 0
  [[ $mode == auto && "$(setting merge_mode)" == local ]] && return 0
  local br; br="$(card_get "$card" .branch)"
  if git_locked -C "$ROOT" push -q -u origin "$br" >/dev/null 2>&1; then
    local url; url="$(git -C "$ROOT" config --get remote.origin.url | sed -E 's#^git@github.com:#https://github.com/#; s#\.git$##')"
    [[ $url == https://github.com/* ]] && card_set "$card" '(.cards[] | select(.id==$id)).branch_url = $u' --arg u "$url/tree/$br"
    log_event push "$br"
  else
    log_event push-error "$br (push failed — the branch stays local)"
  fi
}

# The project's config file: .deliver.json at the repo root manages /deliver for that repo (run mode, models per role,
# merge mode, verify command, tracker…). The first /deliver writes a complete one; `dl config` shows what applies.
SCHEMA_URL="https://raw.githubusercontent.com/cantasci/deliver-floor/main/kit/skills/deliver/deliver.schema.json"
project_config_template() { # what the repo says (detect.mjs: test script, lockfile, remote, the floor it is registered on)
  local d; d="$(node "$BIN_DIR/detect.mjs" "$ROOT")" || die "could not read $ROOT to write .deliver.json"
  # over the kit defaults ⊕ the user's own config ($DELIVER_HOME/config.json), so the new file starts from what they chose
  jq -n --arg schema "$SCHEMA_URL" --argjson d "$d" --slurpfile c <(merged_settings) '
    {"$schema": $schema,
     dispatch: $c[0].dispatch,
     verify_full: $d.verify_full, worktree_setup: $d.worktree_setup, worktree_exclude: ((($c[0].worktree_exclude // []) + $d.worktree_exclude) | unique), merge_mode: $d.merge_mode,
     max_parallel: $c[0].max_parallel, max_attempts: $c[0].max_attempts,
     roles: {},
     munder: ($c[0].munder | {hive_root: (if $d.hive_root != "" then $d.hive_root else .hive_root end), model, seat_timeout_minutes, app_command: ""}),
     tracker: {kind: "local"},
     commit: ($c[0].commit + (if ($c[0].commit.convention // "auto") == "auto" then {convention: $d.commit_convention} else {} end))}'
}
ensure_project_config() { # writes .deliver.json when the repo has none; says so
  [[ -f $ROOT/.deliver.json ]] && return 0
  local t; t="$(project_config_template)" || die "could not write $ROOT/.deliver.json"
  printf '%s\n' "$t" > "$ROOT/.deliver.json"
  echo "created $ROOT/.deliver.json — this repo's /deliver settings, read from the repo:" >&2
  node "$BIN_DIR/detect.mjs" "$ROOT" | jq -r --slurpfile f "$ROOT/.deliver.json" '.evidence | to_entries[] | . as $e | ($f[0] | if $e.key == "hive_root" then .munder.hive_root elif $e.key == "commit" then .commit.convention else .[$e.key] end | tostring) as $v | "  \($e.key): \(if $v == "" then "(empty)" else $v end) — \($e.value)"' >&2 2>/dev/null || true
  echo "Edit it any time; dl config shows what applies." >&2
}
cmd_config() { # dl config [--init] — the settings that apply in this repo (kit defaults ⊕ .deliver.json)
  resolve_root
  if [[ ${1:-} == --init ]]; then [[ -f $ROOT/.deliver.json ]] && { echo "$ROOT/.deliver.json exists"; return 0; }; ensure_project_config; return 0; fi
  echo "# kit defaults$([[ -f $USER_CONFIG ]] && echo " ⊕ $USER_CONFIG (yours)")$([[ -f $ROOT/.deliver.json ]] && echo " ⊕ $ROOT/.deliver.json" || echo " (no .deliver.json yet — dl config --init writes one)")"
  merged_settings
}

cmd_new() {
  resolve_root
  local title=${1:-} request=${2:-${1:-}}
  [[ -n $title ]] || die 'usage: dl new "<title>" "<request>"'
  command -v node >/dev/null || die "node is required"
  if [[ -f "$WORK/ACTIVE" ]]; then
    local cur; cur="$(cat "$WORK/ACTIVE")"
    [[ -f "$WORK/$cur/job.json" ]] && refuse 1 "job $cur is still active (phase $(jq -r .phase "$WORK/$cur/job.json")). Finish it, or the human stops it with /deliver:abort <why>"
  fi
  local slug id base
  slug="$(node -e 'const s=process.argv[1].replace(/ı/g,"i").replace(/İ/g,"i").normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"").slice(0,32).replace(/-$/,"");console.log(s||"job")' "$title")"
  id="JOB-$(date +%Y%m%d-%H%M)-$slug"
  [[ ! -e "$WORK/$id" ]] || die "already exists: $id"

  ensure_project_config
  # Settings: the skill's config.json (shipped defaults, replaced by every install and plugin update), overridden by the
  # user's own $DELIVER_HOME/config.json (survives both), overridden by .deliver.json at the repo root.
  local settings f
  settings="$(cat "$CONFIG")"
  for f in "$USER_CONFIG" "$ROOT/.deliver.json"; do
    [[ -f $f ]] || continue
    settings="$(jq -s '.[0] * .[1] | del(."$schema")' <(printf '%s' "$settings") "$f")" || die "$f is not valid JSON"
  done
  # Older .deliver.json files said merge_strategy: pr|local.
  settings="$(jq 'if .merge_strategy then .merge_mode = (if .merge_strategy == "local" then "local" else (.merge_mode // "human") end) | del(.merge_strategy) else . end' <<<"$settings")"
  # Commit messages follow the repo's convention (dl's own merges, the devs', QA's): "auto" is resolved now, from the tools that
  # enforce one (commitlint, commitizen, a commit-msg hook) or the history, and kept with the job.
  if [[ "$(jq -r '.commit.convention // "auto"' <<<"$settings")" == auto ]]; then
    local cc; cc="$(node "$BIN_DIR/detect.mjs" --commit "$ROOT")" || cc='{"convention":"plain","source":"not detected"}'
    settings="$(jq --argjson c "$cc" '.commit.convention = $c.convention | .commit.convention_source = $c.source' <<<"$settings")"
  fi
  # The shared knowledge repo (settings.knowledge.repo), when the team has one: cloned once, brought up to date at every
  # job's start. Offline or refused, the job goes on with the copy it has and says so.
  local krepo kdir; krepo="$(jq -r '.knowledge.repo // ""' <<<"$settings")"
  if [[ -n $krepo ]]; then
    kdir="$(dirname "$USER_CONFIG")/shared/$(basename "${krepo%.git}")"
    if [[ -d $kdir/.git ]]; then
      local kb; kb="$(jq -r '.knowledge.branch // ""' <<<"$settings")"; [[ -n $kb ]] || kb="$(git -C "$kdir" symbolic-ref --short -q HEAD || echo main)"
      { git -C "$kdir" fetch -q origin "$kb" && git -C "$kdir" checkout -q "$kb" && git -C "$kdir" merge -q --ff-only "origin/$kb"; } >/dev/null 2>&1 \
        || echo "dl: the shared knowledge repo could not be updated ($krepo) — using the copy from $(git -C "$kdir" log -1 --format=%cs 2>/dev/null)" >&2
    else
      mkdir -p "$(dirname "$kdir")"
      git clone -q "$krepo" "$kdir" >/dev/null 2>&1 || { echo "dl: could not clone the shared knowledge repo $krepo — this job runs without it" >&2; kdir=""; }
    fi
    settings="$(jq --arg d "$kdir" '.knowledge.dir = $d' <<<"$settings")"
  fi
  local mm; mm="$(jq -r .merge_mode <<<"$settings")"
  [[ " $MERGE_MODES " == *" $mm "* ]] || die "merge_mode must be one of: $MERGE_MODES (got '$mm')"
  local tk kinds; tk="$(jq -r '.tracker.kind // "local"' <<<"$settings")"
  # Unquoted on purpose: bash 3.2 mangles "{a, b}" inside a $(…) that sits inside a double-quoted string (seen on macOS).
  kinds=$(node --input-type=module -e "import {trackerKinds, loadTrackers} from '$BIN_DIR/tracker.mjs'; await loadTrackers(); console.log(trackerKinds().join(', '))") \
    || die "the trackers in $BIN_DIR/trackers could not be loaded"
  [[ ", $kinds, " == *", $tk, "* ]] || die "tracker.kind '$tk' is not a known tracker ($kinds)"
  base="$(jq -r .base_branch <<<"$settings")"
  if [[ $base == auto || $base == null ]]; then
    base="$(git -C "$ROOT" symbolic-ref --short HEAD 2>/dev/null)" || die "could not resolve base branch (detached HEAD?) — set base_branch in .deliver.json"
  fi
  git -C "$ROOT" rev-parse --verify -q "$base^{commit}" >/dev/null || die "base branch '$base' has no commits"

  mkdir -p "$WORK/$id/handoffs" "$WORK/$id/gates" "$WORK/$id/wt" "$WORK/$id/prompts" "$WORK/$id/specs"
  # Keep .work/ and per-worktree setup artifacts out of git (local exclude, shared by all worktrees;
  # .gitignore is not touched). A `node_modules/` rule does not match a node_modules SYMLINK, hence no slash.
  local excl="$common_dir/info/exclude" p; mkdir -p "$(dirname "$excl")"
  while IFS= read -r p; do
    [[ -n $p ]] && { grep -qxF "$p" "$excl" 2>/dev/null || echo "$p" >> "$excl"; }
  done < <(printf '.work/\n'; jq -r '.worktree_exclude // [] | .[]' <<<"$settings")

  local branch="job/$id" iwt="$WORK/$id/wt/_integration"
  git -C "$ROOT" branch "$branch" "$base"
  git -C "$ROOT" worktree add -q "$iwt" "$branch"

  cp "$SKILL_DIR/templates/plan.md" "$SKILL_DIR/templates/report.md" "$WORK/$id/"
  cp "$SKILL_DIR/templates/board.json" "$WORK/$id/board.json"
  jq --arg id "$id" --arg title "$title" --arg req "$request" --arg base "$base" \
     --arg branch "$branch" --arg iwt "$iwt" --arg now "$(now)" --arg root "$ROOT" \
     --argjson settings "$settings" \
     '.id=$id | .title=$title | .request=$req | .created=$now | .repo=$root | .base_branch=$base
      | .branch=$branch | .integration_worktree=$iwt | .settings=$settings' \
     "$SKILL_DIR/templates/job.json" > "$WORK/$id/job.json"
  seal "$WORK/$id/job.json"
  echo "$id" > "$WORK/ACTIVE"; rm -f "$WORK/FLOOR-PENDING"   # the floor request it came from has started
  mkdir -p "$REG" && echo "$ROOT" > "$REG/$id"
  JOB=$id; JOB_DIR="$WORK/$id"; JOBJ="$JOB_DIR/job.json"
  run_setup "$iwt"
  log_event new "$title"
  echo "$id"
}

cmd_board() {
  load_job
  jq -r '(["ID","STATE","ROLE","AGENT","TRIES","DEPENDS","TITLE"] | @tsv),
         (.cards[] | [.id, .state, .role, .agent, (.attempts|tostring),
                      ((.depends_on // []) | if length==0 then "-" else join(",") end), .title] | @tsv)' \
     "$BOARD" | table
  echo
  jq -r '[.cards[].state] | group_by(.) | map("\(.[0])=\(length)") | join("  ") | "summary: " + (if .=="" then "no cards" else . end)' "$BOARD"
}

cmd_status() {
  resolve_root
  if [[ -z ${DELIVER_JOB:-} && ! -f $WORK/ACTIVE && -f $WORK/FLOOR-PENDING ]]; then   # /deliver handed it to the floor
    jq -r '"no job yet — the request went to Michael on the floor \(.floor) at \(.at) (message \(.id)):\n  \(.request)\nIt starts when Michael reads it: the floor must be open in Munder Difflin (on its floor picker, click Open once)."' "$WORK/FLOOR-PENDING"
    return 0
  fi
  load_job
  jq -r '"job:      \(.id)\ntitle:    \(.title)\nrepo:     \(.repo // "-")\nphase:    \(.phase)\nbranch:   \(.branch)  (base: \(.base_branch))\nplan gate: \(if .settings.gates.plan then (.gates.plan.status // "pending") else "off" end)\nmerge:    \(.settings.merge_mode)\(if .pr.url then "  PR: \(.pr.url) (\(.pr.state // "?"))" else "" end)\ndispatch: \(.settings.dispatch // "subagent")"' "$JOBJ"
  echo
  cmd_board
  local te; te="$(grep -c $'\ttracker-error\t' "$JOB_DIR/events.log" 2>/dev/null || true)"
  [[ ${te:-0} -gt 0 ]] && echo "tracker: $te sync error(s) — last: $(grep $'\ttracker-error\t' "$JOB_DIR/events.log" | tail -1 | cut -f3 | cut -c1-160) (dl tracker sync retries)"
  echo
  echo "next:"; cmd_next | sed 's/^/  /'
}

# Cards that may be dispatched now: ready, every dependency merged, attempts left.
ready_ids() {
  jq -r --argjson max "$(setting max_attempts)" '. as $b | .cards[] | select(.state=="ready")
    | select(.attempts < $max)
    | select(all((.depends_on // [])[]; . as $d
        | ([$b.cards[] | select(.id==$d) | .state] | first // "missing") == "merged"))
    | .id' "$BOARD"
}
cmd_ready() { load_job; ready_ids; }

# The deterministic "what now" for Michael, one action per line.
cmd_next() {
  load_job
  local phase gates_plan; phase="$(phase_now)"
  gates_plan="$(jq -r '.settings.gates.plan' "$JOBJ")"
  case $phase in
    intake)   echo "INTAKE  detect stack, pick roles from roles.yaml (dl jobset '.roles=[…]'), then: dl phase readiness (generates the role cards)" ;;
    readiness|awaiting_clarification)
      local rc=0; node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || rc=$?
      jq -r '(.items // .)[] | select(.status=="open" and .owner=="pm") | "DECIDE  (PM) \(.id) — \(.question)  (record: dl decide \(.id) \"<decision>\" \"<rationale>\")"' "$JOB_DIR/readiness.json" 2>/dev/null
      if [[ ! -f $JOB_DIR/readiness.json ]]; then echo "READINESS BA reviews every requirement against readiness.yaml → .work/$JOB/readiness.json, then: dl readiness"
      elif [[ $rc -eq 1 ]]; then echo "FIX     readiness.json is incomplete — dl readiness lists what is missing"
      elif [[ $rc -eq 3 ]]; then
        [[ $phase == readiness ]] && echo "PHASE   dl phase awaiting_clarification"
        jq -r '(.items // .)[] | select(.status=="open" and .owner!="pm") | "ASK     human: \(.id) — \(.question)  (record: dl clarify \(.id) \"<answer>\")"' "$JOB_DIR/readiness.json"
      elif [[ $rc -eq 4 ]]; then :   # only PM decisions left (listed above)
      else echo "PHASE   dl phase planning  (readiness complete: $(jq '(.items // .) | length' "$JOB_DIR/readiness.json") items decided or n/a; planning freezes them)"; fi ;;
    planning)
      local nxt="dl phase executing  (no plan gate: the human is next at the PR)"; [[ $gates_plan == true ]] && nxt="dl phase awaiting_plan_approval"
      echo "PLAN    BA plan → plan.md · Lead cards → board.json · BA card specs → specs/T-xx.md · dl validate, then: $nxt" ;;
    awaiting_plan_approval)
      case "$(jq -r '.gates.plan.status // "pending"' "$JOBJ")" in
        approved) echo "PHASE   dl phase executing" ;;
        rejected) echo "REVISE  plan/board per the human's note: $(jq -r .gates.plan.note "$JOBJ") — then dl phase awaiting_plan_approval" ;;
        *) [[ $gates_plan == false ]] && echo "PHASE   dl phase executing  (plan gate disabled)" || echo "ASK     human: plan approval (dl approve plan | dl reject plan \"<note>\")" ;;
      esac ;;
    executing)
      local max_par running cap
      max_par="$(setting max_parallel)"
      running="$(jq '[.cards[] | select(.state=="running")] | length' "$BOARD")"
      local maxa; maxa="$(setting max_attempts)"
      jq -r '.cards[] | select(.state=="review") | [.id, (.branch//""), (.gate.result//""), (.gate.head//""), (.qa.verdict//""), (.qa.head//""), (.review.verdict//""), (.review.head//""), (.attempts|tostring)] | join("\u001f")' "$BOARD" |
        while IFS=$'\x1f' read -r id br gres ghead qv qhead rv rhead att; do   # \x1f: a tab separator would merge empty fields
          local head; head="$(branch_head "$br")"
          local failed=""
          if [[ $gres == FAIL && $ghead == "$head" ]]; then failed="gate failed — feedback: $(card_get "$id" .gate.log)"
          elif [[ $qv == fail && $qhead == "$head" ]]; then failed="QA failed — its tests are committed; feedback: $(card_get "$id" .qa.summary)"
          elif [[ $qv == pass && $qhead == "$head" && $rv == changes && $rhead == "$head" ]]; then failed="review asked for changes — feedback: $(card_get "$id" .review.summary)"
          fi
          if [[ -n $failed ]]; then
            if (( att >= maxa )); then echo "BLOCK   $id (failed on its last attempt $att/$maxa: dl card $id state blocked + note)"
            else echo "REDISPATCH $id  ($failed)"; fi
          elif ! gate_holds "$id" "$head"; then echo "GATE    dl gate $id"
          elif [[ $qv != pass || $qhead != "$head" ]]; then
            if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$br-qa" && [[ -z "$(card_get "$id" '.qa_join.head // ""')" && -z $qv ]]; then
              if [[ $(git -C "$ROOT" rev-list --count "$JOB_BRANCH..$br-qa") -gt 0 && -z "$(git -C "$JOB_DIR/wt/$id-qa" status --porcelain 2>/dev/null)" ]]; then echo "QA-JOIN dl qa-join $id  (QA's tests join the card; then QA runs them on the dev's commit → dl qa $id pass|fail)"
              else echo "WAIT    $id  (the QA role is still writing its tests in $JOB_DIR/wt/$id-qa)"; fi
            else echo "QA      $id  (QA/Test role writes + runs the integration/e2e tests for the ACs → dl qa $id pass|fail)"; fi
          elif [[ $rv != approve || $rhead != "$head" ]]; then
            local pend; pend="$(card_get "$id" '(if .review.head == "'"$head"'" then .review.pending else (.reviewers // ["reviewer"]) end) // [] | join(", ")')"
            echo "REVIEW  $id  (reviewers: ${pend:-reviewer} → dl review $id approve|changes \"<summary>\" --by <role>)"
          else echo "INTEGRATE dl integrate $id"; fi
        done
      cap=$(( max_par - running ))
      # awk reads its whole input: `head` would close the pipe early and, under pipefail, kill dl with SIGPIPE
      local r; r="$(ready_ids | awk -v n=$(( cap > 0 ? cap : 0 )) 'NR<=n' | tr '\n' ' ')"
      [[ -n ${r// /} ]] && echo "DISPATCH ${r% }"
      # every idle seat says so — with the work it should take, or what it waits for
      seats_json | jq -r --arg disp " ${r% } " '.[] | select(.busy == null) |
        if (.ready|length)>0 then .ready[0] as $c | "IDLE    \(.seat) — free; take \($c)" + (if ($disp|contains(" " + $c + " ")) then " (in DISPATCH above)" else " (dl seats)" end)
        elif (.waiting|length)>0 then "IDLE    \(.seat) — waiting: \(.waiting|join(", ")) depend on unmerged cards"
        else "IDLE    \(.seat) — no more work for \(.role)" end' 
      # QA writes the tests of every assigned card from its spec while the dev builds (settings.qa_early)
      if [[ "$(setting qa_early)" != false ]]; then
        local qid; for qid in $(jq -r '.cards[] | select(.state=="running" and ((.qa_scope // []) | length) > 0 and .qa == null and .qa_join == null) | .id' "$BOARD"); do
          git -C "$ROOT" show-ref --verify --quiet "refs/heads/$(card_get "$qid" .branch)-qa" \
            || echo "QA-WRITE $qid  (QWT=\$(dl wt qa $qid) → the QA role writes the tests from the spec now, while the dev builds; commits; does not run them yet)"
        done
      fi
      jq -r '.cards[] | select(.state=="running") | "WAIT    \(.id) (agent running)"' "$BOARD"
      jq -r --argjson max "$(setting max_attempts)" '.cards[] | select(.state=="ready" and .attempts >= $max) | "BLOCK   \(.id) (no attempts left: dl card \(.id) state blocked)"' "$BOARD"
      local open; open="$(jq '[.cards[] | select(.state | IN("ready","running","review"))] | length' "$BOARD")"
      local busy=0; { [[ -n ${r// /} || $running -gt 0 ]] || jq -e '.cards[] | select(.state=="review")' "$BOARD" >/dev/null; } && busy=1
      if [[ $open -eq 0 ]] && ! jq -e '.cards[] | select(.state=="blocked")' "$BOARD" >/dev/null; then
        echo "PHASE   dl phase integrating"
      elif [[ $busy -eq 0 ]]; then
        # Nothing moves on its own: Michael decides about every blocked card — the human is not asked after the start.
        jq -r '.cards[] | select(.state=="blocked") | "DECIDE  (PM) blocked \(.id): \((.notes[-1].note) // "no note") (split → dl card add <card.json> \"<why>\" then dl card \(.id) state archived \"<why>\" | drop → dl card \(.id) state archived \"<why it is not delivered>\") — goes into the PR"' "$BOARD"
        jq -r '.cards[] | select(.state=="ready") | "STUCK   \(.id) waits on unmerged dependencies: \(.depends_on|join(","))"' "$BOARD"
        [[ $open -eq 0 ]] && echo "PHASE   dl phase integrating  (once you have split or dropped the blocked cards)"
        true
      fi ;;
    integrating)
      local h; h="$(branch_head "$JOB_BRANCH")"
      if [[ "$(jq -r '.verify_all.result // ""' "$JOBJ")" != PASS ]] || ! verified_head "$h"; then
        echo "VERIFY  dl verify-all"
      else
        echo "QA      job-level QA roles if selected (failure → fix card + dl phase executing), then: dl phase closing"
      fi ;;
    closing)
      if cmp -s "$JOB_DIR/report.md" "$SKILL_DIR/templates/report.md"; then echo "REPORT  BA closing check (every AC with evidence) → report.md"
      else echo "SHIP    dl ship  (merge_mode=$(setting merge_mode))"; fi ;;
    awaiting_pr_merge)
      echo "WAIT    PR $(jq -r '.pr.url // "?"' "$JOBJ") is with the human (merge_mode=$(setting merge_mode)). Check: dl pr — then dl cleanup when done"
      echo "STOP    hand over: tell the human the PR link; resume later with /deliver resume" ;;
    done|aborted) echo "NONE    job is $phase" ;;
  esac
}

cmd_phase() {
  load_job
  [[ ${1:-} == aborted || ${1:-} == readiness ]] || assert_frozen
  local p=${1:-} force=0; [[ ${2:-} == --force ]] && { human_only "dl phase --force"; force=1; }
  [[ " $PHASES " == *" $p "* ]] || die "invalid phase: '$p' — valid: $PHASES"
  local cur; cur="$(phase_now)"
  if [[ $force -eq 0 ]]; then
    [[ $cur == done || $cur == aborted ]] && refuse 1 "job is $cur"
    case $p in
      readiness)
        [[ $cur == intake || $cur == awaiting_clarification || $cur == readiness ]] || refuse 1 "readiness comes after intake (now: $cur)"
        node "$BIN_DIR/roles.mjs" check "$JOBJ" >&2 || refuse 1 "the selected roles are not valid — fix job.roles (dl jobset), see roles.yaml" ;;
      awaiting_clarification)
        [[ $cur == readiness || $cur == awaiting_clarification ]] || refuse 1 "the human is asked only at the start (readiness). Now ($cur) it is your decision: dl pm-decide \"<what>\" \"<why>\" — it goes into the PR"
        local rc=0; node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || rc=$?
        [[ $rc -eq 3 ]] || refuse 1 "there are no open questions for the human (dl readiness)" ;;
      planning)
        node "$BIN_DIR/roles.mjs" check "$JOBJ" >&2 || refuse 1 "the selected roles are not valid — fix job.roles (dl jobset), see roles.yaml"
        local rr=0; node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >&2 || rr=$?
        # (bash 3.2 — macOS — cannot parse a case statement inside $( ): the message is chosen first)
        local why="readiness.json is incomplete (dl readiness)"
        [[ $rr -eq 3 ]] && why="open questions for the human remain (QUESTIONS.md) — ask, record with dl clarify"
        [[ $rr -eq 4 ]] && why="implementation details are open — decide them as PM: dl decide <id> \"<decision>\" \"<rationale>\""
        [[ $rr -eq 0 ]] || refuse 1 "the requirements are not ready: $why"
        baseline_holds ;;
      awaiting_plan_approval)
        node "$BIN_DIR/roles.mjs" check "$JOBJ" >/dev/null || refuse 1 "the selected roles are not valid — dl roles"
        node "$BIN_DIR/validate.mjs" "$BOARD" >/dev/null || refuse 1 "board is not valid — run: dl validate" ;;
      executing)
        # only after planning (the readiness review and its freeze), or back from later for a fix card — never skipping them
        [[ " planning awaiting_plan_approval executing integrating closing awaiting_pr_merge " == *" $cur "* ]] \
          || refuse 1 "executing comes after planning — the readiness review and the plan first (now: $cur)"
        if [[ "$(jq -r .settings.gates.plan "$JOBJ")" != false && "$(jq -r '.gates.plan.status // ""' "$JOBJ")" != approved ]]; then
          refuse 1 "the plan is not approved by the human (gates.plan). Ask them; record with dl approve plan"
        fi
        node "$BIN_DIR/validate.mjs" "$BOARD" >/dev/null || refuse 1 "board is not valid — run: dl validate" ;;
      integrating)
        [[ $cur == executing || $cur == integrating ]] || refuse 1 "integrating comes after executing (now: $cur)"
        jq -e '[.cards[] | select(.state | IN("ready","running","review","blocked"))] | length == 0' "$BOARD" >/dev/null \
          || refuse 1 "cards are not finished: $(jq -r '[.cards[] | select(.state | IN("ready","running","review","blocked")) | "\(.id)=\(.state)"] | join(" ")' "$BOARD") — decide each blocked card yourself: split it (dl card add …) or drop it (dl card <id> state archived \"<reason>\")" ;;
      closing)
        [[ $cur == integrating ]] || refuse 1 "only from integrating (now: $cur)"
        [[ "$(jq -r '.verify_all.result // ""' "$JOBJ")" == PASS ]] && verified_head "$(branch_head "$JOB_BRANCH")" \
          || refuse 1 "verify-all has not passed on the current job branch — run: dl verify-all" ;;
      awaiting_pr_merge) refuse 1 "awaiting_pr_merge is set by: dl ship" ;;
      done) [[ "$(jq -r '.shipped // false' "$JOBJ")" == true ]] || refuse 1 "the job is not delivered yet — dl ship (and, for a PR, its merge: dl pr)" ;;
    esac
  fi
  case $p in # entering a waiting phase asks the question afresh
    awaiting_plan_approval) jq_inplace "$JOBJ" '.gates.plan = null' ;;
  esac
  jq_inplace "$JOBJ" --arg p "$p" '.phase=$p'
  [[ $p == executing ]] && { seal "$BOARD"; tracker open; }
  if [[ $p == planning ]]; then
    jq_inplace "$JOBJ" --arg h "$(sha256_of "$JOB_DIR/readiness.json")" --arg t "$(now)" '.frozen = {"readiness_sha256":$h,"at":$t}'
    log_event freeze "readiness + architecture frozen ($(sha256_of "$JOB_DIR/readiness.json" | cut -c1-12))"
  fi
  [[ $p == readiness || $p == planning ]] && apply_role_defaults
  [[ $p == readiness || $p == planning ]] && { node "$BIN_DIR/roles.mjs" render "$JOB_DIR" >/dev/null && log_event roles "$(jq -r '[.roles[].role] | join(" ")' "$JOBJ")"; }
  reset_stop_guard; log_event phase "$p$([[ $force -eq 1 ]] && echo ' (forced)')"; echo "phase: $p"
}

# jobset may change only what Michael decides (stack, roles, assumptions, areas, settings) — never phase, gates,
# frozen hashes, PR state or ids: those move only through their own guarded commands. Every change is logged.
JOBSET_KEYS='["stack","roles","assumptions","areas","settings"]'
# Several jobsets at once (Michael's parallel tool calls) read job.json before the others wrote it: the last one won and the
# others' changes were lost (seen live: QA's seat count). They run one at a time, under the job lock, in a subshell so a
# refusal still releases it.
cmd_jobset() { load_job; with_lock job _jobset_sub "$@"; }
_jobset_sub() { ( _jobset_locked "$@" ); }
_jobset_locked() {
  [[ -n ${1:-} ]] || die "usage: dl jobset '<jq expr>'"
  local new; new="$(jq "$1" "$JOBJ")" || die "invalid jq expression"
  local bad; bad="$(jq -rn --argjson a "$(cat "$JOBJ")" --argjson b "$new" --argjson ok "$JOBSET_KEYS" \
    '[($a|keys) + ($b|keys) | unique[] | select(. as $k | ($ok | index($k)) | not) | select($a[.] != $b[.])] | join(", ")')"
  [[ -z $bad ]] || refuse 1 "dl jobset may not change: $bad (use the dl command that owns it)"
  if [[ "$(phase_now)" =~ ^(executing|integrating|closing|awaiting_pr_merge)$ ]]; then
    jq -en --argjson a "$(cat "$JOBJ")" --argjson b "$new" '($a.settings.gates == $b.settings.gates) and ($a.settings.merge_mode == $b.settings.merge_mode)' >/dev/null \
      || refuse 1 "gates and merge_mode are fixed once work has started"
  fi
  local changed; changed="$(jq -rn --argjson a "$(cat "$JOBJ")" --argjson b "$new" --argjson ok "$JOBSET_KEYS" '[$ok[] | select($a[.] != $b[.])] | join(",")')"
  jq_inplace "$JOBJ" "$1"
  [[ -n $changed ]] && log_event jobset "$changed: $1"
  apply_role_defaults
  return 0
}

cmd_validate() { load_job; assert_frozen; node "$BIN_DIR/validate.mjs" "$BOARD"; }

sha256_of() { node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync(process.argv[1])).digest("hex"))' "$1"; }
# Once planned, the readiness decisions and the architecture are frozen: every later step checks they are unchanged.
assert_frozen() {
  local want; want="$(jq -r '.frozen.readiness_sha256 // empty' "$JOBJ")"
  [[ -z $want ]] && return 0
  [[ -f $JOB_DIR/readiness.json && "$(sha256_of "$JOB_DIR/readiness.json")" == "$want" ]] \
    || refuse 6 "readiness.json (requirements decisions + architecture) changed after it was frozen at planning. Frozen decisions do not change; only the human can reopen them: /deliver:unfreeze <reason>"
}
cmd_unfreeze() {
  human_only "dl unfreeze"; load_job
  local reason=${1:-}; [[ -n $reason ]] || die 'usage: dl unfreeze "<why the frozen decisions must change>"'
  [[ -n "$(jq -r '.frozen.readiness_sha256 // empty' "$JOBJ")" ]] || refuse 1 "nothing is frozen"
  jq_inplace "$JOBJ" --arg r "$reason" --arg t "$(now)" --arg by "${DELIVER_APPROVER:-${USER:-human}}" \
    '.unfreezes = ((.unfreezes // []) + [(.frozen + {"reason":$r,"by":$by,"at":$t})]) | .frozen = null | .phase = "readiness"'
  reset_stop_guard; log_event unfreeze "$reason"; echo "unfrozen — phase readiness. Re-run the readiness review, then dl phase planning (freezes again)."
}

cmd_readiness() {
  load_job
  local rc=0; node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" || rc=$?
  [[ $rc -eq 1 ]] && exit 1
  log_event readiness "$(jq -r '(.items // .) | "\(length) items: \(map(select(.status=="decided"))|length) decided, \(map(select(.status=="n_a"))|length) n/a, \(map(select(.status=="open"))|length) open"' "$JOB_DIR/readiness.json")"
  return 0
}
# The human is asked only at the start (intake → readiness → awaiting_clarification). From planning on, whatever only a
# person could have decided is Michael's decision: recorded here with its reason and listed in the PR body (report.md).
after_start() { case "$(phase_now)" in intake|readiness|awaiting_clarification) return 1 ;; *) return 0 ;; esac; }
pm_decision() { # pm_decision "<what>" "<why>" [card]
  jq_inplace "$JOBJ" --arg w "$1" --arg y "$2" --arg c "${3:-}" --arg t "$(now)" '.pm_decisions = ((.pm_decisions // []) + [{at:$t, what:$w, why:$y} + (if $c != "" then {card:$c} else {} end)])'
  log_event pm-decision "${3:+$3: }$1 — $2"
}
cmd_pm_decide() {
  load_job
  local what=${1:-} why=${2:-} card=${3:-}
  [[ -n $what && -n $why ]] || die 'usage: dl pm-decide "<what you decided>" "<why>" [card]'
  after_start || refuse 1 "before planning, questions go to the human (dl phase awaiting_clarification); decisions on implementation details: dl decide"
  [[ -z $card ]] || card_exists "$card"
  pm_decision "$what" "$why" "$card"; reset_stop_guard; echo "recorded: $what"
}
# report.md is the PR body: the decisions Michael took himself (after the start, and every re-seat) are appended once, at ship time
# verify-all ran on this head — or on an earlier one, and since then only the job's lessons/standards and its record were committed
verified_head() {
  local v; v="$(jq -r '.verify_all.head // ""' "$JOBJ")"
  [[ $v == "$1" ]] && return 0
  [[ -n $v ]] && git -C "$ROOT" merge-base --is-ancestor "$v" "$1" 2>/dev/null && [[ -z "$(git -C "$ROOT" diff --name-only "$v" "$1" | grep -v '^\.deliver/knowledge/' | grep -v '^\.deliver/jobs/')" ]]
}
# Every change to a card's contract (verify, qa_verify, acceptance, scope …) and to the job's suite (verify_full) after the
# start goes into the PR with its reason: a test command made weaker to get a pass is the human's to see.
report_contract_changes() {
  grep -q '<!-- deliver:contract-changes -->' "$JOB_DIR/report.md" && return 0
  local cards suite; cards="$(jq -r '[.cards[] | .id as $c | (.history // [])[] | "- **\($c)** `\(.field)`: `\(.from | tojson | .[0:160])` → `\(.to | tojson | .[0:160])` — _\(.reason)_ (\(.at))"] | join("\n")' "$BOARD")"
  suite="$(awk -F'\t' '$2=="jobset" && $3 ~ /verify_full|qa_verify_full/ {print "- job settings: `" substr($3,1,200) "` (" $1 ")"}' "$JOB_DIR/events.log" 2>/dev/null)"
  { printf '\n<!-- deliver:contract-changes -->\n## Test and contract changes after the start\n\nWhat was checked changed here, each with its reason — a weaker check is a weaker delivery.\n\n'
    if [[ -z $cards$suite ]]; then echo "None: every card was checked with the contract it was planned with."
    else
      if [[ -n $cards ]]; then printf '%s\n' "$cards"; fi
      if [[ -n $suite ]]; then printf '%s\n' "$suite"; fi
    fi
  } >> "$JOB_DIR/report.md"
}
# The report's acceptance table must account for every AC of the plan: a status and its evidence each, not the template's.
report_ac_errors() {
  local ac row ev st errs=""
  for ac in $(grep -oE '^- (AC-[0-9]+)' "$JOB_DIR/plan.md" 2>/dev/null | sed 's/^- //' | sort -u); do
    row="$(grep -E "^\|[[:space:]]*$ac[[:space:]]*\|" "$JOB_DIR/report.md" | head -n 1)"
    if [[ -z $row ]]; then errs+="$ac has no row; "; continue; fi
    st="$(awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/, "", $3); print $3}' <<<"$row")"; ev="$(awk -F'|' '{gsub(/^[ \t]+|[ \t]+$/, "", $4); print $4}' <<<"$row")"
    [[ -z $st || $st == *" / "* ]] && errs+="$ac has no status; "
    [[ -z $ev || $ev == "test name, gate log, screenshot" ]] && errs+="$ac has no evidence; "
  done
  printf '%s' "$errs"
}
report_decisions() {
  local n; n="$(jq '(.pm_decisions // []) | length' "$JOBJ")"
  grep -q '<!-- deliver:pm-decisions -->' "$JOB_DIR/report.md" && return 0
  { printf '\n<!-- deliver:pm-decisions -->\n## Decisions Michael took himself\n\nTaken without asking you (you are asked only at the start); each with its reason.\n\n'
    if [[ $n -eq 0 ]]; then echo "None: every decision was taken with the human before planning."
    else jq -r '.pm_decisions[] | "- " + (if .card then "**\(.card)** — " else "" end) + "\(.what) — _\(.why)_ (\(.at))"' "$JOBJ"; fi
  } >> "$JOB_DIR/report.md"
}

cmd_decide() {
  load_job
  local id=${1:-} decision=${2:-} why=${3:-}; [[ -n $id && -n $decision && -n $why ]] || die 'usage: dl decide <id> "<decision>" "<rationale>"'
  [[ "$(phase_now)" == readiness || "$(phase_now)" == awaiting_clarification ]] || refuse 1 "decisions are recorded in readiness / awaiting_clarification (now: $(phase_now))"
  node "$BIN_DIR/readiness.mjs" decide "$JOB_DIR" "$id" "$decision" "$why" || exit 1
  node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || true
  reset_stop_guard; log_event decide "$id: $decision — $why"
  # The language of a repo without code is the team's choice — the reviewer of the PR sees it with its reasons.
  [[ $id == ARC-stack ]] && pm_decision "language and runtime: $decision" "$why"
  return 0
}
cmd_reopen() {
  load_job
  local id=${1:-} why=${2:-}; [[ -n $id && -n $why ]] || die 'usage: dl reopen <id> "<why the recorded answer does not answer it>"'
  [[ "$(phase_now)" == readiness || "$(phase_now)" == awaiting_clarification ]] || refuse 1 "items are reopened only at the start, before the freeze (now: $(phase_now)) — after that it is your decision: dl pm-decide"
  node "$BIN_DIR/readiness.mjs" reopen "$JOB_DIR" "$id" "$why" || exit 1
  node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || true   # QUESTIONS.md lists it again
  reset_stop_guard; log_event reopen "$id: $why"; echo "$id is open again — QUESTIONS.md asks it; the human answers with dl clarify"
}
cmd_clarify() {
  human_only "answering a business question (dl clarify)"; load_job
  local id=${1:-} answer=${2:-}; [[ -n $id && -n $answer ]] || die 'usage: dl clarify <id> "<answer>"'
  [[ "$(phase_now)" == readiness || "$(phase_now)" == awaiting_clarification ]] || refuse 1 "clarifications are recorded in readiness / awaiting_clarification (now: $(phase_now))"
  node "$BIN_DIR/readiness.mjs" clarify "$JOB_DIR" "$id" "${DELIVER_APPROVER:-${USER:-human}}" "$answer" || exit 1
  node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || true
  reset_stop_guard; log_event clarify "$id: $answer"
}

# dl learn <role|all> "<lesson>" --topic <slug> (--card T-xx | --evidence "<what happened>") [--scope project|shared|kit]
# A lesson is a proposal of this job, backed by what happened: with --card, the card's failures from the event log (a gate
# FAIL, a QA fail, a review "changes", a block, a refused merge). It reaches the project's .deliver/knowledge/lessons.md (or,
# scope shared, the shared knowledge repo) only through this job's PR; scope kit is a defect of the flow itself, listed for
# the deliver kit in the PR.
# Lessons, standards and follow-ups ride with the job's PR: after dl ship there is no PR left to carry them.
not_shipped() {
  [[ "$(jq -r '.shipped // false' "$JOBJ")" != true && -z "$(jq -r '.knowledge_published.head // ""' "$JOBJ")" ]] \
    || refuse 1 "the job is shipped — what it learned had to be recorded before dl ship (closing, step 3). Record it in the next job (dl learn there, with this job's evidence), or add it to .deliver/knowledge/lessons.md with a PR of its own"
}
cmd_learn() {
  load_job; not_shipped
  local role=${1:-} text=${2:-} topic="" card="" scope=project ev=() a; shift 2 2>/dev/null || true
  while [[ $# -gt 0 ]]; do
    a=$1; case $a in
      --topic) topic=${2:-}; shift 2 ;; --card) card=${2:-}; shift 2 ;; --evidence) ev+=("${2:-}"); shift 2 ;;
      --scope) scope=${2:-}; shift 2 ;; *) die "unknown option: $a" ;;
    esac
  done
  [[ -n $role && -n $text && -n $topic ]] || die 'usage: dl learn <role|all> "<lesson>" --topic <slug> (--card T-xx | --evidence "<what happened>") [--scope project|shared|kit]'
  [[ $topic =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "topic: a short slug, e.g. qa-verify-files (lower-case, digits, -)"
  [[ $scope == project || $scope == shared || $scope == kit ]] || die "scope: project | shared | kit"
  [[ $scope != shared || -n "$(setting knowledge.dir)" ]] || refuse 1 "no shared knowledge repo for this project (settings.knowledge.repo) — a lesson for the shared repo needs one; record it for the project"
  if [[ -n $card ]]; then
    card_exists "$card"
    local l; while IFS= read -r l; do ev+=("$l"); done < <(awk -F'\t' -v c="$card" '($3 ~ "^"c"[ :=]" || $3 ~ "^"c"$") && ($2=="gate" && $3 ~ /FAIL/ || $2=="qa" && $3 ~ / fail / || $2=="review" && $3 ~ / changes/ || $2=="state" && $3 ~ /blocked/ || $2=="note" || $2 ~ /integrate|merge-refused/ && $3 ~ /CONFLICT|REFUSED|refused/) {print $1" "$2": "substr($3,1,200)}' "$JOB_DIR/events.log" | tail -n 3)
  fi
  [[ ${#ev[@]} -gt 0 ]] || refuse 1 "a lesson needs what happened: --card <id> (its failures in the event log are attached) or --evidence \"<what happened>\" — no lessons on assumptions"
  local j r; j="$(jq -cn --arg r "$role" --arg t "$text" --arg tp "$topic" --arg s "$scope" '{role:$r, text:$t, topic:$tp, scope:$s, evidence:$ARGS.positional}' --args ${ev[@]+"${ev[@]}"})"
  r="$(node "$BIN_DIR/knowledge.mjs" learn "$ROOT" "$JOB_DIR" "$j")" || die "the lesson could not be recorded"
  log_event learn "$role ($scope, $topic): $text"
  echo "lesson proposed ($scope, topic $topic) — it reaches $([[ $scope == shared ]] && echo "the shared knowledge repo" || { [[ $scope == kit ]] && echo "the PR, for the deliver kit" || echo ".deliver/knowledge/lessons.md"; }) with this job's PR"
  if [[ "$(jq -r .promote <<<"$r")" == true ]]; then
    echo "PROMOTE: topic '$topic' was learned in $(jq -r .jobs <<<"$r") jobs and no standard covers it yet — make it a rule: dl knowledge promote $topic \"<the rule, one checkable line>\" [--applies-to <kinds/roles>] [--scope project|shared]"
  fi
}
cmd_knowledge() {
  resolve_root
  case ${1:-list} in
    list) node "$BIN_DIR/knowledge.mjs" list "$ROOT" "${2:-}" "${3:-}" "${4:-}" ;;
    topics) load_job; node "$BIN_DIR/knowledge.mjs" topics "$ROOT" "$JOB_DIR" | jq . ;;
    promote) # dl knowledge promote <topic> "<rule>" [--applies-to a,b] [--scope project|shared] — a standard, with this job's PR
      load_job; not_shipped
      local topic=${2:-} rule=${3:-} ap="" sc=project; shift 3 2>/dev/null || true
      while [[ $# -gt 0 ]]; do case $1 in --applies-to) ap=${2:-}; shift 2 ;; --scope) sc=${2:-}; shift 2 ;; *) die "unknown option: $1" ;; esac; done
      [[ -n $topic && -n $rule ]] || die 'usage: dl knowledge promote <topic> "<rule>" [--applies-to dev,qa] [--scope project|shared]'
      [[ "$(node "$BIN_DIR/knowledge.mjs" topics "$ROOT" "$JOB_DIR" | jq -r --arg t "$topic" '.[$t].jobs // 0')" -ge 1 ]] || refuse 1 "no lesson on topic '$topic' — a standard grows out of recorded lessons"
      node "$BIN_DIR/knowledge.mjs" promote "$ROOT" "$JOB_DIR" "$(jq -cn --arg t "$topic" --arg r "$rule" --arg a "$ap" --arg s "$sc" '{topic:$t, rule:$r, scope:$s, applies_to:($a | split(",") | map(select(. != "")))}')" >/dev/null
      log_event promote "$topic ($sc): $rule"; echo "standard proposed: $topic ($sc) — written with this job's PR" ;;
    must) # dl knowledge must <role> — the Must rules (id + text) the role answers to on this job (a reviewer: in dl review)
      load_job; [[ -n ${2:-} ]] || die "usage: dl knowledge must <role>"
      local kind; kind="$(node "$BIN_DIR/roles.mjs" kind "$2" 2>/dev/null)"
      node "$BIN_DIR/knowledge.mjs" must "$ROOT" "${kind:-review}" "$2" "$(jq -r '(.stack // []) | join(",")' "$JOBJ")" | jq -r 'if length == 0 then "(no Must rules apply)" else .[] | "\(.id)\t\(.text)\t(\(.doc), \(.origin))" end' ;;
    new) # dl knowledge new <template> [--scope project|company] — a standards document to fill in (brand-visual …)
      local tpl=${2:-} sc=project dest; [[ ${3:-} == --scope ]] && sc=${4:-}
      [[ -n $tpl && -f $SKILL_DIR/templates/standards/$tpl.md ]] || die "usage: dl knowledge new <template> [--scope project|company] — templates: $(cd "$SKILL_DIR/templates/standards" && ls *.md | sed 's/\.md$//' | tr '\n' ' ')"
      case $sc in project) dest="$ROOT/.deliver/knowledge" ;; company) dest="$(node "$BIN_DIR/knowledge.mjs" orgdir)" ;; *) die "--scope is project or company" ;; esac
      [[ ! -e $dest/$tpl.md ]] || refuse 1 "$dest/$tpl.md exists — edit it; it is not overwritten"
      mkdir -p "$dest" && cp "$SKILL_DIR/templates/standards/$tpl.md" "$dest/$tpl.md"
      echo "written: $dest/$tpl.md — fill in every {{…}}; a rule with a {{…}} left is not a rule yet (dl knowledge list shows them)" ;;
    sync-md) node "$BIN_DIR/knowledge.mjs" sync-md "$ROOT" ;;
    *) die "usage: dl knowledge [list [kind] [role] [stack,…] | must <role> | new <template> [--scope project|company] | topics | promote <topic> \"<rule>\" | sync-md]" ;;
  esac
}

# .deliver.json "roles": {"backend": {"model": "sonnet", "count": 2}, …} — the project's defaults per role. A role entry that
# names its own model/provider/count (from the request, or the human at the start) keeps it.
apply_role_defaults() {
  local d; d="$(jq -c '.settings.roles // {}' "$JOBJ")"
  if [[ $d != "{}" ]]; then
    local before; before="$(jq -c '.roles // []' "$JOBJ")"
    jq_inplace "$JOBJ" '. as $j | if (.roles | type) == "array" then .roles |= map(. as $x
      | ((($j.settings.roles // {})[$x.role] // {}) | {model, provider, count} | with_entries(select(.value != null))) + $x) else . end'
    local after; after="$(jq -c '.roles // []' "$JOBJ")"
    [[ $before == "$after" ]] || log_event roles-defaults "from .deliver.json: $(jq -r --argjson d "$d" '[.roles[] | select($d[.role]) | "\(.role): " + ([($d[.role] | to_entries[] | select(.key == "model" or .key == "provider" or .key == "count")) | "\(.key) \(.value)"] | join(", "))] | join(" · ")' "$JOBJ")"
  fi
  # QA seats follow the developer seats (one QA per dev seat) unless a count was given for QA — measured: one QA seat for
  # two devs was busy 56 % of a job while the devs waited on it. count_auto marks a count set here, so it follows changes.
  [[ "$(jq -r '(.roles // []) | type' "$JOBJ")" == array ]] || return 0
  local qa devs; qa="$(jq -c '[.roles[] | select(.role == "qa")] | first // empty' "$JOBJ")"
  [[ -n $qa ]] && [[ "$(jq -r '(.count == null) or (.count_auto == true)' <<<"$qa")" == true ]] || return 0
  local out; out="$(node "$BIN_DIR/roles.mjs" dev-seats "$JOBJ" 2>&1)" || true
  devs="$(printf '%s\n' "$out" | awk '/^[0-9]+$/ {n=$0} END {print n}')"
  if [[ -z $devs ]]; then   # never silently: a live run kept one QA seat for two developers and said nothing
    log_event roles-defaults "could not count the developer seats — QA keeps its count: $(tr '\n' ' ' <<<"$out" | cut -c1-200)"
    echo "dl: could not count the developer seats ($(tr '\n' ' ' <<<"$out" | cut -c1-120)) — QA's seat count was not adjusted" >&2
    return 0
  fi
  if [[ $devs -gt 1 && "$(jq -r '.count // 1' <<<"$qa")" != "$devs" ]]; then
    jq_inplace "$JOBJ" --argjson n "$devs" '.roles |= map(if .role == "qa" then .count = $n | .count_auto = true else . end)'
    log_event roles-defaults "qa: $devs seats — one per developer seat"
  elif [[ $devs -le 1 && "$(jq -r '.count_auto // false' <<<"$qa")" == true ]]; then
    jq_inplace "$JOBJ" '.roles |= map(if .role == "qa" then del(.count, .count_auto) else . end)'
  fi
  return 0
}
cmd_roles() { load_job; node "$BIN_DIR/roles.mjs" render "$JOB_DIR" && log_event roles "$(jq -r '[.roles[].role] | join(" ")' "$JOBJ")"; }

_wt_reserve() { with_lock assign _wt_reserve_sub "$@"; }
_wt_reserve_sub() { ( _wt_reserve_locked "$@" ); }   # refuse/exit leaves only the subshell, so the lock is always released
_wt_reserve_locked() { # runs in a subshell under the "assign" lock; exits non-zero with the reason when refused
  local card=$1 flag=$2
  [[ "$(phase_now)" == executing ]] || refuse 1 "cards are dispatched only in phase executing (now: $(phase_now))"
  local state attempts max running deps_open
  state="$(card_get "$card" .state)"; attempts="$(card_get "$card" .attempts)"; max="$(setting max_attempts)"
  deps_open="$(jq -r --arg id "$card" '. as $b | .cards[] | select(.id==$id) | [(.depends_on//[])[] as $d
               | select(([$b.cards[] | select(.id==$d) | .state] | first) != "merged") | $d] | join(" ")' "$BOARD")"
  [[ -z $deps_open ]] || refuse 1 "$card depends on unmerged card(s): $deps_open"
  if [[ $flag == --resume ]]; then
    [[ $state == running ]] || refuse 1 "--resume is for cards in state running (now: $state)"
    return 0
  fi
  [[ $state == ready || $state == review ]] || refuse 1 "$card is $state — only ready cards (or review cards being retried) are dispatched"
  if jq -e '.roles[] | select(.role=="ba")' "$JOBJ" >/dev/null && [[ ! -f $JOB_DIR/specs/$card.md ]]; then
    refuse 1 "$card has no BA spec (.work/$JOB/specs/$card.md) — the Business Analyst writes it before the card is assigned"
  fi
  (( attempts < max )) || refuse 4 "$card used $attempts/$max attempts. Mark it: dl card $card state blocked + note; only the human can grant more (/deliver:retry $card)"
  running="$(jq --arg id "$card" '[.cards[] | select(.state=="running" and .id!=$id)] | length' "$BOARD")"
  (( running < $(setting max_parallel) )) || refuse 5 "max_parallel=$(setting max_parallel) cards are already running"
  # Role capacity: a role with "count": N has N seats (e.g. mobile#1, mobile#2) working in parallel.
  local role cnt used seat
  role="$(card_get "$card" .role)"
  cnt="$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | (.count // 0)] | first // 0' "$JOBJ")"
  used="$(jq --arg r "$role" --arg id "$card" '[.cards[] | select(.state=="running" and .role==$r and .id!=$id)] | length' "$BOARD")"
  if (( cnt > 0 && used >= cnt )); then refuse 5 "all $cnt '$role' seats are busy — another card of this role finishes first"; fi
  # the lowest free seat of the role: <role>#1, <role>#2, …
  seat="$(jq -r --arg r "$role" --arg id "$card" '
    [.cards[] | select(.state=="running" and .role==$r and .id!=$id) | .seat // empty] as $busy
    | first(range(1; 1000) | "\($r)#\(.)" | select(. as $s | $busy | index($s) | not))' "$BOARD")"
  card_set "$card" '(.cards[] | select(.id==$id)) |= (.state="running" | .attempts+=1 | .seat=$s
      | .assignments = ((.assignments // []) + [{"attempt":(.attempts),"agent":.agent,"seat":$s,"by":"michael","at":$t}]))' \
    --arg s "$seat" --arg t "$(now)"
}

cmd_wt() {
  load_job
  local sub=${1:-} card=${2:-} flag=${3:-}; [[ -n $card ]] || die "usage: dl wt add|qa|rm <card> [--resume]"
  card_exists "$card"
  local path="$JOB_DIR/wt/$card" branch
  # The card branch carries the tracker key when there is one (Jira links branches by key), and never changes once made.
  branch="$(card_get "$card" '.branch // empty')"
  [[ -n $branch ]] || branch="$JOB_BRANCH--$card$(card_get "$card" '.tracker.key // "" | if . != "" then "-" + . else "" end')"
  case $sub in
    add)
      # 1. checks + reservation, atomically (two parallel assignments can't take the same seat or exceed a limit);
      # 2. worktree + setup outside the lock, so a slow setup never holds up other assignments.
      assert_frozen
      # QA's work is recorded before anyone else touches the card: commits that changed only QA tests since QA's last record
      # (or since the gate) would otherwise be counted as the dev's at the next gate.
      local qh gh hb base; qh="$(card_get "$card" '.qa.head // ""')"; gh="$(card_get "$card" '.gate.head // ""')"
      hb="$(git -C "$ROOT" rev-parse -q --verify "refs/heads/$branch" 2>/dev/null || true)"
      base="$qh"; [[ -n $base ]] && git -C "$ROOT" merge-base --is-ancestor "$base" "$hb" 2>/dev/null || base="$gh"
      if [[ -n $hb && -n $base && $hb != "$base" ]] && git -C "$ROOT" merge-base --is-ancestor "$base" "$hb" 2>/dev/null \
         && [[ -n "$(git -C "$ROOT" diff --name-only "$base" "$hb")" && -z "$(outside "$base" "$hb" "$(card_get "$card" '.qa_scope // []')")" ]]; then
        refuse 1 "$card has QA commits that are not recorded yet (${base:0:9}..${hb:0:9} changed only QA tests) — record QA's round first: dl qa $card pass|fail \"<AC results>\", then send the card on"
      fi
      local prev; prev="$(card_get "$card" '{state, attempts, seat}')"
      _wt_reserve "$card" "$flag" || exit $?
      if [[ ! -d $path ]]; then
        if ! { if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$branch"; then git_locked -C "$ROOT" worktree add -q "$path" "$branch"
               else git_locked -C "$ROOT" worktree add -q -b "$branch" "$path" "$JOB_BRANCH"; fi; }; then
          [[ $flag == --resume ]] || card_set "$card" '(.cards[] | select(.id==$id)) |= (. + $p | .assignments |= .[:-1])' --argjson p "$prev"
          die "could not create the worktree for $card — assignment rolled back"
        fi
        run_setup "$path"
      fi
      card_set "$card" '(.cards[] | select(.id==$id)) |= (.worktree=$p | .branch=$b)' --arg p "$path" --arg b "$branch"
      push_card "$card"
      reset_stop_guard
      log_event "assign" "$card → $(card_get "$card" .agent)$(card_get "$card" '(.seat // "") | if . != "" then " (" + . + ")" else "" end') attempt=$(card_get "$card" .attempts)${flag:+ $flag}"
      tracker sync "$card" --event "assigned by michael to $(card_get "$card" '.seat // .agent') (attempt $(card_get "$card" .attempts))"
      [[ "$(card_get "$card" '.assignments | length')" == 1 || $flag == --resume ]] && tracker branch "$card"
      echo "$path"
      ;;
    qa) # the QA role's own worktree: it writes the card's tests from the spec while the dev builds (settings.qa_early)
      assert_frozen
      [[ "$(jq -c '.qa_scope // []' <<<"$(card_get "$card" .)")" != "[]" ]] || refuse 1 "$card has no qa_scope — nothing for QA to write"
      [[ -z "$(card_get "$card" '.qa_join.head // ""')" && -z "$(card_get "$card" '.qa.head // ""')" ]] || refuse 1 "$card's QA tests are already on the card branch — QA works in the card worktree now"
      [[ " running review " == *" $(card_get "$card" .state) "* ]] || refuse 1 "$card is $(card_get "$card" .state) — QA starts once the card is assigned (dl wt add $card)"
      local qpath="$JOB_DIR/wt/$card-qa" qbr="$branch-qa"
      if [[ ! -d $qpath ]]; then
        if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$qbr"; then git_locked -C "$ROOT" worktree add -q "$qpath" "$qbr"
        else git_locked -C "$ROOT" worktree add -q -b "$qbr" "$qpath" "$JOB_BRANCH"; fi || die "could not create the QA worktree for $card"
        run_setup "$qpath"
        log_event qa-start "$card → QA writes its tests in $qpath (branch $qbr) while the dev builds"
      fi
      echo "$qpath" ;;
    rm)
      [[ -d $path ]] && git_locked -C "$ROOT" worktree remove --force "$path"
      log_event "wt-rm" "$card"; echo "removed: $path (branch kept: $branch)"
      ;;
    *) die "usage: dl wt add|qa|rm <card> [--resume]" ;;
  esac
}

CARD_FIELDS="title context verify qa_verify scope qa_scope acceptance depends_on component"
cmd_card_add() { # dl card add <card.json> "<reason>"
  local file=${1:-} reason=${2:-}
  [[ -f $file && -n $reason ]] || die 'usage: dl card add <card.json> "<reason>"'
  [[ "$(phase_now)" =~ ^(planning|awaiting_plan_approval|executing|integrating)$ ]] || refuse 1 "cards are added in planning/executing/integrating (now: $(phase_now))"
  local id; id="$(jq -r '"T-" + ([.cards[].id | ltrimstr("T-") | tonumber] | (max // 0) + 1 | tostring | if length < 2 then "0" + . else . end)' "$BOARD")"
  cp "$BOARD" "$BOARD.bak"
  jq_inplace "$BOARD" --slurpfile c "$file" --arg id "$id" --arg r "$reason" --arg t "$(now)" \
    '.cards += [$c[0] + {id:$id, state:"ready", attempts:0, notes:[], history:[{"at":$t,"by":"michael","change":"added","reason":$r}]}]'
  if ! node "$BIN_DIR/validate.mjs" "$BOARD" > "$JOB_DIR/.validate.out" 2>&1; then
    mv "$BOARD.bak" "$BOARD"; seal "$BOARD"; grep -E '^ERROR' "$JOB_DIR/.validate.out" | grep "$id" >&2; refuse 1 "the new card is invalid — nothing added"
  fi
  rm -f "$BOARD.bak"; log_event card-add "$id: $reason"; tracker open; echo "$id"
}

cmd_card() {
  load_job
  [[ ${1:-} == add ]] && { cmd_card_add "${@:2}"; return; }
  local card=${1:-} what=${2:-} val=${3:-}
  [[ -n $card && -n $what ]] || die "usage: dl card <card> state <state> [\"<reason>\"] | note \"<text>\" | retry"
  card_exists "$card"
  local cur; cur="$(card_get "$card" .state)"
  case $what in
    state)
      [[ " $STATES " == *" $val "* ]] || die "invalid state: '$val' — valid: $STATES"
      case "$cur>$val" in
        running\>review | ready\>blocked | running\>blocked | review\>blocked | blocked\>ready | ready\>archived | blocked\>archived) ;;
        *\>merged)  refuse 1 "merged is set only by: dl integrate $card" ;;
        *\>running) refuse 1 "running is set only by: dl wt add $card" ;;
        *) refuse 1 "$card: $cur → $val is not a valid transition" ;;
      esac
      # After the start the human is not asked again: dropping a card is Michael's decision, with its reason, in the PR.
      if [[ $val == archived ]] && after_start; then
        [[ -n ${4:-} ]] || refuse 1 "archiving $card is your decision as PM — give the reason: dl card $card state archived \"<why it is not delivered>\""
      fi
      card_set "$card" '(.cards[] | select(.id==$id)).state=$s' --arg s "$val"
      reset_stop_guard; log_event state "$card=$val"; tracker sync "$card" --event "state → $val"
      [[ $val == archived ]] && after_start && pm_decision "$card is not delivered (archived)" "$4" "$card"
      echo "$card → $val" ;;
    note)
      [[ -n $val ]] || die "usage: dl card $card note \"<text>\""
      card_set "$card" '(.cards[] | select(.id==$id)).notes += [{"at":$t,"note":$n}]' --arg n "$val" --arg t "$(now)"
      log_event note "$card: $val" ;;
    set) # dl card <id> set <field> <value | JSON> "<reason>"
      local field=$val value=${4:-} reason=${5:-}
      [[ " $CARD_FIELDS " == *" $field "* && -n $value && -n $reason ]] || die "usage: dl card $card set <$(tr ' ' '|' <<<"$CARD_FIELDS")> <value> \"<reason>\""
      # The command that runs the tests may be fixed on a running card too (e.g. a form Node 22 rejects) — validated and logged;
      # the rest of the contract changes only while the card is ready or blocked.
      [[ $cur == ready || $cur == blocked || ( ($field == verify || $field == qa_verify) && ($cur == running || $cur == review) ) ]] \
        || refuse 1 "$card is $cur — a card's contract changes only while it is ready or blocked (verify / qa_verify: also while running)"
      local json; json="$(jq -c . <<<"$value" 2>/dev/null)" || json="$(jq -cn --arg v "$value" '$v')"
      cp "$BOARD" "$BOARD.bak"
      card_set "$card" '(.cards[] | select(.id==$id)) |= (.history = ((.history // []) + [{"at":$t,"by":"michael","field":$f,"from":.[$f],"to":$v,"reason":$r}]) | .[$f] = $v)' \
        --arg f "$field" --argjson v "$json" --arg r "$reason" --arg t "$(now)"
      if ! node "$BIN_DIR/validate.mjs" "$BOARD" > "$JOB_DIR/.validate.out" 2>&1; then
        mv "$BOARD.bak" "$BOARD"; seal "$BOARD"; grep -E '^ERROR' "$JOB_DIR/.validate.out" >&2; refuse 1 "the change makes the board invalid — reverted"
      fi
      rm -f "$BOARD.bak"; log_event card-set "$card.$field = $(jq -c . <<<"$json" | cut -c1-120) — $reason"
      tracker note "$card" michael "changed $field: $reason"; echo "$card.$field updated" ;;
    retry)
      human_only "granting a blocked card new attempts (dl card retry)"
      [[ $cur == blocked || $cur == ready ]] || refuse 1 "retry is for blocked cards (now: $cur)"
      card_set "$card" '(.cards[] | select(.id==$id)) |= (.attempts=0 | .state="ready")'
      reset_stop_guard; log_event retry "$card (human-granted)"; tracker sync "$card" --event "retry granted by the human"; echo "$card → ready, attempts reset" ;;
    *) die "unknown field: $what" ;;
  esac
}

cmd_gate() {
  load_job
  local card=${1:-}; [[ -n $card ]] || die "usage: dl gate <card>"
  card_exists "$card"
  local wt verify attempt branch scope log head fail=0 tmo
  wt="$(card_get "$card" .worktree)"; verify="$(card_get "$card" .verify)"; attempt="$(card_get "$card" .attempts)"
  branch="$(card_get "$card" .branch)"; scope="$(card_get "$card" '.scope')"
  local qscope qverify qhead; qscope="$(card_get "$card" '.qa_scope // []')"; qverify="$(card_get "$card" '.qa_verify // ""')"; qhead="$(card_get "$card" '.qa.head // .qa_join.head // ""')"
  local k v hint
  for k in verify qa_verify; do   # a command that cannot pass on this Node is fixed before it costs the card an attempt
    v="$(card_get "$card" ".$k // \"\"")"
    hint="$(node "$BIN_DIR/node-test-args.mjs" "$v")" || refuse 1 "$card's $k cannot pass: $hint — fix it: dl card $card set $k \"<command>\" \"<why>\" (no attempt was used)"
  done
  [[ -d $wt ]] || die "$card has no worktree — run: dl wt add $card"
  log="$JOB_DIR/gates/$card-a$attempt-$(date +%H%M%S).log"
  tmo="$(setting gate_timeout)"; tmo=${tmo:-1800}
  local gt0; gt0=$(date +%s)
  {
    echo "# gate: $card  attempt: $attempt  $(now)"
    local on; on="$(git -C "$wt" symbolic-ref --short -q HEAD || echo DETACHED)"
    if [[ $on != "$branch" ]]; then echo "FAIL  worktree is on '$on', expected the card branch '$branch'"; fail=1
    else echo "ok    on $branch"; fi

    if [[ -n "$(git -C "$wt" status --porcelain)" ]]; then
      echo "FAIL  uncommitted or untracked changes:"; git -C "$wt" status --porcelain | awk 'NR<=20' | sed 's/^/        /'; fail=1
    else echo "ok    working tree clean"; fi

    local n; n="$(git -C "$wt" rev-list --count "$JOB_BRANCH..HEAD")"
    if [[ $n -eq 0 ]]; then echo "FAIL  no commits on the card branch"; fail=1; else echo "ok    $n commit(s)"; fi

    # --no-renames: a rename shows both paths, so moving a file out of (or into) the scope is caught.
    local out
    out="$(git -C "$wt" diff --no-renames --name-only "$JOB_BRANCH...HEAD" | node "$BIN_DIR/scope.mjs" "$(jq -c --argjson q "$qscope" '. + $q' <<<"$scope")")"
    if [[ -n $out ]]; then
      while IFS= read -r f; do echo "FAIL  out-of-scope file: $f"; done <<<"$out"; fail=1
    else echo "ok    all changes within scope $(jq -c . <<<"$scope") (+ QA tests $(jq -c . <<<"$qscope"))"; fi
    # The QA tests (qa_scope) belong to the QA role: the dev must not write or change them.
    local devfrom="$JOB_BRANCH"; [[ -n $qhead ]] && git -C "$wt" merge-base --is-ancestor "$qhead" HEAD 2>/dev/null && devfrom="$qhead"
    if [[ $(jq length <<<"$qscope") -gt 0 ]]; then
      # QA files are compared blob by blob: changed or deleted since QA's last commit, or added by the dev,
      # fail the gate. Files that only came in by merging the job branch equal the job branch and are ignored.
      local touched="" f
      if [[ -n $qhead && $devfrom == "$qhead" ]]; then
        while IFS= read -r f; do [[ -n $f && "$(blob_at "$wt" "$qhead" "$f")" != "$(blob_at "$wt" HEAD "$f")" ]] && touched+="$f"$'\n'; done < <(qa_files "$wt" "$qhead" "$qscope")
      fi
      while IFS= read -r f; do
        [[ -z $f ]] && continue
        [[ $devfrom == "$qhead" && "$(blob_at "$wt" "$qhead" "$f")" != none ]] && continue
        [[ "$(blob_at "$wt" HEAD "$f")" != "$(blob_at "$wt" "$JOB_BRANCH" "$f")" ]] && touched+="$f"$'\n'
      done < <(qa_files "$wt" HEAD "$qscope")
      touched="${touched%$'\n'}"
      if [[ -n $touched ]]; then while IFS= read -r f; do echo "FAIL  the dev changed a QA test (qa_scope belongs to the QA role): $f"; done <<<"$touched"; fail=1
      else echo "ok    QA tests untouched by the dev"; fi
    fi

    # Commit hygiene: no AI attribution in the delivered history (settings.commit.ai_attribution=false, the default);
    # the role trailer is required only when settings.commit.role_in_message is on.
    if [[ "$(setting commit.ai_attribution)" != true ]]; then
      local attr; attr="$(git -C "$wt" log --format='%H%n%an <%ae>%n%cn <%ce>%n%B%n----' "$JOB_BRANCH..HEAD" \
        | grep -inE 'co-authored-by:.*(claude|anthropic)|generated with \[?claude|🤖 generated|noreply@anthropic\.com|^claude <' | awk 'NR<=3')"
      if [[ -n $attr ]]; then echo "FAIL  AI attribution in the card's commits (settings.commit.ai_attribution=false):"; sed 's/^/        /' <<<"$attr"; fail=1
      else echo "ok    no AI attribution in commits"; fi
    fi
    if [[ "$(setting commit.role_in_message)" == true ]]; then
      local missing; missing="$(git -C "$wt" log --no-merges --format='%h %s%n%b%n----' "$JOB_BRANCH..HEAD" | awk 'BEGIN{RS="----\n"} !/(^|\n)Role: /{split($0,a,"\n"); if (a[1]!="") print a[1]}')"
      if [[ -n $missing ]]; then echo "FAIL  commits without a 'Role: <seat>' trailer (settings.commit.role_in_message=true):"; sed 's/^/        /' <<<"$missing"; fail=1
      else echo "ok    every commit names its role"; fi
    fi

    # Commit messages follow the repo's convention: its own commitlint when installed (exactly its rules), else the
    # Conventional Commits header. The dev's and QA's commits alike — a merge later would carry them into the history.
    if [[ "$(setting commit.convention)" == conventional ]]; then
      local cl="$ROOT/node_modules/.bin/commitlint" bad
      if [[ -x $cl ]]; then
        if bad="$(cd "$ROOT" && "$cl" --from "$JOB_BRANCH" --to "$(git -C "$wt" rev-parse HEAD)" --cwd "$ROOT" 2>&1 </dev/null)"; then echo "ok    commit messages pass the repo's commitlint"
        else echo "FAIL  commit messages refused by the repo's commitlint — rewrite them (one commit: git commit --amend -m '<message>'; several: git reset --soft $JOB_BRANCH, then one commit):"; sed 's/^/        /' <<<"$bad" | awk 'NR<=25'; fail=1; fi
      else
        bad="$(git -C "$wt" log --no-merges --format='%h %s' "$JOB_BRANCH..HEAD" | grep -vE '^[0-9a-f]+ (feat|fix|chore|docs|test|tests|refactor|perf|build|ci|style|revert)(\([^)]*\))?!?: [^A-Z]' || true)"
        if [[ -n $bad ]]; then echo "FAIL  commits not in this repo's Conventional Commits format ('<type>(<scope>): <summary>', e.g. 'feat: add notch change (T-01)'); rewrite them (one commit: git commit --amend -m '<message>'; several: git reset --soft $JOB_BRANCH, then one commit):"; sed 's/^/        /' <<<"$bad" | awk 'NR<=10'; fail=1
        else echo "ok    commit messages follow Conventional Commits ($(setting commit.convention_source))"; fi
      fi
    fi

    echo "----- verify: $verify"
    local runner=(bash -c "$verify")
    command -v timeout >/dev/null && runner=(timeout "$tmo" bash -c "$verify")
    if (cd "$wt" && "${runner[@]}") 2>&1; then echo "ok    verify passed"; else echo "FAIL  verify failed (exit $?)"; fail=1; fi
    if [[ -n $qhead && -n $qverify ]]; then # after a QA round the dev's fix must also make the QA tests pass
      echo "----- qa_verify (QA's integration/e2e tests): $qverify"
      local qr=(bash -c "$qverify"); command -v timeout >/dev/null && qr=(timeout "$tmo" bash -c "$qverify")
      if (cd "$wt" && "${qr[@]}") 2>&1; then echo "ok    QA tests pass"; else echo "FAIL  verify failed: QA tests (exit $?)"; fail=1; fi
    fi
  } > "$log" 2>&1 || true
  grep -q '^FAIL' "$log" && fail=1
  head="$(git -C "$wt" rev-parse HEAD)"
  local result=PASS; [[ $fail -eq 0 ]] || result=FAIL
  card_set "$card" '(.cards[] | select(.id==$id)).gate = {"result":$r,"head":$h,"attempt":($a|tonumber),"seconds":($sec|tonumber),"log":$l,"at":$t}' --arg sec "$(( $(date +%s) - gt0 ))" \
    --arg r "$result" --arg h "$head" --arg a "$attempt" --arg l "$log" --arg t "$(now)"
  # Review the card only after the dev has returned: if it is still running, move it to review.
  [[ "$(card_get "$card" .state)" == running ]] && card_set "$card" '(.cards[] | select(.id==$id)).state="review"'
  reset_stop_guard
  tracker sync "$card"; tracker note "$card" gate "$result — $(grep -c '^ok' "$log") checks ok, $(grep -c '^FAIL' "$log") failed ($(basename "$log"))"
  if [[ $fail -eq 0 ]]; then
    push_card "$card"
    log_event gate "$card PASS"; echo "GATE PASSED: $card  (log: $log)"
  else
    log_event gate "$card FAIL"
    echo "GATE FAILED: $card  (log: $log)"; grep '^FAIL' "$log"
    grep -q '^FAIL  verify' "$log" && { echo "--- tail of the verify output:"; grep -v '^\(ok\|FAIL\)  ' "$log" | tail -n 30; }
    exit 1
  fi
}

# The whole suite of a card commit runs in the background (bin/suite-run.sh): started by a QA pass, it runs while the
# reviewers read and Michael goes on with other cards; dl integrate merges only on its PASS for that same commit.
suite_wanted() { [[ -n "$(setting verify_full)" && "$(setting qa_verify_full)" != false ]]; }
suite_base() { echo "$JOB_DIR/gates/$1-suite-${2:0:12}"; }   # suite_base <card> <commit>
suite_stop() { # suite_stop <card|all> — a run for an older commit (or of an ended job) is moot
  local f p
  for f in "$JOB_DIR"/gates/*-suite-*.pid; do
    [[ -f $f ]] || continue
    [[ $1 == all || $(basename "$f") == "$1"-suite-* ]] || continue
    p="$(cat "$f" 2>/dev/null)"; [[ -n $p ]] && kill -TERM "$p" 2>/dev/null || true
    rm -f "$f"
  done
  return 0
}
suite_start() { # suite_start <card> <commit>
  local card=$1 h=$2 base slots tmo; base="$(suite_base "$card" "$h")"
  suite_stop "$card"; mkdir -p "$JOB_DIR/gates"; rm -f "$base.result"; : > "$base.log"
  slots="$(setting suite_parallel)"; [[ $slots =~ ^[1-9][0-9]*$ ]] || slots=1
  tmo="$(setting gate_timeout)"; tmo=${tmo:-1800}
  # its own checkout of the commit (the card's worktree stays the dev's: a fix may start there while this runs)
  nohup bash "$BIN_DIR/suite-run.sh" "$ROOT" "$JOB_DIR/wt/_suite-$card-${h:0:12}" "$h" "$(setting worktree_setup)" "$(setting verify_full)" \
    "$base" "$WORK/.suite-slots" "$slots" "$card-${h:0:12}" "$tmo" "$WORK/.lock-git" </dev/null >/dev/null 2>&1 &
  echo $! > "$base.pid"
  card_set "$card" '(.cards[] | select(.id==$id)).suite = {"state":"running","head":$h,"log":$l,"started":$t}' \
    --arg h "$h" --arg l "$base.log" --arg t "$(now)"
  log_event suite "$card started on ${h:0:12} (background; at most $slots at once)"
}
suite_state() { # suite_state <card> <commit> → PASS FAIL STALE STOPPED RUNNING DIED NONE (and the result JSON on line 2)
  local base p; base="$(suite_base "$1" "$2")"
  if [[ -f $base.result ]]; then jq -r .result "$base.result"; cat "$base.result"; return 0; fi
  [[ -f $base.pid ]] || { echo NONE; return 0; }
  p="$(cat "$base.pid")"; if kill -0 "$p" 2>/dev/null; then echo RUNNING; else echo DIED; fi
}
suite_record() { # the finished run onto the card, once
  local card=$1 h=$2 out st res; out="$(suite_state "$card" "$h")"; st="$(head -n 1 <<<"$out")"; res="$(sed -n 2p <<<"$out")"
  [[ -n $res && "$(card_get "$card" '.suite.result // ""')" != "$st" ]] || return 0
  card_set "$card" '(.cards[] | select(.id==$id)).suite = ((.suite // {}) + ($r | fromjson) + {"state":"done","log":$l})' \
    --arg r "$res" --arg l "$(suite_base "$card" "$h").log"
  log_event suite "$card ${h:0:12} $st ($(jq -r .seconds <<<"$res") s)"
}
suite_wait() { # suite_wait <card> <commit> <seconds> → prints the final state (RUNNING if still running when time is up)
  local card=$1 h=$2 left=$3 st
  while :; do
    st="$(suite_state "$card" "$h" | head -n 1)"
    [[ $st == RUNNING && $left -gt 0 ]] || break
    sleep 2; left=$((left - 2))
  done
  [[ $st == RUNNING || $st == NONE ]] || suite_record "$card" "$h"
  echo "$st"
}
# dl suite <card> [--wait] — the background whole-suite run of the card's current commit
cmd_suite() {
  load_job
  local card=${1:-}; [[ -n $card ]] || die "usage: dl suite <card> [--wait]"; card_exists "$card"
  local h st; h="$(branch_head "$(card_get "$card" .branch)")"
  if [[ ${2:-} == --wait ]]; then st="$(suite_wait "$card" "$h" 540)"; else st="$(suite_wait "$card" "$h" 0)"; fi
  echo "suite: $card ${h:0:12} $st  (log: $(suite_base "$card" "$h").log)"
  [[ $st == FAIL || $st == DIED || $st == STALE ]] && tail -n 25 "$(suite_base "$card" "$h").log"
  return 0
}

cmd_qa() {
  load_job
  local card=${1:-} verdict=${2:-} summary=${3:-}
  [[ -n $card && ( $verdict == pass || $verdict == fail ) && -n $summary ]] || die 'usage: dl qa <card> pass|fail "<summary: AC-n results>"'
  card_exists "$card"
  local br head wt g qscope qverify
  br="$(card_get "$card" .branch)"; head="$(branch_head "$br")"; wt="$(card_get "$card" .worktree)"
  g="$(card_get "$card" .gate.head)"; qscope="$(card_get "$card" '.qa_scope // []')"; qverify="$(card_get "$card" '.qa_verify // ""')"
  [[ "$(card_get "$card" .state)" == review ]] || refuse 1 "$card is $(card_get "$card" .state); QA runs on cards in review"
  gate_holds "$card" "$head" || refuse 1 "$card has no passed gate for its current commit (the dev changed code after the gate?) — run: dl gate $card"
  [[ -d $wt && -z "$(git -C "$wt" status --porcelain)" ]] || refuse 1 "the QA role must commit its tests; the worktree has uncommitted changes ($wt)"
  if [[ $(jq length <<<"$qscope") -gt 0 ]]; then
    local stray; stray="$(outside "$g" "$head" "$qscope")"
    [[ -z $stray ]] || refuse 1 "since the gate, files outside qa_scope changed: $(tr '\n' ' ' <<<"$stray")— QA writes only integration/e2e tests"
    [[ -n "$(git -C "$wt" diff --no-renames --name-only "$JOB_BRANCH...HEAD" | node "$BIN_DIR/scope.mjs" "$qscope" | sort | comm -13 - <(git -C "$wt" diff --no-renames --name-only "$JOB_BRANCH...HEAD" | sort))" ]] \
      || refuse 1 "no QA tests in qa_scope $(jq -c . <<<"$qscope") — the QA role writes integration/e2e tests for the card's acceptance criteria"
  fi
  local qlog="$JOB_DIR/gates/$card-qa-a$(card_get "$card" .attempts)-$(date +%H%M%S).log" qres=PASS qsec=0 qt0
  if [[ -n $qverify ]]; then
    if [[ "$(card_get "$card" '.gate.head // ""')" == "$head" ]] && grep -q '^ok    QA tests pass' "$(card_get "$card" '.gate.log // "/dev/null"')" 2>/dev/null; then
      echo "# qa_verify passed in the gate on this same commit (${head:0:12}) — not run twice: $(card_get "$card" .gate.log)" > "$qlog"
    else
      qt0=$(date +%s)
      { echo "# qa_verify: $qverify"; (cd "$wt" && bash -c "$qverify") 2>&1; } > "$qlog" 2>&1 || qres=FAIL
      qsec=$(( $(date +%s) - qt0 ))
      if [[ $verdict == pass && $qres == FAIL ]]; then tail -n 25 "$qlog"; refuse 1 "QA reports pass but its tests fail (qa_verify) — see $qlog"; fi
    fi
  fi
  card_set "$card" '(.cards[] | select(.id==$id)) |= (.qa = {"verdict":$v,"head":$h,"gate_head":$g,"qa_verify":$r,"seconds":($sec|tonumber),"log":$l,"summary":$s,"at":$t}
      | .qas = ((.qas // []) + [{"verdict":$v,"head":$h,"qa_verify":$r,"summary":$s,"at":$t}]))' \
    --arg v "$verdict" --arg h "$head" --arg g "$g" --arg r "$qres" --arg l "$qlog" --arg s "$summary" --arg t "$(now)" --arg sec "$qsec"
  push_card "$card"
  # The dev's tests and QA's pass one by one, yet the suite can still break once they are collected together (seen live: two
  # test helpers named sovereign_support.py — pytest stopped at collection; a reviewer found it). A QA pass starts the whole
  # suite on this commit in the background: the reviewers read meanwhile, dl integrate merges only on its PASS.
  local suite_note=""
  if [[ $verdict == pass ]] && suite_wanted; then suite_start "$card" "$head"; suite_note="  — whole suite running in the background (dl suite $card); review now, dl integrate waits for its PASS"; fi
  reset_stop_guard; log_event qa "$card $verdict (qa_verify $qres) — $summary"
  tracker sync "$card"; tracker note "$card" qa-tester "$verdict (qa_verify $qres): $summary"
  echo "qa: $card $verdict  (qa_verify: $qres)$suite_note"
}

# dl qa-join <card> — after the gate, the tests QA wrote meanwhile (dl wt qa) join the card branch: only qa_scope files, merged
# by dl in the repo's commit format; then QA runs them on the dev's commit in the card worktree and records dl qa.
cmd_qa_join() {
  load_job
  local card=${1:-}; [[ -n $card ]] || die "usage: dl qa-join <card>"
  card_exists "$card"
  local br qbr wt qpath head qhead; br="$(card_get "$card" .branch)"; qbr="$br-qa"; wt="$(card_get "$card" .worktree)"; qpath="$JOB_DIR/wt/$card-qa"
  [[ "$(card_get "$card" .state)" == review ]] || refuse 1 "$card is $(card_get "$card" .state) — QA's tests join after the dev is done and the gate passed"
  head="$(branch_head "$br")"; gate_holds "$card" "$head" || refuse 1 "$card has no passed gate for its current commit — run: dl gate $card"
  git -C "$ROOT" show-ref --verify --quiet "refs/heads/$qbr" || refuse 1 "$card has no QA branch — QA writes its tests with dl wt qa $card (or after the gate, in the card worktree)"
  [[ -z "$(card_get "$card" '.qa_join.head // ""')" ]] || refuse 1 "$card's QA tests already joined"
  [[ -z "$(git -C "$qpath" status --porcelain 2>/dev/null)" ]] || refuse 1 "the QA role has not committed its tests yet ($qpath)"
  qhead="$(git -C "$ROOT" rev-parse "$qbr")"
  [[ $(git -C "$ROOT" rev-list --count "$JOB_BRANCH..$qhead") -gt 0 ]] || refuse 1 "the QA branch has no commits — the QA role is still writing (or wrote nothing)"
  local stray; stray="$(outside "$JOB_BRANCH" "$qhead" "$(card_get "$card" '.qa_scope // []')")"
  [[ -z $stray ]] || refuse 1 "the QA branch changed files outside qa_scope: $(tr '\n' ' ' <<<"$stray")— QA writes only its tests"
  local rc=0; dl_merge "$wt" "$qbr" "$card" "QA tests" || rc=$?
  [[ $rc == 3 ]] && refuse 3 "QA's tests conflict with the card branch — QA rewrites them in the card worktree (dl qa round as before)"
  [[ $rc == 0 ]] || { merge_refused_msg "$card" "qa-join $card"; exit 5; }
  card_set "$card" '(.cards[] | select(.id==$id)).qa_join = {"head":$h,"qa_branch":$q,"at":$t}' --arg h "$(branch_head "$br")" --arg q "$qhead" --arg t "$(now)"
  [[ -d $qpath ]] && git_locked -C "$ROOT" worktree remove --force "$qpath"
  log_event qa-join "$card: QA's tests ($(git -C "$ROOT" rev-list --count "$JOB_BRANCH..$qhead") commit(s)) joined the card branch"
  echo "QA tests joined $card — QA now runs them on the dev's commit in $wt and records: dl qa $card pass|fail"
}

cmd_review() {
  load_job
  local card=${1:-} verdict=${2:-} summary=${3:-} by="" std=""
  shift 3 2>/dev/null || shift $#
  while [[ $# -gt 0 ]]; do case $1 in --by) by=${2:-}; shift 2 ;; --standards) std=${2:-}; shift 2 ;; *) die "unknown option: $1" ;; esac; done
  [[ -n $card && ( $verdict == approve || $verdict == changes ) ]] || die 'usage: dl review <card> approve|changes "<summary>" [--by <reviewer role>] [--standards '"'"'{"<rule id>":"ok|violated: …|n_a: …"}'"'"']'
  card_exists "$card"
  local head; head="$(branch_head "$(card_get "$card" .branch)")"
  gate_holds "$card" "$head" || refuse 1 "$card has no passed gate for its current commit — run: dl gate $card"
  [[ "$(card_get "$card" .qa.verdict)" == pass && "$(card_get "$card" .qa.head)" == "$head" ]] \
    || refuse 1 "$card has no QA pass on its current commit — the QA/Test role checks the acceptance criteria first (dl qa $card pass|fail)"
  # Reviewers of this card: card.reviewers (the stack reviewer + specialists such as a11y, performance, security), each
  # records its own verdict; the card's review is "approve" only when every one approved this commit.
  local required; required="$(card_get "$card" '(.reviewers // []) | join(" ")')"
  [[ -n $by ]] || by="${required%% *}"; [[ -n $by ]] || by="reviewer"
  if [[ -n $required && " $required " != *" $by "* ]]; then refuse 1 "$by is not a reviewer of $card (reviewers: $required)"; fi
  jq -e --arg r "$by" '.roles[] | select(.role==$r)' "$JOBJ" >/dev/null || [[ -z $required && $by == reviewer ]] || refuse 1 "role '$by' is not on this job"
  # The company's and the project's standards (brand visual identity …): the reviewer answers every Must rule that applies
  # to it, one by one; an approval with a rule unanswered or violated is refused.
  local kind judged rr=0; kind="$(node "$BIN_DIR/roles.mjs" kind "$by" 2>/dev/null)"; [[ -n $kind ]] || kind=review
  judged="$(node "$BIN_DIR/knowledge.mjs" judge "$(jq -r '.repo // "."' "$JOBJ")" "$kind" "$by" "$(jq -r '(.stack // []) | join(",")' "$JOBJ")" "$std" "$verdict" 2>&1)" || rr=$?
  [[ $rr -eq 0 ]] || refuse 1 "$card: the standards check of this review is not complete —"$'\n'"$judged"
  card_set "$card" '(.cards[] | select(.id==$id)) |= (
      .reviews = ((.reviews // []) + [{"by":$by,"verdict":$v,"head":$h,"summary":$s,"at":$t} + (if $std == {} then {} else {"standards":$std} end)])
      | ((.reviewers // [$by]) ) as $req
      | ([.reviews[] | select(.head==$h)] | group_by(.by) | map(last)) as $latest
      | ($req | map(. as $r | ($latest | map(select(.by==$r)) | first | .verdict) // "pending")) as $vs
      | .review = {"verdict": (if any($vs[]; .=="changes") then "changes" elif all($vs[]; .=="approve") then "approve" else "pending" end),
                   "head":$h, "summary": ([$latest[] | "\(.by): \(.verdict) — \(.summary)"] | join(" | ")),
                   "pending": [$req[] as $r | select(($vs[$req | index($r)]) == "pending") | $r], "at":$t})' \
    --arg by "$by" --arg v "$verdict" --arg h "$head" --arg s "$summary" --arg t "$(now)" --argjson std "${judged:-"{}"}"
  reset_stop_guard; log_event review "$card $by $verdict${summary:+ — $summary}"
  tracker sync "$card"; tracker note "$card" "$by" "$verdict${summary:+ — $summary}"
  echo "review: $card $by $verdict  (card: $(card_get "$card" .review.verdict)$(card_get "$card" '.review.pending | if length>0 then ", waiting for " + join(", ") else "" end'))"
}

# Every commit dl makes follows the repo's commit convention, and the repo's own hooks (commitlint, a commit-msg hook) are
# never skipped. dl_merge tries the message forms that fit, in order; a hook that refuses one is not a conflict.
#   dl_merge <dir> <branch> <what: T-01 | job/…> <title>   → 0 merged · 3 conflict · 5 every message refused (hook output on stderr)
dl_merge() {
  local dir=$1 br=$2 what=$3 title=$4 conv tpl key low subj m out last="" msgs=() trailer=""
  conv="$(setting commit.convention)"; tpl="$(setting commit.merge_message)"
  key="$( [[ $what == T-* ]] && card_get "$what" '.tracker.key // ""' || true)"
  low="$(printf '%s' "${title:0:1}" | tr '[:upper:]' '[:lower:]')${title:1}"   # a Conventional subject starts lower-case
  [[ $what == T-* && "$(setting commit.role_in_message)" == true ]] && trailer=$'\n\n'"Role: michael (integration of $(card_get "$what" '.seat // .role'))"
  if [[ -n $tpl ]]; then
    m="${tpl//\{card\}/$what}"; m="${m//\{title\}/$title}"; m="${m//\{key\}/$key}"; msgs+=("$m")
  fi
  local w=$what; [[ $what == job/* ]] && w="${what#job/}"; w="${w%%-[a-z]*}"   # job/JOB-20261005-1952-slug → JOB-20261005-1952
  subj="merge $w${key:+ ($key)} - $low"   # ASCII only: cut to the header limit (100) without splitting a character
  if [[ $conv == conventional ]]; then msgs+=("chore: ${subj:0:93}" "chore(deliver): ${subj:0:84}" "Merge $what${key:+ ($key)}: $title")
  else msgs+=("Merge $what${key:+ ($key)}: $title" "chore: ${subj:0:93}"); fi
  for m in ${msgs[@]+"${msgs[@]}"}; do
    if out="$(git_locked -C "$dir" merge --no-ff -q -m "$m$trailer" "$br" 2>&1)"; then return 0; fi
    if [[ -n "$(git -C "$dir" diff --name-only --diff-filter=U 2>/dev/null)" ]]; then git_locked -C "$dir" merge --abort 2>/dev/null || true; return 3; fi
    git_locked -C "$dir" merge --abort 2>/dev/null || true
    last="$out"; log_event merge-refused "$what: \"$m\" — $(tr '\n' ' ' <<<"$out" | cut -c1-160)"
  done
  printf '%s\n' "$last" >&2
  return 5
}
# dl_commit <dir> <conventional subject> <plain subject> — commit what is staged in <dir> with a message that fits the repo's
# convention, through its hooks (0 committed · 5 every form refused, hook output on stderr)
dl_commit() {
  local dir=$1 conv m out last="" msgs=(); conv="$(setting commit.convention)"
  if [[ $conv == conventional ]]; then msgs+=("${2:0:100}" "$3"); else msgs+=("$3" "${2:0:100}"); fi
  for m in ${msgs[@]+"${msgs[@]}"}; do
    if out="$(git -C "$dir" commit -q -m "$m" 2>&1)"; then return 0; fi
    last="$out"; log_event commit-refused "\"$m\" — $(tr '\n' ' ' <<<"$out" | cut -c1-160)"
  done
  printf '%s\n' "$last" >&2; return 5
}

# What the job learned, onto the job branch (the project's .deliver/knowledge) — so the PR carries it and the merge accepts
# it — and, for the shared knowledge repo, onto a branch there with its own PR. Once per job.
knowledge_publish() {
  [[ "$(jq -r '.knowledge_published // ""' "$JOBJ")" == "" ]] || return 0
  local files
  files="$(node "$BIN_DIR/knowledge.mjs" publish "$ROOT" "$JOB_DIR" "$IWT" project)" || die "could not write the job's lessons"
  if [[ -n $files ]]; then
    git -C "$IWT" add -- .deliver/knowledge
    dl_commit "$IWT" "docs(deliver): lessons learned in ${JOB%%-[a-z]*}" "Lessons learned in $JOB" \
      || { echo "NOT A CONFLICT: the repo refused dl's commit of the job's lessons (its commit-msg hook, output above) — set commit.merge_message's style for it or allow 'docs' commits, then dl ship again" >&2; git -C "$IWT" reset -q; exit 5; }
    log_event knowledge "lessons/standards committed to $JOB_BRANCH: $(tr '\n' ' ' <<<"$files" | sed "s#$IWT/##g")"
  fi
  local kdir url=""; kdir="$(setting knowledge.dir)"
  if [[ -n $kdir && -d $kdir/.git && "$(jq '[.[] | select(.scope=="shared")] | length' "$JOB_DIR/lessons.json" 2>/dev/null || echo 0)$(jq '[.[] | select(.scope=="shared")] | length' "$JOB_DIR/promotions.json" 2>/dev/null || echo 0)" != 00 ]]; then
    local br="deliver/$JOB" sw; sw="$(mktemp -d)"
    if git -C "$kdir" worktree add -q -b "$br" "$sw" HEAD 2>/dev/null; then
      node "$BIN_DIR/knowledge.mjs" publish "$ROOT" "$JOB_DIR" "$sw" shared >/dev/null && git -C "$sw" add -A
      local kconv; kconv="$(node "$BIN_DIR/detect.mjs" --commit "$kdir" | jq -r .convention)"
      local km="docs: lessons from $(basename "$ROOT") (${JOB%%-[a-z]*})"; [[ $kconv == conventional ]] || km="Lessons from $(basename "$ROOT") ($JOB)"
      if git -C "$sw" commit -q -m "$km" 2>/dev/null && git -C "$sw" push -q -u origin "$br" 2>/dev/null; then
        url="$( command -v "$GH" >/dev/null && (cd "$sw" && "$GH" pr create --fill --head "$br" 2>/dev/null | tail -1) || true)"
        log_event knowledge "shared lessons proposed: ${url:-branch $br pushed to $(git -C "$kdir" remote get-url origin)}"
      else log_event knowledge "shared lessons committed on branch $br in $kdir — not pushed (push it and open a PR)"; fi
      git -C "$kdir" worktree remove --force "$sw" 2>/dev/null || true
    else log_event knowledge "could not branch the shared knowledge repo $kdir for $br"; fi
  fi
  jq_inplace "$JOBJ" --arg h "$(branch_head "$JOB_BRANCH")" --arg u "$url" '.knowledge_published = {head:$h, shared_pr:$u}'
}
# The job's record goes into the repo with its code (.deliver/jobs/<job>/): the request, the readiness decisions with their
# sources, the plan, the specs, the board (every gate, QA and review verdict), the report and the event log. Who asked for
# what, what was decided and why, what was checked — kept in git, the audit trail, not only in the PR body.
job_record_publish() {
  [[ "$(jq -r '.record_published // ""' "$JOBJ")" == "" ]] || return 0
  [[ "$(setting record_job)" != false ]] || { log_event record "not committed (settings.record_job=false)"; return 0; }
  local d="$IWT/.deliver/jobs/$JOB" f
  mkdir -p "$d"
  jq -r '"# Request — \(.title)\n\nJob \(.id), opened \(.created_at // .created // "")\n\n\(.request)"' "$JOBJ" > "$d/request.md"
  for f in readiness.json readiness.md plan.md report.md board.json events.log; do
    [[ -f $JOB_DIR/$f ]] && sed "s#$ROOT/##g" "$JOB_DIR/$f" > "$d/$f"
  done
  [[ -d $JOB_DIR/specs ]] && { mkdir -p "$d/specs"; cp "$JOB_DIR"/specs/*.md "$d/specs/" 2>/dev/null || true; }
  git -C "$IWT" add -f -- ".deliver/jobs/$JOB"
  if ! git -C "$IWT" diff --cached --quiet; then
    dl_commit "$IWT" "docs(deliver): record of ${JOB%%-[a-z]*}" "Record of $JOB" \
      || { echo "NOT A CONFLICT: the repo refused dl's commit of the job's record (its commit-msg hook, output above) — allow 'docs' commits or set commit.merge_message's style, then dl ship again" >&2; git -C "$IWT" reset -q; exit 5; }
    log_event record "the job's record committed to $JOB_BRANCH: .deliver/jobs/$JOB/"
  fi
  jq_inplace "$JOBJ" --arg h "$(branch_head "$JOB_BRANCH")" --arg p ".deliver/jobs/$JOB" '.record_published = {head:$h, path:$p}'
}
# dl followup "<finding>" [--card T-xx] [--evidence "<…>"] — a defect seen outside the job's scope: recorded, listed in the PR
cmd_timeline() { load_job; node "$BIN_DIR/timeline.mjs" "$JOB_DIR" "$@"; }
cmd_followup() {
  load_job; not_shipped
  local text=${1:-} card="" ev=""; shift || true
  while [[ $# -gt 0 ]]; do case $1 in --card) card=${2:-}; shift 2 ;; --evidence) ev=${2:-}; shift 2 ;; *) die "unknown option: $1" ;; esac; done
  [[ -n $text ]] || die 'usage: dl followup "<finding>" [--card T-xx] [--evidence "<what showed it>"]'
  [[ -z $card ]] || card_exists "$card"
  jq_inplace "$JOBJ" --arg t "$text" --arg c "$card" --arg e "$ev" --arg at "$(now)" '.followups = ((.followups // []) + [{text:$t, card:$c, evidence:$e, at:$at}])'
  log_event followup "${card:+$card: }$text"; echo "follow-up recorded — listed in the PR"
}
report_followups() {
  grep -q '<!-- deliver:followups -->' "$JOB_DIR/report.md" && return 0
  [[ "$(jq '(.followups // []) | length' "$JOBJ")" -gt 0 ]] || return 0
  { printf '\n<!-- deliver:followups -->\n## Follow-ups (found during the job, outside its scope)\n\n'
    jq -r '.followups[] | "- " + (if .card != "" then "**\(.card)** — " else "" end) + .text + (if .evidence != "" then " _(\(.evidence))_" else "" end)' "$JOBJ"; } >> "$JOB_DIR/report.md"
}
report_lessons() {
  grep -q '<!-- deliver:lessons -->' "$JOB_DIR/report.md" && return 0
  local lf="$JOB_DIR/lessons.json"; [[ -f $lf ]] || return 0
  { printf '\n<!-- deliver:lessons -->\n## Lessons learned\n\nProposed by this job with what happened; merging this PR accepts them into `.deliver/knowledge/` (shared ones: their own PR in the shared knowledge repo).\n\n'
    jq -r '.[] | select(.scope != "kit") | "- **\(.topic)** (\(.role), \(.scope)): \(.text)\n" + ([.evidence[] | "  - evidence: \(.)"] | join("\n"))' "$lf"
    if [[ "$(jq '[.[] | select(.scope == "kit")] | length' "$lf")" -gt 0 ]]; then
      printf '\n## Feedback for the deliver kit\n\nDefects of the flow itself, for https://github.com/cantasci/deliver-floor/issues — not rules for this project.\n\n'
      jq -r '.[] | select(.scope == "kit") | "- \(.text)\n" + ([.evidence[] | "  - evidence: \(.)"] | join("\n"))' "$lf"; fi
    if [[ -f $JOB_DIR/promotions.json ]]; then printf '\n### New standards\n\n'; jq -r '.[] | "- **\(.topic)** (\(.scope)): MUST \(.rule)"' "$JOB_DIR/promotions.json"; fi
    local u; u="$(jq -r '.knowledge_published.shared_pr // ""' "$JOBJ")"; if [[ -n $u ]]; then printf '\nShared knowledge PR: %s\n' "$u"; fi
  } >> "$JOB_DIR/report.md"
  return 0
}
merge_refused_msg() { # what Michael does when the repo refuses every merge message dl can write
  echo "NOT A CONFLICT: the repo refused dl's merge commit for $1 (its commit-msg hook / commitlint, output above) — the card is fine; do not re-dispatch the dev. Write a merge message this repo accepts and run it again: dl jobset '.settings.commit.merge_message=\"<message with {card} {title} {key}>\"' (record it for the next jobs: commit.merge_message in .deliver.json), then dl $2" >&2
}

cmd_integrate() {
  load_job; assert_frozen
  local card=${1:-}; [[ -n $card ]] || die "usage: dl integrate <card>"
  card_exists "$card"
  local branch title head
  branch="$(card_get "$card" .branch)"; title="$(card_get "$card" .title)"
  [[ $branch != null ]] || die "$card has no branch"
  head="$(branch_head "$branch")"
  [[ "$(card_get "$card" .state)" == review ]] || refuse 1 "$card is $(card_get "$card" .state), not review"
  gate_holds "$card" "$head" || refuse 1 "$card: the gate has not passed for commit ${head:0:9} — run: dl gate $card"
  [[ "$(card_get "$card" .qa.verdict)" == pass && "$(card_get "$card" .qa.head)" == "$head" ]] \
    || refuse 1 "$card: no QA pass on commit ${head:0:9} — dl qa $card pass|fail"
  [[ "$(card_get "$card" .review.verdict)" == approve && "$(card_get "$card" .review.head)" == "$head" ]] \
    || refuse 1 "$card: no Lead review approval on commit ${head:0:9} — review, then: dl review $card approve"
  if suite_wanted; then
    local st; st="$(suite_state "$card" "$head" | head -n 1)"
    [[ $st == NONE || $st == STOPPED || $st == STALE || $st == DIED ]] && { suite_start "$card" "$head"; st=RUNNING; }
    [[ $st == RUNNING ]] && { echo "integrate: waiting for $card's whole suite on ${head:0:12} …" >&2; st="$(suite_wait "$card" "$head" 540)"; }
    [[ $st == PASS ]] || suite_record "$card" "$head"
    [[ $st == RUNNING ]] && refuse 1 "$card: its whole suite is still running on ${head:0:12} (9 min waited) — dl suite $card --wait, then integrate"
    [[ $st == PASS ]] || { tail -n 25 "$(suite_base "$card" "$head").log" >&2
      refuse 1 "$card: the whole suite (verify_full) does not pass on ${head:0:12} with the dev's and QA's tests together ($st) — see $(suite_base "$card" "$head").log. Often two test files or helpers with the same module name; the one in qa_scope is QA's to rename, any other goes back to the dev. Record: dl qa $card fail \"<what failed>\""; }
  fi
  [[ -z "$(git -C "$IWT" status --porcelain)" ]] \
    || refuse 1 "the integration worktree has uncommitted changes — nothing may be written there by hand (git -C $IWT status)"
  local rc=0; dl_merge "$IWT" "$branch" "$card" "$title" || rc=$?
  if [[ $rc == 3 ]]; then
    log_event integrate "$card CONFLICT"
    echo "CONFLICT: $card conflicts with $JOB_BRANCH. Re-dispatch the dev (dl wt add $card) with: run 'git merge $JOB_BRANCH' in the worktree, resolve, run verify, commit. Then gate + review + integrate again." >&2
    exit 3
  elif [[ $rc != 0 ]]; then
    log_event integrate "$card REFUSED by the repo's commit rules"; merge_refused_msg "$card" "integrate $card"; exit 5
  fi
  card_set "$card" '(.cards[] | select(.id==$id)).state="merged"'
  local path="$JOB_DIR/wt/$card"; [[ -d $path ]] && git_locked -C "$ROOT" worktree remove --force "$path"
  reset_stop_guard; log_event integrate "$card merged"
  tracker sync "$card" --event "merged into $JOB_BRANCH"
  echo "MERGED: $card → $JOB_BRANCH"
}

# The baseline: the whole suite on the job branch before any card changes it. A suite that is already red would fail every
# card's QA run and the final verify-all for reasons that are not the job's — so it is found here, at the start, while the
# human is still asked: fix the base first (then dl baseline again), or make verify_full the suite that is meant to pass.
run_baseline() {
  local cmd head log result=FAIL base; cmd="$(setting verify_full)"; base="$(jq -r .base_branch "$JOBJ")"
  # the base was fixed after the job started (no card yet): the job branch takes it — fast-forward only, nothing is rewritten
  if [[ "$(phase_now)" == readiness || "$(phase_now)" == awaiting_clarification || "$(phase_now)" == intake ]] \
     && git -C "$ROOT" merge-base --is-ancestor "$JOB_BRANCH" "$base" 2>/dev/null && [[ "$(branch_head "$JOB_BRANCH")" != "$(branch_head "$base")" ]]; then
    git -C "$IWT" merge -q --ff-only "$base" && log_event baseline "job branch fast-forwarded to $base ($(branch_head "$base" | cut -c1-12)) before any card"
  fi
  head="$(branch_head "$JOB_BRANCH")"
  if [[ -z $cmd ]]; then
    jq_inplace "$JOBJ" --arg h "$head" --arg t "$(now)" '.baseline = {"result":"NONE","head":$h,"at":$t}'
    log_event baseline "no verify_full yet — nothing to run"; echo "baseline: no verify_full yet (a repo without a suite) — nothing to run"; return 0
  fi
  log="$JOB_DIR/gates/baseline-$(date +%H%M%S).log"; mkdir -p "$JOB_DIR/gates"
  { echo "# baseline: $cmd on $JOB_BRANCH at ${head:0:12}, before any card"; (cd "$IWT" && bash -c "$cmd") 2>&1; } > "$log" 2>&1 && result=PASS
  [[ -z "$(git -C "$IWT" status --porcelain)" ]] || { echo "verify_full left changes in the integration worktree:" >>"$log"; git -C "$IWT" status --porcelain >>"$log"; git -C "$IWT" checkout -q -- . 2>/dev/null; git -C "$IWT" clean -fdq 2>/dev/null; result=FAIL; }
  jq_inplace "$JOBJ" --arg r "$result" --arg h "$head" --arg l "$log" --arg c "$cmd" --arg t "$(now)" '.baseline = {"result":$r,"head":$h,"command":$c,"log":$l,"at":$t}'
  log_event baseline "$result ($cmd)"; echo "baseline: $result  ($cmd · log: $log)"
  [[ $result == PASS ]] || { tail -n 25 "$log"; return 1; }
}
baseline_holds() {
  local b; b="$(jq -c '.baseline // {}' "$JOBJ")"
  if [[ "$(jq -r .head <<<"$b")" == "$(branch_head "$JOB_BRANCH")" && "$(jq -r .command <<<"$b")" == "$(setting verify_full)" ]]; then
    case "$(jq -r .result <<<"$b")" in PASS) return 0 ;; FAIL) ;; esac
  fi
  [[ "$(jq -r .result <<<"$b")" == NONE && -z "$(setting verify_full)" ]] && return 0
  run_baseline >&2 || refuse 1 "the whole suite (verify_full) already fails on $JOB_BRANCH before any card — every card's QA run and the final verify-all would fail for reasons that are not the job's. This is the human's call, at the start: fix the base branch first, then: dl baseline; or record the suite that is meant to pass in .deliver.json (verify_full) and dl jobset it. Log: $(jq -r '.baseline.log' "$JOBJ")"
}
cmd_baseline() { load_job; run_baseline; }

cmd_verify_all() {
  load_job
  local cmd log head; cmd="$(setting verify_full)"; log="$JOB_DIR/gates/verify-all-$(date +%H%M%S).log"
  [[ -n $cmd ]] || refuse 1 "verify_full is not set — it follows the stack (ARC-stack): record the full test command with dl jobset '.settings.verify_full=\"<command>\"' (and in .deliver.json for the next jobs)"
  head="$(branch_head "$JOB_BRANCH")"
  echo "verify_full: $cmd  (log: $log)"
  local result=FAIL
  if (cd "$IWT" && bash -c "$cmd") > "$log" 2>&1; then result=PASS; fi
  [[ -z "$(git -C "$IWT" status --porcelain)" ]] || { echo "verify_full left changes in the integration worktree:" >>"$log"; git -C "$IWT" status --porcelain >>"$log"; result=FAIL; }
  jq_inplace "$JOBJ" --arg r "$result" --arg h "$head" --arg l "$log" --arg t "$(now)" '.verify_all = {"result":$r,"head":$h,"log":$l,"at":$t}'
  reset_stop_guard; log_event verify-all "$result"
  if [[ $result == PASS ]]; then echo "PASSED"; else echo "FAILED"; tail -n 40 "$log"; exit 1; fi
}

cmd_approve() { human_only "approving the plan"; _gate_record "${1:-}" approved "${2:-}"; }
cmd_reject()  { human_only "rejecting the plan"; [[ -n ${2:-} ]] || die 'usage: dl reject plan "<what to change>"'; _gate_record "${1:-}" rejected "$2"; }
_gate_record() {
  load_job
  local gate=$1 status=$2 note=$3
  [[ $gate == plan ]] || die "the only human gate before the PR is: plan (merges are decided at the PR — see merge_mode)"
  [[ "$(jq -r .settings.gates.plan "$JOBJ")" == true ]] || refuse 1 "the plan gate is off for this job (settings.gates.plan=false)"
  [[ "$(phase_now)" == "awaiting_${gate}_approval" ]] || refuse 1 "the $gate gate is only answered in phase awaiting_${gate}_approval (now: $(phase_now))"
  jq_inplace "$JOBJ" --arg g "$gate" --arg s "$status" --arg n "$note" --arg by "${DELIVER_APPROVER:-${USER:-human}}" --arg t "$(now)" \
    '.gates[$g] = {"status":$s, "by":$by, "at":$t, "note":$n}'
  reset_stop_guard; log_event "gate-$gate" "$status $note"; echo "$gate: $status"
}

cmd_ship() {
  load_job; assert_frozen
  local mode head base; mode="$(setting merge_mode)"; base="$(jq -r .base_branch "$JOBJ")"; head="$(branch_head "$JOB_BRANCH")"
  [[ " $MERGE_MODES " == *" $mode "* ]] || die "merge_mode must be one of: $MERGE_MODES (now: '$mode')"
  local cur; cur="$(phase_now)"
  [[ $cur == closing || $cur == awaiting_pr_merge ]] || refuse 1 "ship from phase closing (now: $cur)"
  [[ "$(jq -r '.verify_all.result // ""' "$JOBJ")" == PASS ]] && verified_head "$head" \
    || refuse 1 "verify-all has not passed on the current job branch — dl verify-all"
  ! cmp -s "$JOB_DIR/report.md" "$SKILL_DIR/templates/report.md" || refuse 1 "report.md is still the template — the PM closing check writes it first (it is also the PR body)"
  local acerr; acerr="$(report_ac_errors)"
  [[ -z $acerr ]] || refuse 1 "report.md does not account for every acceptance criterion of plan.md: ${acerr% }— each AC has a row in the Acceptance criteria table with its status (✅ ❌ ⚠️) and its evidence (test name, log, file)"
  knowledge_publish; head="$(branch_head "$JOB_BRANCH")"
  report_decisions; report_contract_changes; report_lessons; report_followups
  job_record_publish; head="$(branch_head "$JOB_BRANCH")"
  if [[ $mode == local ]]; then
    local on; on="$(git -C "$ROOT" symbolic-ref --short -q HEAD || true)"
    [[ $on == "$base" ]] || refuse 1 "merge_mode=local merges into '$base' in the main checkout, which is on '${on:-detached}'. Switch it to $base (or merge yourself: git merge --no-ff $JOB_BRANCH)"
    [[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]] || refuse 1 "the main checkout has uncommitted changes — commit or stash them first"
    local rc=0; dl_merge "$ROOT" "$JOB_BRANCH" "$JOB_BRANCH" "$(jq -r .title "$JOBJ")" || rc=$?
    [[ $rc == 3 ]] && refuse 3 "merge into $base conflicted (base moved on) — merged nothing"
    [[ $rc == 0 ]] || { merge_refused_msg "$JOB_BRANCH" ship; exit 5; }
    jq_inplace "$JOBJ" --arg t "$(now)" --arg c "$(git -C "$ROOT" rev-parse HEAD)" '.shipped=true | .delivery={"mode":"local","commit":$c,"at":$t} | .phase="done"'
    reset_stop_guard; log_event ship "local merge into $base"; echo "SHIPPED: $JOB_BRANCH merged into $base (local). Phase: done — dl cleanup"
    return 0
  fi
  git -C "$ROOT" remote get-url origin >/dev/null 2>&1 || refuse 1 "merge_mode=$mode needs a remote 'origin' (or use merge_mode=local)"
  command -v "$GH" >/dev/null || refuse 1 "merge_mode=$mode needs the GitHub CLI (gh auth login)"
  git -C "$IWT" push -q -u origin "$JOB_BRANCH" || die "push of $JOB_BRANCH failed"
  local url; url="$(jq -r '.pr.url // empty' "$JOBJ")"
  if [[ -z $url ]]; then
    url="$("$GH" pr create --base "$base" --head "$JOB_BRANCH" --title "$(jq -r .title "$JOBJ")" --body-file "$JOB_DIR/report.md" | tail -1)" || die "gh pr create failed"
    log_event pr "opened $url"
  else log_event pr "updated $url"; fi
  jq_inplace "$JOBJ" --arg u "$url" --arg t "$(now)" '.pr = ((.pr // {}) + {"url":$u,"state":"OPEN","at":$t}) | .phase="awaiting_pr_merge"'
  case $mode in
    human) echo "PR: $url — waiting for the human to review and merge (merge_mode=human)." ;;
    semi)
      "$GH" pr merge "$url" --auto --merge >/dev/null 2>&1 && log_event pr "auto-merge armed" \
        || echo "dl: warning — could not arm auto-merge (repo setting 'Allow auto-merge' off?); the human merges after approving" >&2
      echo "PR: $url — auto-merge armed: GitHub merges once a human approves and required checks pass (merge_mode=semi)." ;;
    auto)
      local checks rc=0; checks="$("$GH" pr checks "$url" --watch 2>&1)" || rc=$?
      if [[ $rc -ne 0 && $checks != *"no checks"* ]]; then
        log_event pr "checks failed"; echo "PR: $url — CI FAILED, not merged. Add a fix card (dl phase executing), then dl ship again."; echo "$checks" | tail -15; exit 1
      fi
      "$GH" pr merge "$url" --merge >/dev/null || die "gh pr merge failed — see the PR"
      jq_inplace "$JOBJ" '.pr.state="MERGED" | .shipped=true | .phase="done"'
      log_event pr "merged (auto)"; echo "SHIPPED: $url merged automatically after green checks (merge_mode=auto). Phase: done — dl cleanup" ;;
  esac
  reset_stop_guard
}

cmd_pr() {
  load_job
  local url; url="$(jq -r '.pr.url // empty' "$JOBJ")"; [[ -n $url ]] || die "no PR yet — dl ship"
  local st; st="$("$GH" pr view "$url" --json state,reviewDecision,mergeStateStatus -q '"\(.state) \(.reviewDecision) \(.mergeStateStatus)"')" || die "gh pr view failed"
  read -r state review mstate <<<"$st"
  jq_inplace "$JOBJ" --arg s "$state" '.pr.state=$s'
  case $state in
    MERGED) jq_inplace "$JOBJ" '.shipped=true | .phase="done"'; log_event pr "merged"; echo "MERGED: $url — phase done (dl cleanup)" ;;
    CLOSED) jq_inplace "$JOBJ" '.phase="aborted"'; log_event pr "closed without merge"; echo "CLOSED: $url was closed without merging — job aborted" ;;
    *) echo "OPEN: $url  review=${review:-none}  merge-state=${mstate:-?}" ;;
  esac
}

# The instructions of an agent definition, without its Claude Code frontmatter (kit agents, or ECC's from the plugin cache).
agent_body() {
  local a=$1 f=""
  [[ -n $DELIVER_AGENT_NS ]] && a=${a#"$DELIVER_AGENT_NS:"}
  if [[ $a == ecc:* ]]; then f="$(ls -d "$HOME"/.claude/plugins/cache/ecc/*/*/agents/"${a#ecc:}".md 2>/dev/null | tail -1)"
  else for d in "$SKILL_DIR/../../agents" "$HOME/.claude/agents" "$ROOT/.claude/agents"; do [[ -f $d/$a.md ]] && { f="$d/$a.md"; break; }; done; fi
  if [[ -n $f ]]; then awk 'BEGIN{fm=0} /^---$/ && fm<2 {fm++; next} fm>=2 || fm==0' "$f"
  else echo "(agent definition '$a' not found on this machine — follow the role card above)"; fi
}

# Munder Difflin: start a role for a card as an ephemeral worker on the office floor (spawn-request).
# The objective = the role card generated by dl roles (rules + project facts) + the prompt file.
cmd_md_dispatch() {
  load_job
  local card=${1:-} pfile=${2:-} role=${3:-}
  [[ -n $card && -f $pfile ]] || die "usage: dl md-dispatch <card> <prompt-file> [role]   (role default: the card's role)"
  card_exists "$card"
  local hive="${HIVE_ROOT:-$(setting munder.hive_root)}"
  [[ -n $hive && -d $hive ]] || die "HIVE_ROOT is not set — md-dispatch only works inside Munder Difflin (or set settings.munder.hive_root)"
  role=${role:-$(card_get "$card" .role)}
  local state agent; state="$(card_get "$card" .state)"
  agent="$(jq -r --arg r "$role" '.roles[] | select(.role==$r) | .agent' "$JOBJ" | awk 'NR==1')"
  [[ -n $agent ]] || refuse 1 "role '$role' is not selected for this job"
  if [[ $role == "$(card_get "$card" .role)" ]]; then
    [[ $state == running ]] || refuse 1 "dispatch the dev with dl wt add $card first (state now: $state)"
  else
    [[ $state == review ]] || refuse 1 "$role works on cards in review (state now: $state)"
  fi
  local rolecard="$JOB_DIR/roles/$role.md"
  [[ -f $rolecard ]] || cmd_roles >/dev/null
  local wt attempt req model cmd cap provider
  wt="$(card_get "$card" .worktree)"; attempt="$(card_get "$card" .attempts)"
  req="$(printf 'dl-%s-%s-%s-a%s' "${JOB:4:13}" "$card" "$role" "$attempt" | tr -c 'A-Za-z0-9._-' '-')"
  # Model-agnostic: each role may run on any CLI Munder Difflin supports (job.roles[].provider / .model).
  provider="$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | .provider // "claude"] | first' "$JOBJ")"
  model="$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | .model // empty] | first // empty' "$JOBJ")"; model=${model:-$(setting munder.model)}
  cap="$(setting munder.token_cap)"
  [[ " $MD_PROVIDERS " == *" $provider "* ]] || refuse 1 "provider '$provider' is not one Munder Difflin runs ($MD_PROVIDERS)"
  mkdir -p "$hive/spawn-requests"
  local objective
  if [[ $provider == claude ]]; then
    cmd="$(setting munder.claude_command)"; cmd="${cmd:-claude} --agent $(agent_call "$agent")"
    objective="$(cat "$rolecard"; printf '\n---\n\n'; cat "$pfile")"
  else
    # Other CLIs have no --agent: the agent definition's instructions travel inside the objective, after the role card.
    cmd=""
    objective="$(cat "$rolecard"; printf '\n---\n\n## Your role instructions (%s)\n\n' "$agent"; agent_body "$agent"; printf '\n---\n\n'; cat "$pfile")"
  fi
  local character accent
  character="$(node "$BIN_DIR/roles.mjs" catalog | jq -r --arg r "$role" '.roles[$r].floor.character // empty')"
  accent="$(node "$BIN_DIR/roles.mjs" catalog | jq -r --arg r "$role" '.roles[$r].floor.accent // empty')"
  jq -n --arg id "$req" --arg obj "$objective" --arg cwd "$wt" --arg name "$card $role" \
        --arg cmd "$cmd" --arg model "$model" --argjson cap "${cap:-0}" --arg ch "$character" --arg ac "$accent" \
    --arg prov "$provider" \
    '{id:$id, objective:$obj, cwd:$cwd, name:$name, isolate:false}
     + (if $cmd != "" then {command:$cmd} else {provider:$prov} end)
     + (if $model != "" then {model:$model} else {} end) + (if $cap > 0 then {tokenCap:$cap} else {} end)
     + (if $ch != "" then {character:$ch} else {} end) + (if $ac != "" then {accent:$ac} else {} end)' \
    > "$hive/spawn-requests/.$req.tmp" && mv "$hive/spawn-requests/.$req.tmp" "$hive/spawn-requests/$req.json"
  card_set "$card" '(.cards[] | select(.id==$id)).md_workers += [{"role":$r,"worker":$w,"provider":$p,"at":$t}]' --arg r "$role" --arg w "worker-$req" --arg p "$provider" --arg t "$(now)"
  log_event md-dispatch "$card $role → worker-$req ($provider${model:+ $model})"
  echo "worker-$req  (request: $hive/spawn-requests/$req.json)"
}

# ---- Munder Difflin seats: one person on the floor per role seat, for the whole job ---------------------------------------
# On the floor Michael uses no subagents. md-hire seats a worker for every seat of every role the requirements called for
# (job.roles[].count seats each, default 1) through the spawn queue — no click in the app. A seat stays for the whole job:
# md-send hands it one task at a time as a hive message (role card + the ECC/kit agent instructions + the task), the seat
# answers with an inform "done <task>", Michael records it with md-done, and md-release sends everyone home at the end.
CAST="jim pam dwight kevin angela oscar stanley phyllis andy kelly ryan toby creed meredith"
md_hive() {
  local h="${HIVE_ROOT:-$(setting munder.hive_root)}"
  [[ -z ${HIVE_ROOT:-} && -n $h && -d $h/hive ]] && h="$h/hive"   # munder.hive_root may name the floor's folder (harnessHome)
  [[ -n $h && -d $h ]] || die "HIVE_ROOT is not set — seats only exist inside Munder Difflin (or set settings.munder.hive_root)"
  # Outside the app the floor still has its own Michael (god): he drains the same inbox and would drive this job too.
  if [[ -z ${HIVE_ROOT:-} && ${AGENT_ID:-} != god ]] && jq -e '(.godId // "god") as $g | .agents[$g] | . != null and .archived != true and .status != "gone"' \
       "$h/registry.json" >/dev/null 2>&1; then
    refuse 1 "Michael (god) has a seat on the floor in $h — two orchestrators would share one inbox and both drive this job. Run it from Michael's seat in Munder Difflin (start the app if it is closed): \"/deliver resume\" with REPO: $ROOT"
  fi
  echo "$h"
}
deliver_cmd() { [[ $BIN_DIR =~ /cache/[^/]+/([^/]+)/[^/]+/skills/deliver/bin$ ]] && echo "/${BASH_REMATCH[1]}:deliver" || echo /deliver; }
md_god() { jq -r '.godId // "god"' "$1/registry.json" 2>/dev/null || echo god; }
seat_list() { jq -r '.roles[] | select(.agent != "artemis") | . as $r | range(1; (($r.count // 1) + 1)) | "\($r.role)#\(.)"' "$JOBJ"; }
seat_get() { jq -r --arg s "$1" ".munder.seats[\$s]$2 // empty" "$JOBJ"; }
# A seat is "live" only once its worker has said so: the registry alone cannot tell (a worker that died at startup stays
# in it). seat_eval <seat> <hive> → "<state>\t<reason>", state one of
#   none      nobody was hired for this seat
#   pending   the spawn request waits in the queue (the app has not picked it up)
#   starting  the worker is on the floor but has not sent its "seated" message yet
#   live      it sent "seated" and shows no fatal error since
#   gone      released, archived or reaped by the floor
#   failed    the app rejected the request · its process died (hive log.jsonl agent-exit, crash tail) · its last Claude
#             reply is an API error (credit, auth, rate limit…) · no "seated" within munder.seat_timeout_minutes
seat_age_min() { jq -rn --arg t "$1" '(now - ($t | fromdateiso8601)) / 60 | floor' 2>/dev/null || echo 0; }
seat_transcript() { # the worker's Claude session transcript, if any
  local sid; sid="$(jq -r --arg w "$1" '.agents[$w].sessionId // empty' "$2/registry.json" 2>/dev/null)"
  [[ -n $sid ]] || return 0
  { find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" -maxdepth 2 -name "$sid.jsonl" 2>/dev/null || true; } | awk 'NR==1'
}
seat_eval() {
  local s=$1 h=$2 w req a tr err ex sent age tmo
  w="$(seat_get "$s" .worker)"; [[ -n $w ]] || { printf 'none\t\n'; return; }
  req=${w#worker-}
  if [[ -f $h/spawn-requests/.failed/$req.json ]]; then
    printf 'failed\tthe app rejected the spawn request (%s)\n' "spawn-requests/.failed/$req.json"; return
  fi
  ex="$({ grep -F "\"agentId\":\"$w\"" "$h/log.jsonl" 2>/dev/null || true; } | jq -rs '[.[] | select(.kind=="agent-exit" and .abnormal==true)] | last // empty | "\(.exitCode // "?")\u001f\(.signal // "")\u001f\(.tailPath // "")"' 2>/dev/null || true)"
  if [[ -n $ex ]]; then
    local code sig tp last=""; IFS=$'\x1f' read -r code sig tp <<<"$ex"   # (a tab IFS would merge empty fields)
    [[ -n $tp && -f $tp ]] && last="$(sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' "$tp" | tr -d '\r' | { grep -v '^[[:space:]]*$' || true; } | tail -1 | cut -c1-160)"
    printf 'failed\tits process died (exit %s%s)%s\n' "$code" "${sig:+, signal $sig}" "${last:+ — last output: $last}"; return
  fi
  err="$(jq -r --arg w "$w" '.agents[$w].lastError // empty' "$h/registry.json" 2>/dev/null || true)"
  [[ -n $err ]] && { printf 'failed\tthe floor says: %s\n' "$err"; return; }   # Munder Difflin records why it could not start a worker
  tr="$(seat_transcript "$w" "$h")"
  if [[ -n $tr ]]; then
    err="$(jq -rs '[.[] | select(.type=="assistant")] | last // {} | select(.isApiErrorMessage == true)
                   | [.message.content[]? | .text? // empty] | join(" ") | .[0:160]' "$tr" 2>/dev/null || true)"
    [[ -n $err ]] && { printf 'failed\tits last Claude reply is an API error: %s\n' "$err"; return; }
  fi
  a="$(jq -r --arg w "$w" '.agents[$w] | if . == null then "" elif (.archived == true or .status == "gone") then "gone" else "on" end' "$h/registry.json" 2>/dev/null || true)"
  [[ $a == gone ]] && { printf 'gone\treleased or reaped by the floor\n'; return; }
  age="$(seat_age_min "$(seat_get "$s" .hired_at)")"; tmo="$(setting munder.seat_timeout_minutes)"; tmo=${tmo:-5}
  local secs; secs="$(setting munder.seat_timeout)"   # the older key, in seconds — still honoured
  [[ $secs =~ ^[0-9]+$ ]] && tmo=$(( (secs + 59) / 60 ))
  if [[ -f $h/spawn-requests/$req.json ]]; then
    local cap; cap="$(jq -r '.workerCap // empty' "$h/fleet.json" 2>/dev/null || true)"
    if [[ -n $cap && $(seat_list | wc -l | tr -d ' ') -gt $cap ]]; then printf 'pending\twaits for a free place: the floor runs at most %s workers at once (raise maxConcurrentWorkers in Munder Difflin, or lower a role'"'"'s count)\n' "$cap"; return; fi
    [[ $age -ge $tmo ]] && { printf 'failed\tthe app has not picked up its spawn request in %s min — is Munder Difflin running, with workers allowed?\n' "$age"; return; }
    printf 'pending\tin the spawn queue for %s min\n' "$age"; return
  fi
  sent="$({ find "$h/agents/$w/outbox" -maxdepth 2 -name '*.json' -exec cat {} + 2>/dev/null || true; } | jq -rs '[.[] | select((.subject // "") | startswith("seated"))] | length' 2>/dev/null || echo 0)"
  [[ ${sent:-0} -gt 0 ]] || { [[ -f $h/log.jsonl ]] && jq -en --arg w "$w" 'any(inputs; .kind == "message" and .from == $w)' "$h/log.jsonl" >/dev/null 2>&1 && sent=1; }
  [[ ${sent:-0} -gt 0 ]] && { printf 'live\t\n'; return; }
  [[ $age -ge $tmo ]] && { printf 'failed\tno "seated" message %s min after hiring — it never took its first turn (is the Munder Difflin window open and the screen unlocked? stuck at a prompt? out of credit?)\n' "$age"; return; }
  printf 'starting\ton the floor for %s min, no "seated" message yet\n' "$age"
}
seat_state() { seat_eval "$1" "$2" | cut -f1; }
seat_charter() { # seat_charter <seat> <role> <kind>
  cat <<CH
You are $1 — the $2 seat ($3) of the /deliver job $JOB in $ROOT. You stay at your desk for the whole job.

Michael (god) is your manager. He sends you work orders in your inbox, one at a time. Each order carries your role card, the
instructions to follow for that task (an ECC or kit agent definition, and the skills to load) and the task, with the directory
to work in. How you work:
- Do exactly the task in the order, only in the directory and files it names. Load the skills it names.
- Never run state-changing dl commands (phase, gate, qa, review, integrate, card, wt …) — Michael records every result.
- When the task is finished, write ONE outbox message to god: act "inform", subject "done <task id> $1", body = 3–6 lines
  (what you did, files, commits, your verdict), in_reply_to = the order's id, conversation = the order's conversation.
- An order that names an answer file: write that file first, and report done only after the write succeeded — never in
  the same step as the write (a hook can refuse a write; a done for a file that is not there is not accepted).
- Blocked or unsure: act "query" to god with the question — do not guess.
- Your work is finished only when Michael sends you the release message: then, and only then, send act "done" to god.
  Until then, after each task, wait for the next order. That is what "when finished" means for this seat.

Your first task now: send god an inform with subject "seated $1" and body "ready", then wait for orders.
CH
}

cmd_md_hire() { # [seat] — only that seat (md-reseat)
  [[ ${1:-} == --reseat ]] && { cmd_md_reseat "${2:-}" "${3:-re-seated on request}" "${@:4}"; return; }   # the other branch's spelling
  load_job
  with_lock job apply_role_defaults   # seats are counted here — whatever happened at jobset (a live run hired one QA for two devs)
  local only=${1:-}
  local hive; hive="$(md_hive)"
  [[ "$(setting dispatch)" == munder ]] || refuse 1 "seats are for dispatch munder (dl jobset '.settings.dispatch=\"munder\"')"
  mkdir -p "$hive/spawn-requests"
  local cat used="" s role n st req w n_hire provider model cap cmd ch ac kind obj name old
  cat="$(node "$BIN_DIR/roles.mjs" catalog)"
  used="$(jq -r '[.munder.seats // {} | .[] | .character // empty] | join(" ")' "$JOBJ")"
  while read -r s; do
    [[ -z $only || $s == "$only" ]] || continue
    st="$(seat_state "$s" "$hive")"
    case $st in pending|starting|live) printf '%-16s %-8s %s\n' "$s" "$st" "$(seat_get "$s" .worker)"; continue ;; esac
    # A failed seat is not re-hired blindly (the same model would fail the same way): md-reseat, with its reason.
    [[ $st == failed && -z $only ]] && { printf '%-16s %-8s %s\n' "$s" failed "→ dl md-reseat $s \"<why>\" [--model <model>]"; continue; }
    role=${s%#*}; n=${s#*#}
    n_hire=$(( $(seat_get "$s" .hires || true) + 1 )) 2>/dev/null || n_hire=1
    req="$(printf 'seat-%s-%s-h%s' "${JOB:4:13}" "$s" "$n_hire" | tr -c 'A-Za-z0-9._-' '-')"; w="worker-$req"
    provider="$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | .provider // "claude"] | first' "$JOBJ")"
    # The model is always explicit: the seat's override (md-reseat --model), else the role's, else munder.model —
    # never the app's default model, which may be one the account has no credit for (seen on a user's machine).
    model="$(seat_get "$s" .model)"
    [[ -n $model ]] || model="$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | .model // empty] | first // empty' "$JOBJ")"
    model=${model:-$(setting munder.model)}
    [[ -n $model || $provider != claude ]] || refuse 1 "no model for the $role seat: set settings.munder.model (or the role's model) — seats never start on the app's default model"
    cap="$(setting munder.token_cap)"
    [[ " $MD_PROVIDERS " == *" $provider "* ]] || refuse 1 "provider '$provider' is not one Munder Difflin runs ($MD_PROVIDERS)"
    # One face per person: the role's own character for its first seat, then a cast member nobody on this job has yet.
    ch="$(seat_get "$s" .character)"
    if [[ -z $ch ]]; then
      ch="$(jq -r --arg r "$role" '.roles[$r].floor.character // empty' <<<"$cat")"
      [[ $role == reviewer* ]] && ch=${ch:-toby}
      if [[ -z $ch || " $used " == *" $ch "* ]]; then ch=""; for c in $CAST; do [[ " $used " == *" $c "* ]] || { ch=$c; break; }; done; fi
    fi
    used+=" $ch"
    ac="$(jq -r --arg r "$role" '.roles[$r].floor.accent // empty' <<<"$cat")"
    kind="$(jq -r --arg r "$role" '.roles[$r].kind // (if ($r|startswith("reviewer")) then "review" else "role" end)' <<<"$cat")"
    cmd=""; [[ $provider == claude ]] && { cmd="$(setting munder.claude_command)"; cmd=${cmd:-claude}; }
    name="$role $n"; [[ $(jq --arg r "$role" '[.roles[] | select(.role==$r) | (.count // 1)] | first' "$JOBJ") == 1 ]] && name="$role"
    obj="$(seat_charter "$s" "$role" "$kind")"
    jq -n --arg id "$req" --arg obj "$obj" --arg cwd "$ROOT" --arg name "$name" --arg cmd "$cmd" --arg prov "$provider" \
          --arg model "$model" --argjson cap "${cap:-0}" --arg ch "$ch" --arg ac "$ac" \
      '{id:$id, objective:$obj, cwd:$cwd, name:$name, isolate:false}
       + (if $cmd != "" then {command:$cmd} else {provider:$prov} end)
       + (if $model != "" then {model:$model} else {} end) + (if $cap > 0 then {tokenCap:$cap} else {} end)
       + (if $ch != "" then {character:$ch} else {} end) + (if $ac != "" then {accent:$ac} else {} end)' \
      > "$hive/spawn-requests/.$req.tmp" && mv "$hive/spawn-requests/.$req.tmp" "$hive/spawn-requests/$req.json"
    jq_inplace "$JOBJ" --arg s "$s" --arg r "$role" --arg w "$w" --argjson h "$n_hire" --arg ch "$ch" --arg t "$(now)" \
      '.munder.seats[$s] = ((.munder.seats[$s] // {}) | {model} | with_entries(select(.value != null))) + {role:$r, worker:$w, hires:$h, character:$ch, hired_at:$t, task:null, orders:(.munder.seats[$s].orders // 0)}'
    log_event md-hire "$s → $w ($provider${model:+ $model}${ch:+, $ch})$([[ $st == none ]] || echo " — re-seated, was $st")"
    printf '%-16s %-8s %s\n' "$s" hired "$w"
  done < <(seat_list)
  [[ -n $only ]] || md_cap_note "$hive"
}

# md-reseat: a seat that failed or is stuck gets a new person. The old worker is sent home (if it is still there), its
# queued request withdrawn, its open task cleared (Michael sends it again to the new person), and a new one is hired —
# on another model with --model (a credit or model error). After the start this is Michael's decision: recorded for the PR.
cmd_md_reseat() {
  load_job
  local seat=${1:-} why=${2:-} model=""
  [[ -n $seat && -n $why ]] || die 'usage: dl md-reseat <seat> "<why>" [--model <model>]'
  [[ ${3:-} == --model ]] && { model=${4:-}; [[ -n $model ]] || die "--model needs a model"; }
  local hive; hive="$(md_hive)"
  seat_list | grep -qxF "$seat" || refuse 1 "'$seat' is not a seat of this job (dl md-seats)"
  local w req task st; w="$(seat_get "$seat" .worker)"; req=${w#worker-}; task="$(seat_get "$seat" .task)"; st="$(seat_state "$seat" "$hive")"
  [[ -n $w ]] || refuse 1 "$seat was never hired — dl md-hire"
  rm -f "$hive/spawn-requests/$req.json"
  case $st in live|starting) md_order "$w" "$hive" "release — your seat is re-seated" "Your seat $seat is given to someone else ($why). Send act \"done\" to god now." "deliver-$JOB-reseat" ;; esac
  jq_inplace "$JOBJ" --arg s "$seat" --arg m "$model" '.munder.seats[$s] += {worker:null, task:null, since:null, out:null} | if $m != "" then .munder.seats[$s].model = $m else . end'
  log_event md-reseat "$seat ($st${task:+, was on $task}): $why${model:+ → model $model}"
  pm_decision "re-seated $seat${model:+ on $model}${task:+ (its task $task is sent again)}" "$why"   # never a question: listed in the PR
  cmd_md_hire "$seat"
  [[ -z $task ]] || echo "send $task again once $seat is seated: dl md-send $seat $task <order file>"
}

# md_cap_note <hive> — the floor runs at most fleet.json's workerCap workers at once; more seats wait in the queue
md_cap_note() {
  local cap seats; cap="$(jq -r '.workerCap // empty' "$1/fleet.json" 2>/dev/null || true)"; seats="$(seat_list | wc -l | tr -d ' ')"
  [[ -n $cap && $seats -gt $cap ]] || return 0
  echo "note: this job has $seats seats but the floor runs at most $cap workers at once — $((seats - cap)) seat(s) wait until someone leaves. Raise \"maxConcurrentWorkers\" in Munder Difflin, or lower a role's count." >&2
}

cmd_md_seats() {
  load_job
  local hive s ev st why; hive="$(md_hive)"
  local miss="" bad=""
  { echo -e "SEAT\tSTATE\tWORKER\tTASK"
    while read -r s; do
      ev="$(seat_eval "$s" "$hive")"; st=${ev%%$'\t'*}
      printf '%s\t%s\t%s\t%s\n' "$s" "$st" "$(seat_get "$s" .worker)" "$(seat_get "$s" .task)"
    done < <(seat_list); } | table
  while read -r s; do
    ev="$(seat_eval "$s" "$hive")"; st=${ev%%$'\t'*}; why=${ev#*$'\t'}
    case $st in
      none|gone) miss+="$s " ;;
      failed) bad+="$s "; echo "FAILED   $s: $why" ;;
      pending|starting) echo "waiting  $s: $why" ;;
    esac
  done < <(seat_list)
  [[ -z $miss ]] || echo "not seated: ${miss}→ dl md-hire"
  md_cap_note "$hive"
  [[ -z $bad ]] || echo "failed: ${bad}→ dl md-reseat <seat> \"<why>\" [--model <model>] (a credit or model error: pick another model)"
}

# md_order <worker> <hive> <subject> <body> <conversation> — a message from god into the router's queue
md_order() {
  local god id; god="$(md_god "$2")"; id="$(date -u +%Y%m%dT%H%M%S)-dl-$RANDOM"
  mkdir -p "$2/agents/$god/outbox"
  jq -n --arg to "$1" --arg sub "$3" --arg body "$4" --arg conv "$5" '{to:$to, act:"request", subject:$sub, body:$body, conversation:$conv}' \
    > "$2/agents/$god/outbox/.$id.tmp" && mv "$2/agents/$god/outbox/.$id.tmp" "$2/agents/$god/outbox/$id.json"
}

cmd_md_send() {
  load_job
  local target=${1:-} task=${2:-} pfile=${3:-} agent=""
  [[ -n $target && -n $task && -f $pfile ]] || die "usage: dl md-send <seat|role> <task: card id or plan step> <prompt-file> [--agent <agent>]"
  [[ ${4:-} == --agent ]] && agent=${5:-}
  local hive; hive="$(md_hive)"
  local seat role iscard=0 dir="$ROOT" s
  [[ $task =~ ^T-[0-9]+$ ]] && { card_exists "$task"; iscard=1; }
  if [[ $target == *#* ]]; then seat=$target; role=${seat%#*}
  else
    role=$target
    if [[ $iscard == 1 && $role == "$(card_get "$task" .role)" && -n "$(card_get "$task" '.seat // empty')" ]]; then seat="$(card_get "$task" .seat)"
    else
      seat=""; while read -r s; do
        [[ ${s%#*} == "$role" && "$(seat_state "$s" "$hive")" == live && -z "$(seat_get "$s" .task)" ]] && { seat=$s; break; }
      done < <(seat_list)
      [[ -n $seat ]] || refuse 1 "no free seat for role '$role' — dl md-seats (busy seats are freed by dl md-done)"
    fi
  fi
  seat_list | grep -qxF "$seat" || refuse 1 "'$seat' is not a seat of this job (dl md-seats)"
  if [[ $iscard == 1 ]]; then
    local state; state="$(card_get "$task" .state)"
    if [[ $role == "$(card_get "$task" .role)" ]]; then
      [[ $state == running ]] || refuse 1 "assign the card first: dl wt add $task (state now: $state)"
      local cs; cs="$(card_get "$task" '.seat // empty')"
      [[ -z $cs || $cs == "$seat" ]] || refuse 1 "$task is assigned to seat $cs, not $seat"
    else
      [[ $state == review ]] || refuse 1 "$role works on cards in review (state now: $state)"
    fi
    dir="$(card_get "$task" .worktree)"
  fi
  local ev; ev="$(seat_eval "$seat" "$hive")"
  case ${ev%%$'\t'*} in
    live) ;;
    pending|starting) refuse 1 "$seat is not seated yet (${ev#*$'\t'}) — wait for its \"seated\" message (dl md-seats)" ;;
    failed) refuse 1 "$seat failed: ${ev#*$'\t'} — dl md-reseat $seat \"<why>\" [--model <model>]" ;;
    *) refuse 1 "$seat has no one at the desk (${ev%%$'\t'*}) — dl md-hire seats someone" ;;
  esac
  local busy; busy="$(seat_get "$seat" .task)"
  [[ -z $busy ]] || refuse 1 "$seat is busy with $busy — dl md-done $seat \"<summary>\" when it reports"
  agent=${agent:-$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | .agent] | first // empty' "$JOBJ")}
  [[ -n $agent ]] || refuse 1 "role '$role' is not selected for this job"
  local rolecard="$JOB_DIR/roles/$role.md"; [[ -f $rolecard ]] || cmd_roles >/dev/null
  mkdir -p "$JOB_DIR/out"
  # Every task but code answers in one file, named here: md-done accepts the report only once that file is there (run 53:
  # a seat reported "done" for a write a hook had refused, and Michael searched the whole disk for it for two minutes).
  local w body out="" outline f; w="$(seat_get "$seat" .worker)"
  if [[ ! ( $iscard == 1 && $role == "$(card_get "$task" .role)" ) && ! $task =~ ^T-[0-9]+-tests$ ]]; then
    out="$JOB_DIR/out/$task-$role"
    for f in "$out.md" "$out.json"; do   # an earlier answer to the same task is kept, never taken for the new one
      [[ -e $f ]] && { mkdir -p "$JOB_DIR/out/.prev"; mv "$f" "$JOB_DIR/out/.prev/$(basename "$f").$(date -u +%Y%m%dT%H%M%S)"; }
    done
    outline="Your answer goes to exactly one file: $out.md (or $out.json when the task asks for JSON). Write it before you report done, and check the write succeeded — a done without that file is not accepted."
  else
    outline="Your commits are your work; analysis or notes (no code) go to files under: $JOB_DIR/out/"
  fi
  body="$(printf '# Work order %s for %s\n\nWork in: %s\n%s\nWhen finished: inform to god, subject "done %s %s".\n\n---\n\n## Your role card\n\n' \
            "$task" "$seat" "$dir" "$outline" "$task" "$seat"
          cat "$rolecard"
          printf '\n---\n\n## Instructions for this task — %s\n\n' "$(agent_call "$agent")"; agent_body "$agent"
          printf '\n---\n\n## The task\n\n'; cat "$pfile")"
  md_order "$w" "$hive" "$task — $role ($seat)" "$body" "deliver-$JOB-$task"
  jq_inplace "$JOBJ" --arg s "$seat" --arg k "$task" --arg t "$(now)" --arg o "$out" \
    '.munder.seats[$s] += {task:$k, since:$t, out:(if $o == "" then null else $o end), orders:((.munder.seats[$s].orders // 0) + 1)}'
  [[ $iscard == 1 ]] && card_set "$task" '(.cards[] | select(.id==$id)).md_workers += [{"role":$r,"seat":$s,"worker":$w,"at":$t}]' \
    --arg r "$role" --arg s "$seat" --arg w "$w" --arg t "$(now)"
  log_event md-send "$task $seat ($agent) → $w"
  echo "$task → $seat ($w)${out:+ — answer: $out.md|.json}"
}

cmd_md_done() {
  load_job
  local seat=${1:-} summary=${2:-}
  [[ -n $seat && -n $summary ]] || die "usage: dl md-done <seat> \"<the seat's summary>\""
  local task out f="" why=""; task="$(seat_get "$seat" .task)"; out="$(seat_get "$seat" .out)"
  [[ -n $task ]] || refuse 1 "$seat has no open task"
  if [[ -n $out ]]; then   # the answer file the work order named: there, not empty, and valid JSON when it is .json
    if [[ -s $out.json ]]; then f=$out.json; jq empty "$f" 2>/dev/null || why="$f is not valid JSON"
    elif [[ -s $out.md ]]; then f=$out.md
    else why="$out.md (or .json) does not exist or is empty"; fi
    if [[ -n $why ]]; then
      md_order "$(seat_get "$seat" .worker)" "$(md_hive)" "$task — your done is not accepted" \
        "Your report \"done $task $seat\" is not accepted: $why. A write a hook refused did not happen — read the tool result. Write your answer to $out.md (or $out.json), then report \"done $task $seat\" again." \
        "deliver-$JOB-$task"
      log_event md-done-refused "$task $seat: $why"
      refuse 1 "$seat's done for $task is not accepted: $why — the seat was told and keeps the task; wait for its next report (dl md-wait)"
    fi
  fi
  jq_inplace "$JOBJ" --arg s "$seat" --arg t "$(now)" '.munder.seats[$s] += {task:null, since:null, out:null, last_done:$t}'
  log_event md-done "$task $seat: $summary"
  echo "$seat is free ($task done)${f:+ — answer: $f}"
}

# Michael waits for his inbox with this, never a loop of his own (run 53: 10-second sleeps, a wait.sh): it returns within a
# second of a message, then shows it as md-inbox does. The default fits one Bash call (2 min).
cmd_md_wait() {
  load_job
  local max=${1:-110} t=0 hive dir; [[ $max =~ ^[0-9]+$ ]] || die "usage: dl md-wait [seconds — default 110]"
  hive="$(md_hive)"; dir="$hive/agents/$(md_god "$hive")/inbox"
  if [[ "$(jq '[.munder.seats // {} | .[] | select(.task != null)] | length' "$JOBJ")" == 0 ]] && ! find "$dir" -maxdepth 1 -name '*.json' 2>/dev/null | grep -q .; then
    echo "no seat has an open task and the inbox is empty — nothing to wait for"; return 0
  fi
  while ! find "$dir" -maxdepth 1 -name '*.json' 2>/dev/null | grep -q . && [[ $t -lt $max ]]; do sleep 1; t=$((t + 1)); done
  cmd_md_inbox
  [[ $t -lt $max ]] || echo "(waited ${max}s — run dl md-wait again)"
}

# Once per seat: a second md-release (parallel calls, seen live) sends nobody home twice.
cmd_md_release() { load_job; with_lock job _md_release_sub "$@"; }
_md_release_sub() { ( _md_release_locked "$@" ); }
_md_release_locked() {
  local hive s w n=0; hive="$(md_hive)"
  while read -r s; do
    [[ -z "$(seat_get "$s" .released)" ]] || continue
    case "$(seat_state "$s" "$hive")" in live|starting) ;; *) continue ;; esac
    w="$(seat_get "$s" .worker)"
    md_order "$w" "$hive" "release — job $JOB is finished" "The job is finished and your seat is released. Thank you. Send act \"done\" to god now." "deliver-$JOB-release"
    jq_inplace "$JOBJ" --arg s "$s" --arg t "$(now)" '.munder.seats[$s].released = $t'
    log_event md-release "$s → $w"; n=$((n + 1))
  done < <(seat_list)
  echo "released $n seat(s)"
}

# Michael's inbox on the floor: shows each new message once (sender as its seat), then archives exactly the files it
# showed — never a glob move, which can file a report that arrived a moment earlier unread. It also finds reports that
# were archived without being recorded: a seat still holds the task its "done <task> <seat>" message reports.
cmd_md_inbox() {
  load_job
  local hive god dir map f n=0; hive="$(md_hive)"; god="$(md_god "$hive")"; dir="$hive/agents/$god/inbox"
  mkdir -p "$dir/.done"
  map="$(jq -c '[.munder.seats // {} | to_entries[] | {key: .value.worker, value: .key}] | from_entries' "$JOBJ")"
  local files=(); while IFS= read -r f; do files+=("$f"); done < <(find "$dir" -maxdepth 1 -name '*.json' | sort)
  for f in ${files[@]+"${files[@]}"}; do   # empty-array guard: bash 3.2 + set -u calls "${files[@]}" unbound
    jq -r --argjson m "$map" '"── \(.created_at // "?") · \($m[.from] // .from) · \(.act // "inform") · \(.subject // "")\n\(.body // "" | split("\n")[0:40] | join("\n"))\n"' "$f" 2>/dev/null \
      || echo "── (unreadable message: $(basename "$f"))"
    mv "$f" "$dir/.done/"; n=$((n + 1))
  done
  local seat task since w r miss=0
  while IFS=$'\x1f' read -r seat task since w; do   # \x1f: an empty "since" must not shift the worker into its place
    [[ -n $seat ]] || continue
    r="$(find "$dir/.done" -maxdepth 1 -name '*.json' -exec jq -r --arg w "$w" --arg sub "done $task $seat" --arg s "$since" \
          'select(.from == $w and (.subject // "" | startswith($sub)) and ((.created_at // "") >= $s)) | "\(.created_at) \(.body // "" | split("\n")[0])"' {} + 2>/dev/null | sort | tail -1)"
    [[ -n $r ]] || continue
    echo "UNRECORDED  $seat reported \"done $task\" at ${r%% *} — ${r#* }"
    echo "            record it: dl md-done $seat \"<summary>\""; miss=$((miss + 1))
  done < <(jq -r '.munder.seats // {} | to_entries[] | select(.value.task != null) | [.key, .value.task, (.value.since // ""), .value.worker] | join("\u001f")' "$JOBJ")
  [[ $n -gt 0 || $miss -gt 0 ]] || echo "(no new messages)"
}

cmd_cleanup() {
  load_job
  suite_stop all
  local d
  for d in "$JOB_DIR"/wt/*; do
    [[ -d $d && $(basename "$d") != _integration ]] && git -C "$ROOT" worktree remove --force "$d"
  done
  if [[ ${1:-} == --all ]]; then git -C "$ROOT" worktree remove --force "$IWT" 2>/dev/null || true; fi
  [[ "$(cat "$WORK/ACTIVE" 2>/dev/null)" == "$JOB" ]] && rm -f "$WORK/ACTIVE"
  rm -f "$REG/$JOB"
  git -C "$ROOT" worktree prune
  log_event cleanup "${1:-}"; echo "cleaned up: $JOB (branches kept)"
}

# Seat utilisation: which role seats are busy, which are idle — and for each idle one, the work it should take.
SEATS_JQ='. as $b | ($j.roles | map(select(.count != null) | {role, count})) as $caps
  | [ $caps[] as $c | range(1; $c.count + 1) as $n | ($c.role + "#" + ($n|tostring)) as $seat
      | ([$b.cards[] | select(.state=="running" and .seat==$seat) | .id] | first) as $busy
      | ([$b.cards[] | select(.state=="ready" and .role==$c.role and .attempts < $max
            and all((.depends_on // [])[]; . as $d | ([$b.cards[] | select(.id==$d) | .state] | first) == "merged")) | .id]) as $ready
      | ([$b.cards[] | select(.state=="ready" and .role==$c.role) | .id]) as $waiting
      | {seat:$seat, role:$c.role, busy:$busy, ready:$ready, waiting:$waiting} ]'
seats_json() { jq --argjson j "$(cat "$JOBJ")" --argjson max "$(setting max_attempts)" "$SEATS_JQ" "$BOARD"; }
cmd_seats() {
  load_job
  seats_json | jq -r '(["SEAT","STATE","CARD / NEXT"] | @tsv), (.[] | [.seat, (if .busy then "busy" else "IDLE" end),
     (if .busy then .busy elif (.ready|length)>0 then "→ assign " + (.ready|join(", ")) elif (.waiting|length)>0 then "waiting on dependencies of " + (.waiting|join(", ")) else "no work for this role" end)] | @tsv)' | table
  jq -r '[.roles[] | select(.count == null) | .role] | if length>0 then "(roles without a seat count share max_parallel: " + join(", ") + ")" else empty end' "$JOBJ"
}

cmd_kanban() {
  load_job
  node "$BIN_DIR/tracker-cli.mjs" kanban "$JOB_DIR" "$@"
  echo; echo "tracker: $(jq -r '.settings.tracker.kind // "local"' "$JOBJ")$(jq -r '.tracker.url // empty | " · " + .' "$JOBJ")  · html: $JOB_DIR/kanban.html"
}
cmd_tracker() {
  if [[ ${1:-} == check ]]; then   # no job needed: the repo's settings (kit ⊕ yours ⊕ .deliver.json) against the live tracker
    resolve_root; local f rc=0; f="$(mktemp)"; merged_settings > "$f"
    node "$BIN_DIR/tracker-cli.mjs" check "$f" || rc=$?; rm -f "$f"; return $rc
  fi
  [[ ${1:-} == switch ]] && { shift; cmd_tracker_switch "$@"; return; }
  load_job; case ${1:-sync} in open|sync) with_lock board.json node "$BIN_DIR/tracker-cli.mjs" "${1:-sync}" "$JOB_DIR"; seal "$BOARD"; seal "$JOBJ" ;; *) die "usage: dl tracker [open|sync|check|switch <kind> \"<why>\"]" ;; esac
}
# dl tracker switch <kind> "<why>" — the human moves the active job to another tracker (/deliver:tracker). Its settings come
# from .deliver.json (and ~/.deliver/config.json): set tracker.<kind> there first. The new tracker is checked before anything
# changes; then the job's settings change, and — once the job is in the tool (executing or later) — the new tool opens the
# job and every card in its current column. What the old tool holds is left as it is; its links stay in the card's history.
cmd_tracker_switch() {
  human_only "switching the job's tracker (dl tracker switch)"
  local kind=${1:-} why=${2:-}; [[ -n $kind && -n $why ]] || die 'usage: dl tracker switch <local|jira|asana|linear|github|…> "<why>"'
  load_job
  local cur kinds; cur="$(setting tracker.kind)"; cur=${cur:-local}
  [[ $kind != "$cur" ]] || refuse 1 "the job already uses the $kind tracker"
  kinds=$(node --input-type=module -e "import {trackerKinds, loadTrackers} from '$BIN_DIR/tracker.mjs'; await loadTrackers(); console.log(trackerKinds().join(', '))")
  [[ ", $kinds, " == *", $kind, "* ]] || refuse 1 "'$kind' is not a known tracker ($kinds)"
  local repo new f out rc=0
  repo="$(merged_settings | jq -c '.tracker // {}')"
  new="$(jq -c --arg k "$kind" --argjson r "$repo" '.settings.tracker * ($r | with_entries(select(.key == $k or .key == "columns"))) + {kind: $k}' "$JOBJ")"
  f="$(mktemp)"; jq --argjson t "$new" '.settings + {tracker: $t}' "$JOBJ" > "$f"
  out="$(node "$BIN_DIR/tracker-cli.mjs" check "$f" 2>&1)" || rc=$?; rm -f "$f"
  [[ $rc -eq 0 ]] || refuse 1 "the $kind tracker is not ready — nothing was changed:
$out
(its settings are read from .deliver.json → tracker.$kind; the credentials from the environment)"
  jq_inplace "$JOBJ" --argjson t "$new" '.settings.tracker = $t'
  log_event tracker-switch "$cur → $kind by ${DELIVER_APPROVER:-${USER:-human}}: $why"
  echo "$out"
  if [[ " executing integrating closing awaiting_pr_merge done " == *" $(phase_now) "* ]]; then
    local o2 r2=0; o2="$(with_lock board.json node "$BIN_DIR/tracker-cli.mjs" open "$JOB_DIR" 2>&1)" || r2=$?; seal "$BOARD"; seal "$JOBJ"
    if [[ $r2 -ne 0 ]]; then
      printf '%s\t%s\t%s\n' "$(now)" tracker-error "$o2" >> "$JOB_DIR/events.log"
      echo "warning: switched, but opening the job in $kind failed — the next step retries it: $o2"
    else echo "$o2"; fi
  fi
  echo "the job now uses the $kind tracker (was $cur); the $cur tool keeps what it had — the links stay in each card's history"
}
cmd_reseal() { # human only (bash-guard): accept the current job.json/board.json after inspecting an outside change
  human_only "dl reseal"; DL_NO_SEAL_CHECK=1 load_job
  local reason=${1:-}; [[ -n $reason ]] || die 'usage: dl reseal "<what was changed outside dl and why it is accepted>"'
  seal "$JOBJ"; seal "$BOARD"; log_event reseal "${DELIVER_APPROVER:-${USER:-human}}: $reason"; echo "resealed"
}

cmd_jobs() {
  [[ -d $REG ]] || { echo "no jobs registered"; return 0; }
  local f id root
  for f in "$REG"/*; do
    [[ -f $f ]] || continue
    id="$(basename "$f")"; root="$(cat "$f")"
    printf '%s\t%s\t%s\n' "$id" "$(jq -r .phase "$root/.work/$id/job.json" 2>/dev/null || echo missing)" "$root"
  done | table
}

# Munder Difflin is the default (settings.dispatch "munder"). A floor job is driven only by the app's Michael
# (AGENT_ID=god, set by Munder Difflin in his terminal): run /deliver from a separate terminal and two Michaels read the
# same inbox and race for every seat's report (seen on a user's machine). The human answers (clarify, approve), reads
# (status, next, board, kanban, md-seats) and switches modes (dl dispatch) from any terminal.
FLOW_CMDS=" new phase jobset roles readiness decide pm-decide reopen learn followup wt card gate qa qa-join review integrate verify-all baseline suite ship pr md-dispatch md-hire md-reseat md-send md-done md-release md-inbox md-wait cleanup "
dispatch_of() { # the dispatch a command would run under: the active job's, or for `new` the repo's / the kit default
  resolve_root
  local j="${DELIVER_JOB:-$(cat "$WORK/ACTIVE" 2>/dev/null || true)}" d=""
  if [[ $1 != new && -n $j && -f $WORK/$j/job.json ]]; then d="$(jq -r '.settings.dispatch // empty' "$WORK/$j/job.json")"
  else
    [[ -f $ROOT/.deliver.json ]] && d="$(jq -r '.dispatch // empty' "$ROOT/.deliver.json" 2>/dev/null || true)"
    [[ -z $d && -f $USER_CONFIG ]] && d="$(jq -r '.dispatch // empty' "$USER_CONFIG" 2>/dev/null || true)"
    d=${d:-$(jq -r '.dispatch // empty' "$CONFIG")}
  fi
  echo "${d:-munder}"
}
floor_guard() {
  [[ $FLOW_CMDS == *" $1 "* && ${AGENT_ID:-} != god ]] || return 0
  # the human's /deliver:retry: one granted retry is not a second Michael (bash-guard keeps a model from setting this)
  [[ ${DELIVER_HUMAN_CMD:-} == 1 && $1 == card && ${3:-} == retry ]] && return 0
  [[ "$(dispatch_of "$1")" == munder ]] || return 0
  [[ ${AGENT_ID:-} == worker-* ]] && refuse 9 "a seat does not run the flow — Michael records every step"
  local how="\"dispatch\": \"subagent\" in .deliver.json"; [[ $1 == new ]] || how+=" for new jobs, or /deliver:mode subagent <why> for this one"
  refuse 9 "this job runs on the Munder Difflin floor (dispatch: munder, the default): never from a separate terminal, where a second Michael would read the same inbox. Hand it to Michael in the app: dl floor-open \"<request>\" opens the floor and gives him the job. To work without the floor (Claude Code subagents), the human switches by hand: $how — see docs/07-munder-difflin.md#choosing-the-mode"
}

# dl floor-open "<request>" — /deliver typed in a terminal for a floor repo: open Munder Difflin on this repo's floor and hand
# the request to Michael there (his inbox; the app wakes him when idle, or he reads it when he starts). Nothing runs here.
md_app_config() { # the app's config.json (userData: "munder-difflin" for source builds, "Munder Difflin" for installed apps)
  local d c
  case "$(uname -s)" in
    Darwin) d="$HOME/Library/Application Support" ;;
    MINGW*|MSYS*|CYGWIN*) d="${APPDATA:-$HOME/AppData/Roaming}" ;;
    *) d="${XDG_CONFIG_HOME:-$HOME/.config}" ;;
  esac
  for c in "$d/munder-difflin/config.json" "$d/Munder Difflin/config.json"; do [[ -f $c ]] && { echo "$c"; return 0; }; done
  echo "$d/munder-difflin/config.json"
}
md_app_running() { # md_app_running <floor> <app config.json> — Michael's heartbeat (≤ 2 min), or the app's single-instance lock
  local reg=$1/hive/registry.json seen lock pid
  seen="$(jq -r '.agents[.godId // "god"].lastSeen // 0' "$reg" 2>/dev/null || echo 0)"
  [[ $(( $(date +%s) - ${seen:-0} / 1000 )) -lt 120 ]] && return 0
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) tasklist //FI "IMAGENAME eq Munder Difflin.exe" 2>/dev/null | grep -qi "Munder Difflin" ;;
    *) lock="$(dirname "$2")/SingletonLock"   # Electron's lock: a symlink to "<host>-<pid>" while the app runs
       [[ -L $lock ]] || return 1; pid="$(readlink "$lock")"; pid=${pid##*-}
       [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null ;;
  esac
}
md_app_start() { # munder.app_command, else the installed app, else the source checkout scripts/init.sh --munder made
  local cmd; cmd="$(project_setting munder.app_command)"
  local log="$1/deliver-app.log"
  if [[ -n $cmd ]]; then (nohup bash -c "$cmd" >"$log" 2>&1 &) ; return 0; fi
  case "$(uname -s)" in
    Darwin) open -a "Munder Difflin" 2>/dev/null && return 0 ;;
    MINGW*|MSYS*|CYGWIN*) local exe="${LOCALAPPDATA:-}/Programs/Munder Difflin/Munder Difflin.exe"; [[ -f $exe ]] && { cmd.exe //c start "" "$(cygpath -w "$exe" 2>/dev/null || echo "$exe")" >/dev/null 2>&1; return 0; } ;;
  esac
  local src="${XDG_DATA_HOME:-$HOME/.local/share}/munder-difflin"
  if [[ -f $src/package.json ]]; then (cd "$src" && nohup npm run preview >"$log" 2>&1 &); return 0; fi
  return 1
}
project_setting() { # a key from the layered settings (kit defaults ⊕ the user's config ⊕ .deliver.json), no job needed
  merged_settings | jq -r ".$1 // empty"
}
merged_settings() {
  local settings f; settings="$(cat "$CONFIG")"
  for f in "$USER_CONFIG" "$ROOT/.deliver.json"; do
    [[ -f $f ]] || continue
    settings="$(jq -s '.[0] * .[1] | del(."$schema")' <(printf '%s' "$settings") "$f")" || die "$f is not valid JSON"
  done
  printf '%s\n' "$settings"
}
cmd_floor_open() {
  resolve_root
  local req=${1:-}; [[ -n $req ]] || die 'usage: dl floor-open "<the /deliver request: text or a path to a requirements .md>"'
  [[ "$(dispatch_of new)" == munder ]] || refuse 1 "this repo runs with subagents (dispatch: subagent) — just run /deliver here"
  local created=0; [[ -f $ROOT/.deliver.json ]] || { ensure_project_config; created=1; }   # the repo is known: its settings, read from it
  local home cfg h; cfg="$(md_app_config)"
  home="$(project_setting munder.hive_root)"; home=${home%/}; [[ $(basename "${home:-x}") == hive && -f $home/registry.json ]] && home="$(dirname "$home")"
  [[ -n $home ]] || home="$(jq -r '.harnessHome // empty' "$cfg" 2>/dev/null || true)"
  [[ -n $home ]] || refuse 1 "no floor for this repo: set \"munder\": {\"hive_root\": \"<folder>\"} in .deliver.json (scripts/init.sh --munder --hive <folder> --repo $ROOT does it all)"
  home="${home/#\~/$HOME}"; mkdir -p "$home"
  if [[ $created == 1 && -z "$(jq -r '.munder.hive_root // empty' "$ROOT/.deliver.json")" ]]; then   # the file just written: record the floor it uses
    jq --arg h "$home" '.munder.hive_root = $h' "$ROOT/.deliver.json" > "$ROOT/.deliver.json.tmp" && mv "$ROOT/.deliver.json.tmp" "$ROOT/.deliver.json"
    echo "  munder.hive_root: $home — the floor this repo opens" >&2
  fi
  local started=0
  if md_app_running "$home" "$cfg"; then
    h="$(jq -r '.harnessHome // empty' "$cfg" 2>/dev/null || true)"
    [[ -z $h || "${h/#\~/$HOME}" == "$home" ]] || refuse 1 "Munder Difflin is open on another floor ($h) — open $home in it (File → Open floor), or close it and run /deliver again"
  else
    [[ -f $cfg ]] || { mkdir -p "$(dirname "$cfg")"; echo '{}' > "$cfg"; }
    jq --arg h "$home" --arg r "$ROOT" '.harnessHome = $h | .recentHives = ([$h] + ((.recentHives // []) - [$h]))
      | .registeredRepos = (((.registeredRepos // []) + [$r]) | unique) | .orchestratorMaySpawn = true
      | .workerIdleTimeoutMinutes = ([.workerIdleTimeoutMinutes // 0, 480] | max) | .maxConcurrentWorkers = ([.maxConcurrentWorkers // 0, 12] | max)' \
      "$cfg" > "$cfg.tmp" && mv "$cfg.tmp" "$cfg"
    bash "$BIN_DIR/md-brief.sh" "$home" "$ROOT" >/dev/null   # teach Michael /deliver (idempotent: refreshes the section)
    md_app_start "$home" || refuse 1 "Munder Difflin is not installed here — install it with scripts/init.sh --munder (the cantasci/munder-difflin fork — the released app's seats never start), or set munder.app_command in .deliver.json"
    started=1
  fi
  # The request goes into Michael's inbox as the human's message; the router-side wake (or his start-up inbox drain) picks it up.
  local inbox="$home/hive/agents/god/inbox" id; mkdir -p "$inbox"; id="$(date -u +%Y%m%dT%H%M%S)-deliver-$RANDOM"
  jq -n --arg id "$id" --arg body "$(deliver_cmd) $req
REPO: $ROOT" --arg t "$(date -u +%FT%T.000Z)" \
    '{id:$id, conversation:("deliver-" + $id), from:"human", to:"god", act:"request", subject:"/deliver", body:$body, hops:0, requires_reply:false, needs_human:false, created_at:$t}' \
    > "$inbox/.$id.tmp" && mv "$inbox/.$id.tmp" "$inbox/$id.json"
  echo "Munder Difflin $([[ $started == 1 ]] && echo "is starting on" || echo "is open on") $home — the job went to Michael there (his inbox: $id)."
  [[ $started == 1 ]] && echo "The app opens on its floor picker with this floor selected: click Open once — Michael starts and reads the job."
  mkdir -p "$WORK"; local excl="$common_dir/info/exclude"; mkdir -p "$(dirname "$excl")"; grep -qxF .work/ "$excl" 2>/dev/null || echo .work/ >> "$excl"
  jq -n --arg id "$id" --arg f "$home" --arg r "$req" --arg t "$(now)" '{id:$id, floor:$f, request:$r, at:$t}' > "$WORK/FLOOR-PENDING.tmp" \
    && mv "$WORK/FLOOR-PENDING.tmp" "$WORK/FLOOR-PENDING"
  echo "Follow it on the floor, or here in Claude Code: /deliver:status · /deliver:board · /deliver:seats (Michael in the app drives the job)."
}

# dl agents [card] [--all] — the subagents that worked on this job's cards, from Claude Code's own transcripts: id, session,
# when they last wrote, and whether they ended on an API error (a usage limit, credit). Michael continues a stopped one with
# SendMessage to its id — its whole history intact — before he ever starts a new agent for the card (Resume).
cmd_agents() {
  load_job
  local a; a="$(node "$BIN_DIR/agents.mjs" "$JOB_DIR" "$@")" || die "could not read the subagent transcripts"
  if [[ "$(jq length <<<"$a")" == 0 ]]; then echo "no subagent of this job found in Claude Code's transcripts (${CLAUDE_CONFIG_DIR:-~/.claude}/projects/*/*/subagents/)"; return 0; fi
  jq -r --slurpfile b "$BOARD" '(["CARD","STATE","ROLE AGENT","AGENT ID","SESSION","LAST WRITE","ENDED"] | @tsv),
    (.[] | . as $x | [($x.card // "-"), (($b[0].cards[] | select(.id == $x.card) | .state) // "-"), ($x.agentType // "?"), $x.agentId,
      ($x.sessionId[0:8]), ($x.last_at[0:19] | sub("T"; " ")), (if $x.apiError then "API ERROR: " + $x.apiError[0:60] else "ok" end)] | @tsv)' <<<"$a" | table
}

# dl abort "<why>" — the human stops the active job (/deliver:abort): phase aborted, the seats sent home, card worktrees and
# ACTIVE cleared (branches kept), so a new job can start at once. With Michael live on the floor he is told instead and
# releases the seats himself — from outside the app nobody else touches his inbox's job.
cmd_abort() {
  human_only "aborting the job (dl abort)"
  local why=${1:-}; [[ -n $why ]] || die 'usage: dl abort "<why the job stops>"'
  DL_NO_SEAL_CHECK=1 load_job
  local cur; cur="$(phase_now)"
  if [[ $cur != done && $cur != aborted ]]; then jq_inplace "$JOBJ" '.phase="aborted"'; log_event phase aborted; fi
  suite_stop all
  log_event abort "${DELIVER_APPROVER:-${USER:-human}}: $why"
  if [[ "$(setting dispatch)" == munder && -n "$(jq -r '.munder.seats // {} | keys[]' "$JOBJ" 2>/dev/null)" ]]; then
    if ! ( cmd_md_release ) 2>/dev/null; then
      local h; h="$(setting munder.hive_root)"; [[ -d $h/hive ]] && h="$h/hive"
      if [[ -d $h/agents ]]; then
        local inbox="$h/agents/$(md_god "$h")/inbox" id; mkdir -p "$inbox"; id="$(date -u +%Y%m%dT%H%M%S)-deliver-abort-$RANDOM"
        jq -n --arg id "$id" --arg body "The human aborted job $JOB: $why
Stop working on it and send its seats home: dl -C $ROOT md-release" --arg t "$(date -u +%FT%T.000Z)" \
          '{id:$id, conversation:("deliver-" + $id), from:"human", to:"god", act:"inform", subject:"job aborted", body:$body, hops:0, requires_reply:false, needs_human:false, created_at:$t}' \
          > "$inbox/.$id.tmp" && mv "$inbox/.$id.tmp" "$inbox/$id.json"
        echo "Michael is on the floor: he was told to stop and send the seats home (his inbox: $id)"
      fi
    fi
  fi
  cmd_cleanup --all
  rm -f "$WORK/FLOOR-PENDING"
  echo "job $JOB aborted ($why) — its branches are kept; start a new one with /deliver:new <request>"
}

# dl dispatch munder|subagent "<why>" — the human switches how this job's roles run. Never Michael's call (bash-guard).
cmd_dispatch() {
  human_only "dl dispatch"; load_job
  local to=${1:-} why=${2:-}
  [[ ($to == munder || $to == subagent) && -n $why ]] || die 'usage: dl dispatch munder|subagent "<why>"'
  [[ "$(setting dispatch)" == "$to" ]] && { echo "already $to"; return 0; }
  [[ $to == subagent && -n "$(jq -r '[.munder.seats // {} | .[] | select(.worker != null and .task != null)] | first // empty' "$JOBJ")" ]] \
    && refuse 1 "a seat still holds a task (dl md-seats) — let it report, or dl md-reseat it, before leaving the floor"
  jq_inplace "$JOBJ" --arg d "$to" '.settings.dispatch = $d'
  log_event dispatch "${DELIVER_APPROVER:-${USER:-human}}: $to — $why"
  echo "this job now runs with dispatch $to$([[ $to == subagent ]] && echo " (Claude Code subagents; release the floor's seats with dl md-release from the app's Michael)")"
}

main() {
  local c=${1:-help}; shift || true
  floor_guard "$c" "$@"
  case $c in
    dispatch) cmd_dispatch "$@" ;;
    floor-open) cmd_floor_open "$@" ;;
    config) cmd_config "$@" ;;
    new) cmd_new "$@" ;;
    status) cmd_status ;;
    next) cmd_next ;;
    board) cmd_board ;;
    phase) cmd_phase "$@" ;;
    jobset) cmd_jobset "$@" ;;
    validate) cmd_validate ;;
    roles) cmd_roles ;;
    readiness) cmd_readiness ;;
    clarify) cmd_clarify "$@" ;;
    decide) cmd_decide "$@" ;;
    pm-decide) cmd_pm_decide "$@" ;;
    reopen) cmd_reopen "$@" ;;
    unfreeze) cmd_unfreeze "$@" ;;
    reseal) cmd_reseal "$@" ;;
    learn) cmd_learn "$@" ;;
    followup) cmd_followup "$@" ;;
    timeline) cmd_timeline "$@" ;;
    knowledge) cmd_knowledge "$@" ;;
    ready) cmd_ready ;;
    wt) cmd_wt "$@" ;;
    card) cmd_card "$@" ;;
    gate) cmd_gate "$@" ;;
    qa) cmd_qa "$@" ;;
    qa-join) cmd_qa_join "$@" ;;
    review) cmd_review "$@" ;;
    integrate) cmd_integrate "$@" ;;
    verify-all) cmd_verify_all ;;
    baseline) cmd_baseline ;;
    suite) cmd_suite "$@" ;;
    ship) cmd_ship ;;
    pr) cmd_pr ;;
    approve) cmd_approve "$@" ;;
    reject) cmd_reject "$@" ;;
    md-dispatch) cmd_md_dispatch "$@" ;;
    md-hire) cmd_md_hire "$@" ;;
    md-reseat) cmd_md_reseat "$@" ;;
    md-seats) cmd_md_seats ;;
    md-send) cmd_md_send "$@" ;;
    md-done) cmd_md_done "$@" ;;
    md-release) cmd_md_release ;;
    md-inbox) cmd_md_inbox ;;
    md-wait) cmd_md_wait "$@" ;;
    abort) cmd_abort "$@" ;;
    playbook) echo "$(cd "$BIN_DIR/.." && pwd)/SKILL.md" ;;
    agents) cmd_agents "$@" ;;
    version) jq -r '"deliver \(.version)"' "$BIN_DIR/../../../.claude-plugin/plugin.json" 2>/dev/null || echo "deliver (version unknown)"; echo "runs from: $(cd "$BIN_DIR/.." && pwd)" ;;
    cleanup) cmd_cleanup "$@" ;;
    jobs) cmd_jobs ;;
    kanban) cmd_kanban "$@" ;;
    seats) cmd_seats ;;
    tracker) cmd_tracker "$@" ;;
    help|-h|--help) awk 'NR>1 && !/^#/ {exit} NR>1' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $c (dl help)" ;;
  esac
}
main "$@"
