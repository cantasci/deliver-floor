#!/usr/bin/env bash
# dl — the deterministic half of the /deliver flow.
# The board, phase transitions, worktrees, gates, reviews and merges are run by this script, not by the LLM.
# Michael (the orchestrator) calls these commands through Bash; you can call them from a terminal too.
# Every transition is checked here: a model cannot skip a gate, merge an unreviewed card or exceed the limits.
#
#   dl [-C <repo>] <command> …     -C (or DELIVER_REPO) = run against that repo from any directory
#
#   dl new "<title>" "<request>"   new job: .work/<JOB>/, job/<JOB> branch, integration worktree
#   dl status                      active job's phase + board table + next actions
#   dl next                        the next actions the flow requires, one per line (ACTION args)
#   dl board                       board table only
#   dl phase <phase>               set phase (intake readiness awaiting_clarification planning awaiting_plan_approval executing
#                                  integrating closing awaiting_pr_merge done aborted) — guarded
#   dl jobset '<jq expr>'          update job.json            e.g. dl jobset '.stack=["typescript","react"]'
#   dl readiness                   check the requirements readiness review (readiness.json → readiness.md, QUESTIONS.md)
#   dl clarify <id> "<answer>"     record the human's answer to an open business question (human only)
#   dl decide <id> "<decision>" "<rationale>"   the PM closes an open implementation-detail item (owner pm)
#   dl unfreeze "<reason>"         (human, terminal only) reopen the decisions frozen at planning
#   dl reseal "<reason>"           (human, terminal only) accept an edit made to job.json/board.json outside dl
#   dl roles                       check job.roles against roles.yaml and generate the project's role cards
#                                  (.work/<job>/roles/*.md, ROLES.md; Munder Difflin hire manifests) — runs on dl phase planning
#   dl learn <role|all> "<lesson>" remember a lesson for this repo (memory: ~/.deliver/knowledge/lessons/<repo>.md);
#                                  the next jobs' role cards include it
#   dl knowledge [list|sync-md]    standards + lessons that feed the role cards; sync-md → Munder Difflin knowledge graph
#   dl validate                    board.json schema + dependency + scope-overlap check
#   dl ready                       ids of cards that may be dispatched now (deps merged, attempts left)
#   dl wt add <card> [--resume]    card worktree + state=running + attempts+1 (--resume: no bump, after a restart)
#   dl wt rm <card>                remove the card worktree (branch is kept)
#   dl card <card> state <state>   review | blocked | ready (from blocked) | archived
#   dl card <card> note "<text>"   attach a note to a card (blocked reason, guidance, …)
#   dl card <card> retry           human-granted: attempts=0 and state=ready (after guidance)
#   dl card <card> set <field> <value> "<reason>"   change a ready/blocked card's contract (validated, logged, history)
#   dl card add <card.json> "<reason>"              add a card (e.g. a fix card) — gets the next id, validated, logged
#   dl gate <card>                 mechanical gate: right branch, clean tree, commits, in scope, verify passes
#   dl qa <card> pass|fail "<summary>"   record the QA/Test verdict on the card's acceptance criteria
#                                  (needs a passed gate on the current commit)
#   dl review <card> approve|changes "<summary>" [--by <role>]   record a reviewer's verdict (needs gate PASS + QA pass);
#                                  a card with "reviewers": [...] needs every one of them to approve the same commit
#   dl integrate <card>            --no-ff merge into the job branch → merged (needs gate PASS + QA pass +
#                                  review approve, all on the current commit; exit 3 on conflict)
#   dl verify-all                  run verify_full in the integration worktree
#   dl ship                        deliver per merge_mode: human|semi|auto → push + PR (+ auto-merge / merge on green),
#                                  local → merge into the base branch. Needs verify-all PASS + report.md (phase closing)
#   dl pr                          PR state (awaiting_pr_merge): merged → done; closed → aborted; open → checks/review
#   dl approve plan [note]         record the human's plan approval (only when gates.plan is on; off by default)
#   dl reject  plan "<note>"       record the human's rejection of the plan
#   dl md-dispatch <card> <prompt-file>   Munder Difflin: run the card's dev as a worker on the floor
#   dl cleanup [--all]             remove card worktrees, clear ACTIVE (--all: integration worktree too)
#   dl jobs                        jobs known on this machine (registry)
#   dl seats                       role seats: busy / IDLE, and the card each idle seat should take
#   dl kanban [--html <file>]      the board as kanban columns (To Do · In Progress · QA · Code Review · Done)
#   dl tracker [open|sync]         mirror the cards into settings.tracker.kind (local | jira) — automatic on every step
#
# Env: DELIVER_JOB=<id> targets that job instead of .work/ACTIVE · DELIVER_HOME (default ~/.deliver) holds the
#      job registry the hooks use · HIVE_ROOT is set by Munder Difflin (md-dispatch).
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$BIN_DIR/.." && pwd)"
CONFIG="$SKILL_DIR/config.json"
REG="${DELIVER_HOME:-$HOME/.deliver}/jobs"

die() { echo "dl: $*" >&2; exit 1; }
refuse() { local code=$1; shift; echo "dl: REFUSED — $*" >&2; exit "$code"; }
# Human decisions are never taken inside an unattended session (run-headless.sh sets DELIVER_HEADLESS=1 for claude -p).
# The bash-guard hook stops them too; this check holds whatever name the command is called by.
human_only() { [[ ${DELIVER_HEADLESS:-} == 1 ]] && refuse 8 "$1 is the human's decision and this session is unattended (DELIVER_HEADLESS=1). Write it down (QUESTIONS.md / APPROVAL.md) and stop; the human runs it in a terminal."; return 0; }
command -v jq >/dev/null || die "jq is required (brew install jq / apt install jq)"
command -v git >/dev/null || die "git is required"

if [[ ${1:-} == -C ]]; then DELIVER_REPO="${2:?dl -C <repo>}"; shift 2; fi

resolve_root() {
  local from=${DELIVER_REPO:-}
  if [[ -z $from && -n ${DELIVER_JOB:-} && -f $REG/$DELIVER_JOB ]]; then from="$(cat "$REG/$DELIVER_JOB")"; fi
  common_dir="$(git -C "${from:-.}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "not inside a git repository (use: dl -C <repo> …)"
  ROOT="$(cd "$common_dir/.." && pwd)"   # the main checkout, even when called from inside a worktree
  WORK="$ROOT/.work"
}

STATES="ready running review merged blocked archived"
PHASES="intake readiness awaiting_clarification planning awaiting_plan_approval executing integrating closing awaiting_pr_merge done aborted"
MERGE_MODES="human semi auto local"
MD_PROVIDERS="claude codex gemini grok kimi qwen opencode crush pi copilot cursor antigravity"
GH="${DELIVER_GH:-gh}"
now() { date -u +%FT%TZ; }

# Parallel dl calls (Michael gating two cards at once, two floor workers finishing together) must not lose
# updates: every read-modify-write of a job file and every git ref/worktree change runs under a lock.
with_lock() { # with_lock <name> <command…>
  local d="${WORK:-/tmp}/.lock-$1" n=0 rc=0
  mkdir -p "$(dirname "$d")"
  until mkdir "$d" 2>/dev/null; do
    if [[ -n "$(find "$d" -maxdepth 0 -mmin +2 2>/dev/null)" ]]; then rmdir "$d" 2>/dev/null; continue; fi  # stale (>2 min)
    sleep 0.1; n=$((n+1)); (( n < 1200 )) || die "lock $1 busy for 2 minutes ($d)"
  done
  "${@:2}" || rc=$?
  rmdir "$d" 2>/dev/null; return $rc
}
_jq_inplace() {
  local f=$1; shift
  local tmp; tmp="$(mktemp "$f.XXXXXX")"
  if jq "$@" "$f" > "$tmp"; then mv "$tmp" "$f"; else rm -f "$tmp"; die "jq update failed on $f"; fi
  seal "$f"
}
# Tamper evidence: dl seals job.json (always) and board.json (once work has started) with a sha256 after every write;
# every dl command checks the seals, so an edit made outside dl — by any tool — stops the flow until a human reseals.
seal() { [[ $1 == */job.json || $1 == */board.json ]] && node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync(process.argv[1])).digest("hex"))' "$1" > "$(dirname "$1")/.seal-$(basename "$1")"; return 0; }
seal_ok() { local f=$1 sf; sf="$(dirname "$f")/.seal-$(basename "$f")"; [[ ! -f $sf ]] || [[ "$(cat "$sf")" == "$(node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync(process.argv[1])).digest("hex"))' "$f")" ]]; }
check_seals() {
  seal_ok "$JOBJ" || refuse 7 "job.json was modified outside dl. Flow state changes only through dl; a human inspects the change and runs: dl reseal \"<reason>\""
  case "$(jq -r .phase "$JOBJ")" in intake|readiness|awaiting_clarification|planning|awaiting_plan_approval) return 0 ;; esac
  seal_ok "$BOARD" || refuse 7 "board.json was modified outside dl (use dl card set / dl card add). A human inspects the change and runs: dl reseal \"<reason>\""
}
jq_inplace() { with_lock "$(basename "$1")" _jq_inplace "$@"; }   # jq_inplace <file> <jq args...>
git_locked() { with_lock git git "$@"; }

load_job() {
  resolve_root
  JOB="${DELIVER_JOB:-}"
  if [[ -z $JOB ]]; then
    [[ -f "$WORK/ACTIVE" ]] || die "no active job — start one with: dl new \"<title>\" \"<request>\""
    JOB="$(cat "$WORK/ACTIVE")"
  fi
  JOB_DIR="$WORK/$JOB"
  JOBJ="$JOB_DIR/job.json"
  BOARD="$JOB_DIR/board.json"
  [[ -f $JOBJ ]] || die "job not found: $JOB"
  JOB_BRANCH="$(jq -r .branch "$JOBJ")"
  IWT="$(jq -r .integration_worktree "$JOBJ")"
  [[ ${DL_NO_SEAL_CHECK:-} == 1 ]] || check_seals
}

setting() { jq -r ".settings.$1 // empty" "$JOBJ"; }
phase_now() { jq -r .phase "$JOBJ"; }

card_exists() { jq -e --arg id "$1" '.cards[] | select(.id==$id)' "$BOARD" >/dev/null || die "no such card: $1"; }
card_get() { jq -r --arg id "$1" ".cards[] | select(.id==\$id) | $2" "$BOARD"; }
card_set() { local id=$1; shift; jq_inplace "$BOARD" --arg id "$id" "$@"; }
branch_head() { git -C "$ROOT" rev-parse --verify -q "refs/heads/$1" 2>/dev/null || true; }
# files changed between two commits that fall OUTSIDE the given globs (empty = all inside)
outside() { git -C "$ROOT" diff --no-renames --name-only "$1" "$2" | node "$BIN_DIR/scope.mjs" "$3"; }
blob_at() { git -C "$1" rev-parse -q --verify "$2:$3" 2>/dev/null || echo none; }   # blob_at <dir> <rev> <path>
# qa_files <dir> <rev> <globs> → files of <rev> inside the globs
qa_files() { comm -23 <(git -C "$1" ls-tree -r --name-only "$2" | sort) <(git -C "$1" ls-tree -r --name-only "$2" | node "$BIN_DIR/scope.mjs" "$3" | sort); }
# the card's gate still holds on <head>: it passed on <head>, or only QA test files changed since
gate_holds() { # gate_holds <card> <head>
  local g; g="$(card_get "$1" .gate.head)"
  [[ "$(card_get "$1" .gate.result)" == PASS ]] || return 1
  [[ $g == "$2" ]] && return 0
  git -C "$ROOT" merge-base --is-ancestor "$g" "$2" 2>/dev/null && [[ -z "$(outside "$g" "$2" "$(card_get "$1" '.qa_scope // []')")" ]]
}

log_event() { printf '%s\t%s\t%s\n' "$(now)" "$1" "$2" >> "$JOB_DIR/events.log"; }
reset_stop_guard() { rm -f "$JOB_DIR/.stop-blocks"; }

# Mirror a change into the tracker (local kanban / Jira / …). board.json stays the source of truth, so a tracker
# outage never blocks the flow: the error is logged and shown by dl status, and the next sync catches up.
tracker() { # tracker sync [card] [--event text] | note <card> <author> <text> | open
  [[ -f $BOARD ]] || return 0
  local out rc=0; out="$(with_lock board.json node "$BIN_DIR/tracker-cli.mjs" "$1" "$JOB_DIR" "${@:2}" 2>&1)" || rc=$?
  seal "$BOARD"; seal "$JOBJ"; [[ $rc -eq 0 ]] && return 0
  printf '%s\t%s\t%s\n' "$(now)" tracker-error "$out" >> "$JOB_DIR/events.log"
  echo "dl: warning — tracker: $out" >&2; return 0
}

run_setup() { # per-worktree setup command (node_modules, etc.)
  local dir=$1 cmd; cmd="$(setting worktree_setup)"
  [[ -n $cmd ]] || return 0
  (cd "$dir" && ROOT="$ROOT" bash -c "$cmd") >> "$JOB_DIR/setup.log" 2>&1 \
    || echo "dl: warning — worktree_setup failed in $dir, see $JOB_DIR/setup.log" >&2
}

table() { # tab-separated stdin → aligned columns (no dependency on `column`)
  awk -F'\t' '{ for (i=1;i<=NF;i++) { c[NR,i]=$i; if (length($i)>w[i]) w[i]=length($i) } if (NF>n) n=NF; r=NR }
    END { for (j=1;j<=r;j++) { line=""; for (i=1;i<=n;i++) line=line sprintf(i<n?"%-" w[i]+2 "s":"%s", c[j,i]); print line } }'
}

# ---------------------------------------------------------------------------------------------------------------

# Card branches are pushed by dl (never by agents) when settings.push_branches allows it: "auto" = when there is an
# origin and merge_mode is not local. That makes every branch visible on the Git host and in the tracker.
push_card() {
  local card=$1 mode; mode="$(setting push_branches)"; mode=${mode:-auto}
  [[ $mode == false ]] && return 0
  git -C "$ROOT" remote get-url origin >/dev/null 2>&1 || return 0
  [[ $mode == auto && "$(setting merge_mode)" == local ]] && return 0
  local br; br="$(card_get "$card" .branch)"
  if git_locked -C "$ROOT" push -q -u origin "$br" >/dev/null 2>&1; then
    local url; url="$(git -C "$ROOT" config --get remote.origin.url | sed -E 's#^git@github.com:#https://github.com/#; s#\.git$##')"
    [[ $url == https://github.com/* ]] && card_set "$card" '(.cards[] | select(.id==$id)).branch_url = $u' --arg u "$url/tree/$br"
    log_event push "$br"
  else
    log_event push-error "$br (push failed — the branch stays local)"
  fi
}

cmd_new() {
  resolve_root
  local title=${1:-} request=${2:-${1:-}}
  [[ -n $title ]] || die 'usage: dl new "<title>" "<request>"'
  command -v node >/dev/null || die "node is required"
  if [[ -f "$WORK/ACTIVE" ]]; then
    local cur; cur="$(cat "$WORK/ACTIVE")"
    [[ -f "$WORK/$cur/job.json" ]] && refuse 1 "job $cur is still active (phase $(jq -r .phase "$WORK/$cur/job.json")). Finish it, or: dl phase aborted && dl cleanup --all"
  fi
  local slug id base
  slug="$(node -e 'const s=process.argv[1].replace(/ı/g,"i").replace(/İ/g,"i").normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"").slice(0,32).replace(/-$/,"");console.log(s||"job")' "$title")"
  id="JOB-$(date +%Y%m%d-%H%M)-$slug"
  [[ ! -e "$WORK/$id" ]] || die "already exists: $id"

  # Settings: skill config.json, overridden by .deliver.json at the repo root if present.
  local settings
  if [[ -f "$ROOT/.deliver.json" ]]; then
    settings="$(jq -s '.[0] * .[1]' "$CONFIG" "$ROOT/.deliver.json")" || die ".deliver.json is not valid JSON"
  else
    settings="$(cat "$CONFIG")"
  fi
  # Older .deliver.json files said merge_strategy: pr|local.
  settings="$(jq 'if .merge_strategy then .merge_mode = (if .merge_strategy == "local" then "local" else (.merge_mode // "human") end) | del(.merge_strategy) else . end' <<<"$settings")"
  local mm; mm="$(jq -r .merge_mode <<<"$settings")"
  [[ " $MERGE_MODES " == *" $mm "* ]] || die "merge_mode must be one of: $MERGE_MODES (got '$mm')"
  local tk; tk="$(jq -r '.tracker.kind // "local"' <<<"$settings")"
  node --input-type=module -e "import {trackerKinds, loadTrackers} from '$BIN_DIR/tracker.mjs'; await loadTrackers(); process.exit(trackerKinds().includes('$tk') ? 0 : 1)" \
    || die "tracker.kind '$tk' is not a known tracker ($(node --input-type=module -e "import {trackerKinds, loadTrackers} from '$BIN_DIR/tracker.mjs'; await loadTrackers(); console.log(trackerKinds().join(', '))"))"
  base="$(jq -r .base_branch <<<"$settings")"
  if [[ $base == auto || $base == null ]]; then
    base="$(git -C "$ROOT" symbolic-ref --short HEAD 2>/dev/null)" || die "could not resolve base branch (detached HEAD?) — set base_branch in .deliver.json"
  fi
  git -C "$ROOT" rev-parse --verify -q "$base^{commit}" >/dev/null || die "base branch '$base' has no commits"

  mkdir -p "$WORK/$id/handoffs" "$WORK/$id/gates" "$WORK/$id/wt" "$WORK/$id/prompts" "$WORK/$id/specs"
  # Keep .work/ and per-worktree setup artifacts out of git (local exclude, shared by all worktrees;
  # .gitignore is not touched). A `node_modules/` rule does not match a node_modules SYMLINK, hence no slash.
  local excl="$common_dir/info/exclude" p; mkdir -p "$(dirname "$excl")"
  while IFS= read -r p; do
    [[ -n $p ]] && { grep -qxF "$p" "$excl" 2>/dev/null || echo "$p" >> "$excl"; }
  done < <(printf '.work/\n'; jq -r '.worktree_exclude // [] | .[]' <<<"$settings")

  local branch="job/$id" iwt="$WORK/$id/wt/_integration"
  git -C "$ROOT" branch "$branch" "$base"
  git -C "$ROOT" worktree add -q "$iwt" "$branch"

  cp "$SKILL_DIR/templates/plan.md" "$SKILL_DIR/templates/report.md" "$WORK/$id/"
  cp "$SKILL_DIR/templates/board.json" "$WORK/$id/board.json"
  jq --arg id "$id" --arg title "$title" --arg req "$request" --arg base "$base" \
     --arg branch "$branch" --arg iwt "$iwt" --arg now "$(now)" --arg root "$ROOT" \
     --argjson settings "$settings" \
     '.id=$id | .title=$title | .request=$req | .created=$now | .repo=$root | .base_branch=$base
      | .branch=$branch | .integration_worktree=$iwt | .settings=$settings' \
     "$SKILL_DIR/templates/job.json" > "$WORK/$id/job.json"
  seal "$WORK/$id/job.json"
  echo "$id" > "$WORK/ACTIVE"
  mkdir -p "$REG" && echo "$ROOT" > "$REG/$id"
  JOB=$id; JOB_DIR="$WORK/$id"; JOBJ="$JOB_DIR/job.json"
  run_setup "$iwt"
  log_event new "$title"
  echo "$id"
}

cmd_board() {
  load_job
  jq -r '(["ID","STATE","ROLE","AGENT","TRIES","DEPENDS","TITLE"] | @tsv),
         (.cards[] | [.id, .state, .role, .agent, (.attempts|tostring),
                      ((.depends_on // []) | if length==0 then "-" else join(",") end), .title] | @tsv)' \
     "$BOARD" | table
  echo
  jq -r '[.cards[].state] | group_by(.) | map("\(.[0])=\(length)") | join("  ") | "summary: " + (if .=="" then "no cards" else . end)' "$BOARD"
}

cmd_status() {
  load_job
  jq -r '"job:      \(.id)\ntitle:    \(.title)\nrepo:     \(.repo // "-")\nphase:    \(.phase)\nbranch:   \(.branch)  (base: \(.base_branch))\nplan gate: \(if .settings.gates.plan then (.gates.plan.status // "pending") else "off" end)\nmerge:    \(.settings.merge_mode)\(if .pr.url then "  PR: \(.pr.url) (\(.pr.state // "?"))" else "" end)\ndispatch: \(.settings.dispatch // "subagent")"' "$JOBJ"
  echo
  cmd_board
  local te; te="$(grep -c $'\ttracker-error\t' "$JOB_DIR/events.log" 2>/dev/null || true)"
  [[ ${te:-0} -gt 0 ]] && echo "tracker: $te sync error(s) — last: $(grep $'\ttracker-error\t' "$JOB_DIR/events.log" | tail -1 | cut -f3 | cut -c1-160) (dl tracker sync retries)"
  echo
  echo "next:"; cmd_next | sed 's/^/  /'
}

# Cards that may be dispatched now: ready, every dependency merged, attempts left.
ready_ids() {
  jq -r --argjson max "$(setting max_attempts)" '. as $b | .cards[] | select(.state=="ready")
    | select(.attempts < $max)
    | select(all((.depends_on // [])[]; . as $d
        | ([$b.cards[] | select(.id==$d) | .state] | first // "missing") == "merged"))
    | .id' "$BOARD"
}
cmd_ready() { load_job; ready_ids; }

# The deterministic "what now" for Michael, one action per line.
cmd_next() {
  load_job
  local phase gates_plan; phase="$(phase_now)"
  gates_plan="$(jq -r '.settings.gates.plan' "$JOBJ")"
  case $phase in
    intake)   echo "INTAKE  detect stack, pick roles from roles.yaml (dl jobset '.roles=[…]'), then: dl phase readiness (generates the role cards)" ;;
    readiness|awaiting_clarification)
      local rc=0; node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || rc=$?
      jq -r '(.items // .)[] | select(.status=="open" and .owner=="pm") | "DECIDE  (PM) \(.id) — \(.question)  (record: dl decide \(.id) \"<decision>\" \"<rationale>\")"' "$JOB_DIR/readiness.json" 2>/dev/null
      if [[ ! -f $JOB_DIR/readiness.json ]]; then echo "READINESS BA reviews every requirement against readiness.yaml → .work/$JOB/readiness.json, then: dl readiness"
      elif [[ $rc -eq 1 ]]; then echo "FIX     readiness.json is incomplete — dl readiness lists what is missing"
      elif [[ $rc -eq 3 ]]; then
        [[ $phase == readiness ]] && echo "PHASE   dl phase awaiting_clarification"
        jq -r '(.items // .)[] | select(.status=="open" and .owner!="pm") | "ASK     human: \(.id) — \(.question)  (record: dl clarify \(.id) \"<answer>\")"' "$JOB_DIR/readiness.json"
      elif [[ $rc -eq 4 ]]; then :   # only PM decisions left (listed above)
      else echo "PHASE   dl phase planning  (readiness complete: $(jq '(.items // .) | length' "$JOB_DIR/readiness.json") items decided or n/a; planning freezes them)"; fi ;;
    planning)
      local nxt="dl phase executing  (no plan gate: the human is next at the PR)"; [[ $gates_plan == true ]] && nxt="dl phase awaiting_plan_approval"
      echo "PLAN    BA plan → plan.md · Lead cards → board.json · BA card specs → specs/T-xx.md · dl validate, then: $nxt" ;;
    awaiting_plan_approval)
      case "$(jq -r '.gates.plan.status // "pending"' "$JOBJ")" in
        approved) echo "PHASE   dl phase executing" ;;
        rejected) echo "REVISE  plan/board per the human's note: $(jq -r .gates.plan.note "$JOBJ") — then dl phase awaiting_plan_approval" ;;
        *) [[ $gates_plan == false ]] && echo "PHASE   dl phase executing  (plan gate disabled)" || echo "ASK     human: plan approval (dl approve plan | dl reject plan \"<note>\")" ;;
      esac ;;
    executing)
      local max_par running cap
      max_par="$(setting max_parallel)"
      running="$(jq '[.cards[] | select(.state=="running")] | length' "$BOARD")"
      local maxa; maxa="$(setting max_attempts)"
      jq -r '.cards[] | select(.state=="review") | [.id, (.branch//""), (.gate.result//""), (.gate.head//""), (.qa.verdict//""), (.qa.head//""), (.review.verdict//""), (.review.head//""), (.attempts|tostring)] | @tsv' "$BOARD" |
        while IFS=$'\t' read -r id br gres ghead qv qhead rv rhead att; do
          local head; head="$(branch_head "$br")"
          local failed=""
          if [[ $gres == FAIL && $ghead == "$head" ]]; then failed="gate failed — feedback: $(card_get "$id" .gate.log)"
          elif [[ $qv == fail && $qhead == "$head" ]]; then failed="QA failed — its tests are committed; feedback: $(card_get "$id" .qa.summary)"
          elif [[ $qv == pass && $qhead == "$head" && $rv == changes && $rhead == "$head" ]]; then failed="review asked for changes — feedback: $(card_get "$id" .review.summary)"
          fi
          if [[ -n $failed ]]; then
            if (( att >= maxa )); then echo "BLOCK   $id (failed on its last attempt $att/$maxa: dl card $id state blocked + note)"
            else echo "REDISPATCH $id  ($failed)"; fi
          elif ! gate_holds "$id" "$head"; then echo "GATE    dl gate $id"
          elif [[ $qv != pass || $qhead != "$head" ]]; then echo "QA      $id  (QA/Test role writes + runs the integration/e2e tests for the ACs → dl qa $id pass|fail)"
          elif [[ $rv != approve || $rhead != "$head" ]]; then
            local pend; pend="$(card_get "$id" '(if .review.head == "'"$head"'" then .review.pending else (.reviewers // ["reviewer"]) end) // [] | join(", ")')"
            echo "REVIEW  $id  (reviewers: ${pend:-reviewer} → dl review $id approve|changes \"<summary>\" --by <role>)"
          else echo "INTEGRATE dl integrate $id"; fi
        done
      cap=$(( max_par - running ))
      # awk reads its whole input: `head` would close the pipe early and, under pipefail, kill dl with SIGPIPE
      local r; r="$(ready_ids | awk -v n=$(( cap > 0 ? cap : 0 )) 'NR<=n' | tr '\n' ' ')"
      [[ -n ${r// /} ]] && echo "DISPATCH ${r% }"
      # every idle seat says so — with the work it should take, or what it waits for
      seats_json | jq -r --arg disp " ${r% } " '.[] | select(.busy == null) |
        if (.ready|length)>0 then .ready[0] as $c | "IDLE    \(.seat) — free; take \($c)" + (if ($disp|contains(" " + $c + " ")) then " (in DISPATCH above)" else " (dl seats)" end)
        elif (.waiting|length)>0 then "IDLE    \(.seat) — waiting: \(.waiting|join(", ")) depend on unmerged cards"
        else "IDLE    \(.seat) — no more work for \(.role)" end' 
      jq -r '.cards[] | select(.state=="running") | "WAIT    \(.id) (agent running)"' "$BOARD"
      jq -r --argjson max "$(setting max_attempts)" '.cards[] | select(.state=="ready" and .attempts >= $max) | "BLOCK   \(.id) (no attempts left: dl card \(.id) state blocked)"' "$BOARD"
      local open; open="$(jq '[.cards[] | select(.state | IN("ready","running","review"))] | length' "$BOARD")"
      local busy=0; { [[ -n ${r// /} || $running -gt 0 ]] || jq -e '.cards[] | select(.state=="review")' "$BOARD" >/dev/null; } && busy=1
      if [[ $open -eq 0 ]] && ! jq -e '.cards[] | select(.state=="blocked")' "$BOARD" >/dev/null; then
        echo "PHASE   dl phase integrating"
      elif [[ $busy -eq 0 ]]; then
        # Nothing can move on its own: the human decides about every blocked card.
        jq -r '.cards[] | select(.state=="blocked") | "ASK     human about blocked \(.id): \((.notes[-1].note) // "no note") (guidance → dl card \(.id) retry | archive → dl card \(.id) state archived)"' "$BOARD"
        jq -r '.cards[] | select(.state=="ready") | "STUCK   \(.id) waits on unmerged dependencies: \(.depends_on|join(","))"' "$BOARD"
        [[ $open -eq 0 ]] && echo "PHASE   dl phase integrating  (once the blocked cards are retried or archived)"
        true
      fi ;;
    integrating)
      local h; h="$(branch_head "$JOB_BRANCH")"
      if [[ "$(jq -r '.verify_all.result // ""' "$JOBJ")" != PASS || "$(jq -r '.verify_all.head // ""' "$JOBJ")" != "$h" ]]; then
        echo "VERIFY  dl verify-all"
      else
        echo "QA      job-level QA roles if selected (failure → fix card + dl phase executing), then: dl phase closing"
      fi ;;
    closing)
      if cmp -s "$JOB_DIR/report.md" "$SKILL_DIR/templates/report.md"; then echo "REPORT  BA closing check (every AC with evidence) → report.md"
      else echo "SHIP    dl ship  (merge_mode=$(setting merge_mode))"; fi ;;
    awaiting_pr_merge)
      echo "WAIT    PR $(jq -r '.pr.url // "?"' "$JOBJ") is with the human (merge_mode=$(setting merge_mode)). Check: dl pr — then dl cleanup when done"
      echo "STOP    hand over: tell the human the PR link; resume later with /deliver resume" ;;
    done|aborted) echo "NONE    job is $phase" ;;
  esac
}

cmd_phase() {
  load_job
  [[ ${1:-} == aborted || ${1:-} == readiness ]] || assert_frozen
  local p=${1:-} force=0; [[ ${2:-} == --force ]] && { human_only "dl phase --force"; force=1; }
  [[ " $PHASES " == *" $p "* ]] || die "invalid phase: '$p' — valid: $PHASES"
  local cur; cur="$(phase_now)"
  if [[ $force -eq 0 ]]; then
    [[ $cur == done || $cur == aborted ]] && refuse 1 "job is $cur"
    case $p in
      readiness)
        [[ $cur == intake || $cur == awaiting_clarification || $cur == readiness ]] || refuse 1 "readiness comes after intake (now: $cur)"
        node "$BIN_DIR/roles.mjs" check "$JOBJ" >&2 || refuse 1 "the selected roles are not valid — fix job.roles (dl jobset), see roles.yaml" ;;
      awaiting_clarification)
        local rc=0; node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || rc=$?
        [[ $rc -eq 3 ]] || refuse 1 "there are no open questions for the human (dl readiness)" ;;
      planning)
        node "$BIN_DIR/roles.mjs" check "$JOBJ" >&2 || refuse 1 "the selected roles are not valid — fix job.roles (dl jobset), see roles.yaml"
        local rr=0; node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >&2 || rr=$?
        [[ $rr -eq 0 ]] || refuse 1 "the requirements are not ready: $(case $rr in 3) echo "open questions for the human remain (QUESTIONS.md) — ask, record with dl clarify" ;; 4) echo "implementation details are open — decide them as PM: dl decide <id> \"<decision>\" \"<rationale>\"" ;; *) echo "readiness.json is incomplete (dl readiness)" ;; esac)" ;;
      awaiting_plan_approval)
        node "$BIN_DIR/roles.mjs" check "$JOBJ" >/dev/null || refuse 1 "the selected roles are not valid — dl roles"
        node "$BIN_DIR/validate.mjs" "$BOARD" >/dev/null || refuse 1 "board is not valid — run: dl validate" ;;
      executing)
        if [[ "$(jq -r .settings.gates.plan "$JOBJ")" != false && "$(jq -r '.gates.plan.status // ""' "$JOBJ")" != approved ]]; then
          refuse 1 "the plan is not approved by the human (gates.plan). Ask them; record with dl approve plan"
        fi
        node "$BIN_DIR/validate.mjs" "$BOARD" >/dev/null || refuse 1 "board is not valid — run: dl validate" ;;
      integrating)
        jq -e '[.cards[] | select(.state | IN("ready","running","review","blocked"))] | length == 0' "$BOARD" >/dev/null \
          || refuse 1 "cards are not finished: $(jq -r '[.cards[] | select(.state | IN("ready","running","review","blocked")) | "\(.id)=\(.state)"] | join(" ")' "$BOARD") — blocked cards need the human (retry or archive)" ;;
      closing)
        [[ $cur == integrating ]] || refuse 1 "only from integrating (now: $cur)"
        [[ "$(jq -r '.verify_all.result // ""' "$JOBJ")" == PASS && "$(jq -r '.verify_all.head // ""' "$JOBJ")" == "$(branch_head "$JOB_BRANCH")" ]] \
          || refuse 1 "verify-all has not passed on the current job branch — run: dl verify-all" ;;
      awaiting_pr_merge) refuse 1 "awaiting_pr_merge is set by: dl ship" ;;
      done) [[ "$(jq -r '.shipped // false' "$JOBJ")" == true ]] || refuse 1 "the job is not delivered yet — dl ship (and, for a PR, its merge: dl pr)" ;;
    esac
  fi
  case $p in # entering a waiting phase asks the question afresh
    awaiting_plan_approval) jq_inplace "$JOBJ" '.gates.plan = null' ;;
  esac
  jq_inplace "$JOBJ" --arg p "$p" '.phase=$p'
  [[ $p == executing ]] && { seal "$BOARD"; tracker open; }
  if [[ $p == planning ]]; then
    jq_inplace "$JOBJ" --arg h "$(sha256_of "$JOB_DIR/readiness.json")" --arg t "$(now)" '.frozen = {"readiness_sha256":$h,"at":$t}'
    log_event freeze "readiness + architecture frozen ($(sha256_of "$JOB_DIR/readiness.json" | cut -c1-12))"
  fi
  [[ $p == readiness || $p == planning ]] && { node "$BIN_DIR/roles.mjs" render "$JOB_DIR" >/dev/null && log_event roles "$(jq -r '[.roles[].role] | join(" ")' "$JOBJ")"; }
  reset_stop_guard; log_event phase "$p$([[ $force -eq 1 ]] && echo ' (forced)')"; echo "phase: $p"
}

# jobset may change only what Michael decides (stack, roles, assumptions, areas, settings) — never phase, gates,
# frozen hashes, PR state or ids: those move only through their own guarded commands. Every change is logged.
JOBSET_KEYS='["stack","roles","assumptions","areas","settings"]'
cmd_jobset() {
  load_job; [[ -n ${1:-} ]] || die "usage: dl jobset '<jq expr>'"
  local new; new="$(jq "$1" "$JOBJ")" || die "invalid jq expression"
  local bad; bad="$(jq -rn --argjson a "$(cat "$JOBJ")" --argjson b "$new" --argjson ok "$JOBSET_KEYS" \
    '[($a|keys) + ($b|keys) | unique[] | select(. as $k | ($ok | index($k)) | not) | select($a[.] != $b[.])] | join(", ")')"
  [[ -z $bad ]] || refuse 1 "dl jobset may not change: $bad (use the dl command that owns it)"
  if [[ "$(phase_now)" =~ ^(executing|integrating|closing|awaiting_pr_merge)$ ]]; then
    jq -en --argjson a "$(cat "$JOBJ")" --argjson b "$new" '($a.settings.gates == $b.settings.gates) and ($a.settings.merge_mode == $b.settings.merge_mode)' >/dev/null \
      || refuse 1 "gates and merge_mode are fixed once work has started"
  fi
  local changed; changed="$(jq -rn --argjson a "$(cat "$JOBJ")" --argjson b "$new" --argjson ok "$JOBSET_KEYS" '[$ok[] | select($a[.] != $b[.])] | join(",")')"
  jq_inplace "$JOBJ" "$1"
  [[ -n $changed ]] && log_event jobset "$changed: $1"
  return 0
}

cmd_validate() { load_job; assert_frozen; node "$BIN_DIR/validate.mjs" "$BOARD"; }

sha256_of() { node -e 'process.stdout.write(require("crypto").createHash("sha256").update(require("fs").readFileSync(process.argv[1])).digest("hex"))' "$1"; }
# Once planned, the readiness decisions and the architecture are frozen: every later step checks they are unchanged.
assert_frozen() {
  local want; want="$(jq -r '.frozen.readiness_sha256 // empty' "$JOBJ")"
  [[ -z $want ]] && return 0
  [[ -f $JOB_DIR/readiness.json && "$(sha256_of "$JOB_DIR/readiness.json")" == "$want" ]] \
    || refuse 6 "readiness.json (requirements decisions + architecture) changed after it was frozen at planning. Frozen decisions do not change; only the human can reopen them from a terminal: dl unfreeze \"<reason>\""
}
cmd_unfreeze() {
  human_only "dl unfreeze"; load_job
  local reason=${1:-}; [[ -n $reason ]] || die 'usage: dl unfreeze "<why the frozen decisions must change>"'
  [[ -n "$(jq -r '.frozen.readiness_sha256 // empty' "$JOBJ")" ]] || refuse 1 "nothing is frozen"
  jq_inplace "$JOBJ" --arg r "$reason" --arg t "$(now)" --arg by "${DELIVER_APPROVER:-${USER:-human}}" \
    '.unfreezes = ((.unfreezes // []) + [(.frozen + {"reason":$r,"by":$by,"at":$t})]) | .frozen = null | .phase = "readiness"'
  reset_stop_guard; log_event unfreeze "$reason"; echo "unfrozen — phase readiness. Re-run the readiness review, then dl phase planning (freezes again)."
}

cmd_readiness() {
  load_job
  local rc=0; node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" || rc=$?
  [[ $rc -eq 1 ]] && exit 1
  log_event readiness "$(jq -r '(.items // .) | "\(length) items: \(map(select(.status=="decided"))|length) decided, \(map(select(.status=="n_a"))|length) n/a, \(map(select(.status=="open"))|length) open"' "$JOB_DIR/readiness.json")"
  return 0
}
cmd_decide() {
  load_job
  local id=${1:-} decision=${2:-} why=${3:-}; [[ -n $id && -n $decision && -n $why ]] || die 'usage: dl decide <id> "<decision>" "<rationale>"'
  [[ "$(phase_now)" == readiness || "$(phase_now)" == awaiting_clarification ]] || refuse 1 "decisions are recorded in readiness / awaiting_clarification (now: $(phase_now))"
  node "$BIN_DIR/readiness.mjs" decide "$JOB_DIR" "$id" "$decision" "$why" || exit 1
  node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || true
  reset_stop_guard; log_event decide "$id: $decision — $why"
}
cmd_clarify() {
  human_only "answering a business question (dl clarify)"; load_job
  local id=${1:-} answer=${2:-}; [[ -n $id && -n $answer ]] || die 'usage: dl clarify <id> "<answer>"'
  [[ "$(phase_now)" == readiness || "$(phase_now)" == awaiting_clarification ]] || refuse 1 "clarifications are recorded in readiness / awaiting_clarification (now: $(phase_now))"
  node "$BIN_DIR/readiness.mjs" clarify "$JOB_DIR" "$id" "${DELIVER_APPROVER:-${USER:-human}}" "$answer" || exit 1
  node "$BIN_DIR/readiness.mjs" check "$JOB_DIR" >/dev/null 2>&1 || true
  reset_stop_guard; log_event clarify "$id: $answer"
}

cmd_learn() {
  load_job
  local role=${1:-} text=${2:-}; [[ -n $role && -n $text ]] || die 'usage: dl learn <role|all> "<lesson>"'
  node "$BIN_DIR/knowledge.mjs" learn "$ROOT" "$JOB" "$role" "$text" && log_event learn "$role: $text"
}
cmd_knowledge() {
  resolve_root
  case ${1:-list} in
    list) node "$BIN_DIR/knowledge.mjs" list "$ROOT" "${2:-}" "${3:-}" "${4:-}" ;;
    sync-md) node "$BIN_DIR/knowledge.mjs" sync-md "$ROOT" ;;
    *) die "usage: dl knowledge [list [kind] [role] [stack,…] | sync-md]" ;;
  esac
}

cmd_roles() { load_job; node "$BIN_DIR/roles.mjs" render "$JOB_DIR" && log_event roles "$(jq -r '[.roles[].role] | join(" ")' "$JOBJ")"; }

_wt_reserve() { with_lock assign _wt_reserve_sub "$@"; }
_wt_reserve_sub() { ( _wt_reserve_locked "$@" ); }   # refuse/exit leaves only the subshell, so the lock is always released
_wt_reserve_locked() { # runs in a subshell under the "assign" lock; exits non-zero with the reason when refused
  local card=$1 flag=$2
  [[ "$(phase_now)" == executing ]] || refuse 1 "cards are dispatched only in phase executing (now: $(phase_now))"
  local state attempts max running deps_open
  state="$(card_get "$card" .state)"; attempts="$(card_get "$card" .attempts)"; max="$(setting max_attempts)"
  deps_open="$(jq -r --arg id "$card" '. as $b | .cards[] | select(.id==$id) | [(.depends_on//[])[] as $d
               | select(([$b.cards[] | select(.id==$d) | .state] | first) != "merged") | $d] | join(" ")' "$BOARD")"
  [[ -z $deps_open ]] || refuse 1 "$card depends on unmerged card(s): $deps_open"
  if [[ $flag == --resume ]]; then
    [[ $state == running ]] || refuse 1 "--resume is for cards in state running (now: $state)"
    return 0
  fi
  [[ $state == ready || $state == review ]] || refuse 1 "$card is $state — only ready cards (or review cards being retried) are dispatched"
  if jq -e '.roles[] | select(.role=="ba")' "$JOBJ" >/dev/null && [[ ! -f $JOB_DIR/specs/$card.md ]]; then
    refuse 1 "$card has no BA spec (.work/$JOB/specs/$card.md) — the Business Analyst writes it before the card is assigned"
  fi
  (( attempts < max )) || refuse 4 "$card used $attempts/$max attempts. Mark it: dl card $card state blocked + note; only the human can grant more (dl card $card retry)"
  running="$(jq --arg id "$card" '[.cards[] | select(.state=="running" and .id!=$id)] | length' "$BOARD")"
  (( running < $(setting max_parallel) )) || refuse 5 "max_parallel=$(setting max_parallel) cards are already running"
  # Role capacity: a role with "count": N has N seats (e.g. mobile#1, mobile#2) working in parallel.
  local role cnt used seat
  role="$(card_get "$card" .role)"
  cnt="$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | (.count // 0)] | first // 0' "$JOBJ")"
  used="$(jq --arg r "$role" --arg id "$card" '[.cards[] | select(.state=="running" and .role==$r and .id!=$id)] | length' "$BOARD")"
  if (( cnt > 0 && used >= cnt )); then refuse 5 "all $cnt '$role' seats are busy — another card of this role finishes first"; fi
  # the lowest free seat of the role: <role>#1, <role>#2, …
  seat="$(jq -r --arg r "$role" --arg id "$card" '
    [.cards[] | select(.state=="running" and .role==$r and .id!=$id) | .seat // empty] as $busy
    | first(range(1; 1000) | "\($r)#\(.)" | select(. as $s | $busy | index($s) | not))' "$BOARD")"
  card_set "$card" '(.cards[] | select(.id==$id)) |= (.state="running" | .attempts+=1 | .seat=$s
      | .assignments = ((.assignments // []) + [{"attempt":(.attempts),"agent":.agent,"seat":$s,"by":"michael","at":$t}]))' \
    --arg s "$seat" --arg t "$(now)"
}

cmd_wt() {
  load_job
  local sub=${1:-} card=${2:-} flag=${3:-}; [[ -n $card ]] || die "usage: dl wt add|rm <card> [--resume]"
  card_exists "$card"
  local path="$JOB_DIR/wt/$card" branch
  # The card branch carries the tracker key when there is one (Jira links branches by key), and never changes once made.
  branch="$(card_get "$card" '.branch // empty')"
  [[ -n $branch ]] || branch="$JOB_BRANCH--$card$(card_get "$card" '.tracker.key // "" | if . != "" then "-" + . else "" end')"
  case $sub in
    add)
      # 1. checks + reservation, atomically (two parallel assignments can't take the same seat or exceed a limit);
      # 2. worktree + setup outside the lock, so a slow setup never holds up other assignments.
      assert_frozen
      local prev; prev="$(card_get "$card" '{state, attempts, seat}')"
      _wt_reserve "$card" "$flag" || exit $?
      if [[ ! -d $path ]]; then
        if ! { if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$branch"; then git_locked -C "$ROOT" worktree add -q "$path" "$branch"
               else git_locked -C "$ROOT" worktree add -q -b "$branch" "$path" "$JOB_BRANCH"; fi; }; then
          [[ $flag == --resume ]] || card_set "$card" '(.cards[] | select(.id==$id)) |= (. + $p | .assignments |= .[:-1])' --argjson p "$prev"
          die "could not create the worktree for $card — assignment rolled back"
        fi
        run_setup "$path"
      fi
      card_set "$card" '(.cards[] | select(.id==$id)) |= (.worktree=$p | .branch=$b)' --arg p "$path" --arg b "$branch"
      push_card "$card"
      reset_stop_guard
      log_event "assign" "$card → $(card_get "$card" .agent)$(card_get "$card" '(.seat // "") | if . != "" then " (" + . + ")" else "" end') attempt=$(card_get "$card" .attempts)${flag:+ $flag}"
      tracker sync "$card" --event "assigned by michael to $(card_get "$card" '.seat // .agent') (attempt $(card_get "$card" .attempts))"
      [[ "$(card_get "$card" '.assignments | length')" == 1 || $flag == --resume ]] && tracker branch "$card"
      echo "$path"
      ;;
    rm)
      [[ -d $path ]] && git_locked -C "$ROOT" worktree remove --force "$path"
      log_event "wt-rm" "$card"; echo "removed: $path (branch kept: $branch)"
      ;;
    *) die "usage: dl wt add|rm <card> [--resume]" ;;
  esac
}

CARD_FIELDS="title context verify qa_verify scope qa_scope acceptance depends_on component"
cmd_card_add() { # dl card add <card.json> "<reason>"
  local file=${1:-} reason=${2:-}
  [[ -f $file && -n $reason ]] || die 'usage: dl card add <card.json> "<reason>"'
  [[ "$(phase_now)" =~ ^(planning|awaiting_plan_approval|executing|integrating)$ ]] || refuse 1 "cards are added in planning/executing/integrating (now: $(phase_now))"
  local id; id="$(jq -r '"T-" + ([.cards[].id | ltrimstr("T-") | tonumber] | (max // 0) + 1 | tostring | if length < 2 then "0" + . else . end)' "$BOARD")"
  cp "$BOARD" "$BOARD.bak"
  jq_inplace "$BOARD" --slurpfile c "$file" --arg id "$id" --arg r "$reason" --arg t "$(now)" \
    '.cards += [$c[0] + {id:$id, state:"ready", attempts:0, notes:[], history:[{"at":$t,"by":"michael","change":"added","reason":$r}]}]'
  if ! node "$BIN_DIR/validate.mjs" "$BOARD" > "$JOB_DIR/.validate.out" 2>&1; then
    mv "$BOARD.bak" "$BOARD"; seal "$BOARD"; grep -E '^ERROR' "$JOB_DIR/.validate.out" | grep "$id" >&2; refuse 1 "the new card is invalid — nothing added"
  fi
  rm -f "$BOARD.bak"; log_event card-add "$id: $reason"; tracker open; echo "$id"
}

cmd_card() {
  load_job
  [[ ${1:-} == add ]] && { cmd_card_add "${@:2}"; return; }
  local card=${1:-} what=${2:-} val=${3:-}
  [[ -n $card && -n $what ]] || die "usage: dl card <card> state <state> | note \"<text>\" | retry"
  card_exists "$card"
  local cur; cur="$(card_get "$card" .state)"
  case $what in
    state)
      [[ " $STATES " == *" $val "* ]] || die "invalid state: '$val' — valid: $STATES"
      case "$cur>$val" in
        running\>review | ready\>blocked | running\>blocked | review\>blocked | blocked\>ready | ready\>archived | blocked\>archived) ;;
        *\>merged)  refuse 1 "merged is set only by: dl integrate $card" ;;
        *\>running) refuse 1 "running is set only by: dl wt add $card" ;;
        *) refuse 1 "$card: $cur → $val is not a valid transition" ;;
      esac
      card_set "$card" '(.cards[] | select(.id==$id)).state=$s' --arg s "$val"
      reset_stop_guard; log_event state "$card=$val"; tracker sync "$card" --event "state → $val"; echo "$card → $val" ;;
    note)
      [[ -n $val ]] || die "usage: dl card $card note \"<text>\""
      card_set "$card" '(.cards[] | select(.id==$id)).notes += [{"at":$t,"note":$n}]' --arg n "$val" --arg t "$(now)"
      log_event note "$card: $val" ;;
    set) # dl card <id> set <field> <value | JSON> "<reason>"
      local field=$val value=${4:-} reason=${5:-}
      [[ " $CARD_FIELDS " == *" $field "* && -n $value && -n $reason ]] || die "usage: dl card $card set <$(tr ' ' '|' <<<"$CARD_FIELDS")> <value> \"<reason>\""
      [[ $cur == ready || $cur == blocked ]] || refuse 1 "$card is $cur — a card's contract changes only while it is ready or blocked"
      local json; json="$(jq -c . <<<"$value" 2>/dev/null)" || json="$(jq -cn --arg v "$value" '$v')"
      cp "$BOARD" "$BOARD.bak"
      card_set "$card" '(.cards[] | select(.id==$id)) |= (.history = ((.history // []) + [{"at":$t,"by":"michael","field":$f,"from":.[$f],"to":$v,"reason":$r}]) | .[$f] = $v)' \
        --arg f "$field" --argjson v "$json" --arg r "$reason" --arg t "$(now)"
      if ! node "$BIN_DIR/validate.mjs" "$BOARD" > "$JOB_DIR/.validate.out" 2>&1; then
        mv "$BOARD.bak" "$BOARD"; seal "$BOARD"; grep -E '^ERROR' "$JOB_DIR/.validate.out" >&2; refuse 1 "the change makes the board invalid — reverted"
      fi
      rm -f "$BOARD.bak"; log_event card-set "$card.$field = $(jq -c . <<<"$json" | cut -c1-120) — $reason"
      tracker note "$card" michael "changed $field: $reason"; echo "$card.$field updated" ;;
    retry)
      human_only "granting a blocked card new attempts (dl card retry)"
      [[ $cur == blocked || $cur == ready ]] || refuse 1 "retry is for blocked cards (now: $cur)"
      card_set "$card" '(.cards[] | select(.id==$id)) |= (.attempts=0 | .state="ready")'
      reset_stop_guard; log_event retry "$card (human-granted)"; tracker sync "$card" --event "retry granted by the human"; echo "$card → ready, attempts reset" ;;
    *) die "unknown field: $what" ;;
  esac
}

cmd_gate() {
  load_job
  local card=${1:-}; [[ -n $card ]] || die "usage: dl gate <card>"
  card_exists "$card"
  local wt verify attempt branch scope log head fail=0 tmo
  wt="$(card_get "$card" .worktree)"; verify="$(card_get "$card" .verify)"; attempt="$(card_get "$card" .attempts)"
  branch="$(card_get "$card" .branch)"; scope="$(card_get "$card" '.scope')"
  local qscope qverify qhead; qscope="$(card_get "$card" '.qa_scope // []')"; qverify="$(card_get "$card" '.qa_verify // ""')"; qhead="$(card_get "$card" '.qa.head // ""')"
  [[ -d $wt ]] || die "$card has no worktree — run: dl wt add $card"
  log="$JOB_DIR/gates/$card-a$attempt-$(date +%H%M%S).log"
  tmo="$(setting gate_timeout)"; tmo=${tmo:-1800}
  {
    echo "# gate: $card  attempt: $attempt  $(now)"
    local on; on="$(git -C "$wt" symbolic-ref --short -q HEAD || echo DETACHED)"
    if [[ $on != "$branch" ]]; then echo "FAIL  worktree is on '$on', expected the card branch '$branch'"; fail=1
    else echo "ok    on $branch"; fi

    if [[ -n "$(git -C "$wt" status --porcelain)" ]]; then
      echo "FAIL  uncommitted or untracked changes:"; git -C "$wt" status --porcelain | awk 'NR<=20' | sed 's/^/        /'; fail=1
    else echo "ok    working tree clean"; fi

    local n; n="$(git -C "$wt" rev-list --count "$JOB_BRANCH..HEAD")"
    if [[ $n -eq 0 ]]; then echo "FAIL  no commits on the card branch"; fail=1; else echo "ok    $n commit(s)"; fi

    # --no-renames: a rename shows both paths, so moving a file out of (or into) the scope is caught.
    local out
    out="$(git -C "$wt" diff --no-renames --name-only "$JOB_BRANCH...HEAD" | node "$BIN_DIR/scope.mjs" "$(jq -c --argjson q "$qscope" '. + $q' <<<"$scope")")"
    if [[ -n $out ]]; then
      while IFS= read -r f; do echo "FAIL  out-of-scope file: $f"; done <<<"$out"; fail=1
    else echo "ok    all changes within scope $(jq -c . <<<"$scope") (+ QA tests $(jq -c . <<<"$qscope"))"; fi
    # The QA tests (qa_scope) belong to the QA role: the dev must not write or change them.
    local devfrom="$JOB_BRANCH"; [[ -n $qhead ]] && git -C "$wt" merge-base --is-ancestor "$qhead" HEAD 2>/dev/null && devfrom="$qhead"
    if [[ $(jq length <<<"$qscope") -gt 0 ]]; then
      # QA files are compared blob by blob: changed or deleted since QA's last commit, or added by the dev,
      # fail the gate. Files that only came in by merging the job branch equal the job branch and are ignored.
      local touched="" f
      if [[ -n $qhead && $devfrom == "$qhead" ]]; then
        while IFS= read -r f; do [[ -n $f && "$(blob_at "$wt" "$qhead" "$f")" != "$(blob_at "$wt" HEAD "$f")" ]] && touched+="$f"$'\n'; done < <(qa_files "$wt" "$qhead" "$qscope")
      fi
      while IFS= read -r f; do
        [[ -z $f ]] && continue
        [[ $devfrom == "$qhead" && "$(blob_at "$wt" "$qhead" "$f")" != none ]] && continue
        [[ "$(blob_at "$wt" HEAD "$f")" != "$(blob_at "$wt" "$JOB_BRANCH" "$f")" ]] && touched+="$f"$'\n'
      done < <(qa_files "$wt" HEAD "$qscope")
      touched="${touched%$'\n'}"
      if [[ -n $touched ]]; then while IFS= read -r f; do echo "FAIL  the dev changed a QA test (qa_scope belongs to the QA role): $f"; done <<<"$touched"; fail=1
      else echo "ok    QA tests untouched by the dev"; fi
    fi

    # Commit hygiene: no AI attribution in the delivered history (settings.commit.ai_attribution=false, the default);
    # the role trailer is required only when settings.commit.role_in_message is on.
    if [[ "$(setting commit.ai_attribution)" != true ]]; then
      local attr; attr="$(git -C "$wt" log --format='%H%n%an <%ae>%n%cn <%ce>%n%B%n----' "$JOB_BRANCH..HEAD" \
        | grep -inE 'co-authored-by:.*(claude|anthropic)|generated with \[?claude|🤖 generated|noreply@anthropic\.com|^claude <' | awk 'NR<=3')"
      if [[ -n $attr ]]; then echo "FAIL  AI attribution in the card's commits (settings.commit.ai_attribution=false):"; sed 's/^/        /' <<<"$attr"; fail=1
      else echo "ok    no AI attribution in commits"; fi
    fi
    if [[ "$(setting commit.role_in_message)" == true ]]; then
      local missing; missing="$(git -C "$wt" log --no-merges --format='%h %s%n%b%n----' "$JOB_BRANCH..HEAD" | awk 'BEGIN{RS="----\n"} !/(^|\n)Role: /{split($0,a,"\n"); if (a[1]!="") print a[1]}')"
      if [[ -n $missing ]]; then echo "FAIL  commits without a 'Role: <seat>' trailer (settings.commit.role_in_message=true):"; sed 's/^/        /' <<<"$missing"; fail=1
      else echo "ok    every commit names its role"; fi
    fi

    echo "----- verify: $verify"
    local runner=(bash -c "$verify")
    command -v timeout >/dev/null && runner=(timeout "$tmo" bash -c "$verify")
    if (cd "$wt" && "${runner[@]}") 2>&1; then echo "ok    verify passed"; else echo "FAIL  verify failed (exit $?)"; fail=1; fi
    if [[ -n $qhead && -n $qverify ]]; then # after a QA round the dev's fix must also make the QA tests pass
      echo "----- qa_verify (QA's integration/e2e tests): $qverify"
      local qr=(bash -c "$qverify"); command -v timeout >/dev/null && qr=(timeout "$tmo" bash -c "$qverify")
      if (cd "$wt" && "${qr[@]}") 2>&1; then echo "ok    QA tests pass"; else echo "FAIL  verify failed: QA tests (exit $?)"; fail=1; fi
    fi
  } > "$log" 2>&1 || true
  grep -q '^FAIL' "$log" && fail=1
  head="$(git -C "$wt" rev-parse HEAD)"
  local result=PASS; [[ $fail -eq 0 ]] || result=FAIL
  card_set "$card" '(.cards[] | select(.id==$id)).gate = {"result":$r,"head":$h,"attempt":($a|tonumber),"log":$l,"at":$t}' \
    --arg r "$result" --arg h "$head" --arg a "$attempt" --arg l "$log" --arg t "$(now)"
  # Review the card only after the dev has returned: if it is still running, move it to review.
  [[ "$(card_get "$card" .state)" == running ]] && card_set "$card" '(.cards[] | select(.id==$id)).state="review"'
  reset_stop_guard
  tracker sync "$card"; tracker note "$card" gate "$result — $(grep -c '^ok' "$log") checks ok, $(grep -c '^FAIL' "$log") failed ($(basename "$log"))"
  if [[ $fail -eq 0 ]]; then
    push_card "$card"
    log_event gate "$card PASS"; echo "GATE PASSED: $card  (log: $log)"
  else
    log_event gate "$card FAIL"
    echo "GATE FAILED: $card  (log: $log)"; grep '^FAIL' "$log"
    grep -q '^FAIL  verify' "$log" && { echo "--- tail of the verify output:"; grep -v '^\(ok\|FAIL\)  ' "$log" | tail -n 30; }
    exit 1
  fi
}

cmd_qa() {
  load_job
  local card=${1:-} verdict=${2:-} summary=${3:-}
  [[ -n $card && ( $verdict == pass || $verdict == fail ) && -n $summary ]] || die 'usage: dl qa <card> pass|fail "<summary: AC-n results>"'
  card_exists "$card"
  local br head wt g qscope qverify
  br="$(card_get "$card" .branch)"; head="$(branch_head "$br")"; wt="$(card_get "$card" .worktree)"
  g="$(card_get "$card" .gate.head)"; qscope="$(card_get "$card" '.qa_scope // []')"; qverify="$(card_get "$card" '.qa_verify // ""')"
  [[ "$(card_get "$card" .state)" == review ]] || refuse 1 "$card is $(card_get "$card" .state); QA runs on cards in review"
  gate_holds "$card" "$head" || refuse 1 "$card has no passed gate for its current commit (the dev changed code after the gate?) — run: dl gate $card"
  [[ -d $wt && -z "$(git -C "$wt" status --porcelain)" ]] || refuse 1 "the QA role must commit its tests; the worktree has uncommitted changes ($wt)"
  if [[ $(jq length <<<"$qscope") -gt 0 ]]; then
    local stray; stray="$(outside "$g" "$head" "$qscope")"
    [[ -z $stray ]] || refuse 1 "since the gate, files outside qa_scope changed: $(tr '\n' ' ' <<<"$stray")— QA writes only integration/e2e tests"
    [[ -n "$(git -C "$wt" diff --no-renames --name-only "$JOB_BRANCH...HEAD" | node "$BIN_DIR/scope.mjs" "$qscope" | sort | comm -13 - <(git -C "$wt" diff --no-renames --name-only "$JOB_BRANCH...HEAD" | sort))" ]] \
      || refuse 1 "no QA tests in qa_scope $(jq -c . <<<"$qscope") — the QA role writes integration/e2e tests for the card's acceptance criteria"
  fi
  local qlog="$JOB_DIR/gates/$card-qa-a$(card_get "$card" .attempts)-$(date +%H%M%S).log" qres=PASS
  if [[ -n $qverify ]]; then
    { echo "# qa_verify: $qverify"; (cd "$wt" && bash -c "$qverify") 2>&1; } > "$qlog" 2>&1 || qres=FAIL
    [[ $verdict == pass && $qres == FAIL ]] && { tail -n 25 "$qlog"; refuse 1 "QA reports pass but its tests fail (qa_verify) — see $qlog"; }
  fi
  card_set "$card" '(.cards[] | select(.id==$id)) |= (.qa = {"verdict":$v,"head":$h,"gate_head":$g,"qa_verify":$r,"log":$l,"summary":$s,"at":$t}
      | .qas = ((.qas // []) + [{"verdict":$v,"head":$h,"qa_verify":$r,"summary":$s,"at":$t}]))' \
    --arg v "$verdict" --arg h "$head" --arg g "$g" --arg r "$qres" --arg l "$qlog" --arg s "$summary" --arg t "$(now)"
  push_card "$card"
  reset_stop_guard; log_event qa "$card $verdict (qa_verify $qres) — $summary"
  tracker sync "$card"; tracker note "$card" qa-tester "$verdict (qa_verify $qres): $summary"
  echo "qa: $card $verdict  (qa_verify: $qres)"
}

cmd_review() {
  load_job
  local card=${1:-} verdict=${2:-} summary=${3:-} by=""
  [[ ${4:-} == --by ]] && by=${5:-}
  [[ -n $card && ( $verdict == approve || $verdict == changes ) ]] || die 'usage: dl review <card> approve|changes "<summary>" [--by <reviewer role>]'
  card_exists "$card"
  local head; head="$(branch_head "$(card_get "$card" .branch)")"
  gate_holds "$card" "$head" || refuse 1 "$card has no passed gate for its current commit — run: dl gate $card"
  [[ "$(card_get "$card" .qa.verdict)" == pass && "$(card_get "$card" .qa.head)" == "$head" ]] \
    || refuse 1 "$card has no QA pass on its current commit — the QA/Test role checks the acceptance criteria first (dl qa $card pass|fail)"
  # Reviewers of this card: card.reviewers (the stack reviewer + specialists such as a11y, performance, security), each
  # records its own verdict; the card's review is "approve" only when every one approved this commit.
  local required; required="$(card_get "$card" '(.reviewers // []) | join(" ")')"
  [[ -n $by ]] || by="${required%% *}"; [[ -n $by ]] || by="reviewer"
  if [[ -n $required && " $required " != *" $by "* ]]; then refuse 1 "$by is not a reviewer of $card (reviewers: $required)"; fi
  jq -e --arg r "$by" '.roles[] | select(.role==$r)' "$JOBJ" >/dev/null || [[ -z $required && $by == reviewer ]] || refuse 1 "role '$by' is not on this job"
  card_set "$card" '(.cards[] | select(.id==$id)) |= (
      .reviews = ((.reviews // []) + [{"by":$by,"verdict":$v,"head":$h,"summary":$s,"at":$t}])
      | ((.reviewers // [$by]) ) as $req
      | ([.reviews[] | select(.head==$h)] | group_by(.by) | map(last)) as $latest
      | ($req | map(. as $r | ($latest | map(select(.by==$r)) | first | .verdict) // "pending")) as $vs
      | .review = {"verdict": (if any($vs[]; .=="changes") then "changes" elif all($vs[]; .=="approve") then "approve" else "pending" end),
                   "head":$h, "summary": ([$latest[] | "\(.by): \(.verdict) — \(.summary)"] | join(" | ")),
                   "pending": [$req[] as $r | select(($vs[$req | index($r)]) == "pending") | $r], "at":$t})' \
    --arg by "$by" --arg v "$verdict" --arg h "$head" --arg s "$summary" --arg t "$(now)"
  reset_stop_guard; log_event review "$card $by $verdict${summary:+ — $summary}"
  tracker sync "$card"; tracker note "$card" "$by" "$verdict${summary:+ — $summary}"
  echo "review: $card $by $verdict  (card: $(card_get "$card" .review.verdict)$(card_get "$card" '.review.pending | if length>0 then ", waiting for " + join(", ") else "" end'))"
}

cmd_integrate() {
  load_job; assert_frozen
  local card=${1:-}; [[ -n $card ]] || die "usage: dl integrate <card>"
  card_exists "$card"
  local branch title head
  branch="$(card_get "$card" .branch)"; title="$(card_get "$card" .title)"
  [[ $branch != null ]] || die "$card has no branch"
  head="$(branch_head "$branch")"
  [[ "$(card_get "$card" .state)" == review ]] || refuse 1 "$card is $(card_get "$card" .state), not review"
  gate_holds "$card" "$head" || refuse 1 "$card: the gate has not passed for commit ${head:0:9} — run: dl gate $card"
  [[ "$(card_get "$card" .qa.verdict)" == pass && "$(card_get "$card" .qa.head)" == "$head" ]] \
    || refuse 1 "$card: no QA pass on commit ${head:0:9} — dl qa $card pass|fail"
  [[ "$(card_get "$card" .review.verdict)" == approve && "$(card_get "$card" .review.head)" == "$head" ]] \
    || refuse 1 "$card: no Lead review approval on commit ${head:0:9} — review, then: dl review $card approve"
  [[ -z "$(git -C "$IWT" status --porcelain)" ]] \
    || refuse 1 "the integration worktree has uncommitted changes — nothing may be written there by hand (git -C $IWT status)"
  local mmsg="Merge $card: $title"
  [[ "$(setting commit.role_in_message)" == true ]] && mmsg+=$'\n\n'"Role: michael (integration of $(card_get "$card" '.seat // .role'))"
  if ! git_locked -C "$IWT" merge --no-ff -q -m "$mmsg" "$branch" >/dev/null 2>&1; then
    git_locked -C "$IWT" merge --abort 2>/dev/null || true
    log_event integrate "$card CONFLICT"
    echo "CONFLICT: $card conflicts with $JOB_BRANCH. Re-dispatch the dev (dl wt add $card) with: run 'git merge $JOB_BRANCH' in the worktree, resolve, run verify, commit. Then gate + review + integrate again." >&2
    exit 3
  fi
  card_set "$card" '(.cards[] | select(.id==$id)).state="merged"'
  local path="$JOB_DIR/wt/$card"; [[ -d $path ]] && git_locked -C "$ROOT" worktree remove --force "$path"
  reset_stop_guard; log_event integrate "$card merged"
  tracker sync "$card" --event "merged into $JOB_BRANCH"
  echo "MERGED: $card → $JOB_BRANCH"
}

cmd_verify_all() {
  load_job
  local cmd log head; cmd="$(setting verify_full)"; log="$JOB_DIR/gates/verify-all-$(date +%H%M%S).log"
  [[ -n $cmd ]] || die "verify_full is not set (config.json / .deliver.json)"
  head="$(branch_head "$JOB_BRANCH")"
  echo "verify_full: $cmd  (log: $log)"
  local result=FAIL
  if (cd "$IWT" && bash -c "$cmd") > "$log" 2>&1; then result=PASS; fi
  [[ -z "$(git -C "$IWT" status --porcelain)" ]] || { echo "verify_full left changes in the integration worktree:" >>"$log"; git -C "$IWT" status --porcelain >>"$log"; result=FAIL; }
  jq_inplace "$JOBJ" --arg r "$result" --arg h "$head" --arg l "$log" --arg t "$(now)" '.verify_all = {"result":$r,"head":$h,"log":$l,"at":$t}'
  reset_stop_guard; log_event verify-all "$result"
  if [[ $result == PASS ]]; then echo "PASSED"; else echo "FAILED"; tail -n 40 "$log"; exit 1; fi
}

cmd_approve() { human_only "approving the plan"; _gate_record "${1:-}" approved "${2:-}"; }
cmd_reject()  { human_only "rejecting the plan"; [[ -n ${2:-} ]] || die 'usage: dl reject plan "<what to change>"'; _gate_record "${1:-}" rejected "$2"; }
_gate_record() {
  load_job
  local gate=$1 status=$2 note=$3
  [[ $gate == plan ]] || die "the only human gate before the PR is: plan (merges are decided at the PR — see merge_mode)"
  [[ "$(jq -r .settings.gates.plan "$JOBJ")" == true ]] || refuse 1 "the plan gate is off for this job (settings.gates.plan=false)"
  [[ "$(phase_now)" == "awaiting_${gate}_approval" ]] || refuse 1 "the $gate gate is only answered in phase awaiting_${gate}_approval (now: $(phase_now))"
  jq_inplace "$JOBJ" --arg g "$gate" --arg s "$status" --arg n "$note" --arg by "${DELIVER_APPROVER:-${USER:-human}}" --arg t "$(now)" \
    '.gates[$g] = {"status":$s, "by":$by, "at":$t, "note":$n}'
  reset_stop_guard; log_event "gate-$gate" "$status $note"; echo "$gate: $status"
}

cmd_ship() {
  load_job; assert_frozen
  local mode head base; mode="$(setting merge_mode)"; base="$(jq -r .base_branch "$JOBJ")"; head="$(branch_head "$JOB_BRANCH")"
  [[ " $MERGE_MODES " == *" $mode "* ]] || die "merge_mode must be one of: $MERGE_MODES (now: '$mode')"
  local cur; cur="$(phase_now)"
  [[ $cur == closing || $cur == awaiting_pr_merge ]] || refuse 1 "ship from phase closing (now: $cur)"
  [[ "$(jq -r '.verify_all.result // ""' "$JOBJ")" == PASS && "$(jq -r '.verify_all.head // ""' "$JOBJ")" == "$head" ]] \
    || refuse 1 "verify-all has not passed on the current job branch — dl verify-all"
  ! cmp -s "$JOB_DIR/report.md" "$SKILL_DIR/templates/report.md" || refuse 1 "report.md is still the template — the PM closing check writes it first (it is also the PR body)"
  if [[ $mode == local ]]; then
    local on; on="$(git -C "$ROOT" symbolic-ref --short -q HEAD || true)"
    [[ $on == "$base" ]] || refuse 1 "merge_mode=local merges into '$base' in the main checkout, which is on '${on:-detached}'. Switch it to $base (or merge yourself: git merge --no-ff $JOB_BRANCH)"
    [[ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ]] || refuse 1 "the main checkout has uncommitted changes — commit or stash them first"
    git -C "$ROOT" merge --no-ff -q -m "Merge $JOB_BRANCH: $(jq -r .title "$JOBJ")" "$JOB_BRANCH" || { git -C "$ROOT" merge --abort 2>/dev/null; refuse 3 "merge into $base conflicted (base moved on) — merged nothing"; }
    jq_inplace "$JOBJ" --arg t "$(now)" --arg c "$(git -C "$ROOT" rev-parse HEAD)" '.shipped=true | .delivery={"mode":"local","commit":$c,"at":$t} | .phase="done"'
    reset_stop_guard; log_event ship "local merge into $base"; echo "SHIPPED: $JOB_BRANCH merged into $base (local). Phase: done — dl cleanup"
    return 0
  fi
  git -C "$ROOT" remote get-url origin >/dev/null 2>&1 || refuse 1 "merge_mode=$mode needs a remote 'origin' (or use merge_mode=local)"
  command -v "$GH" >/dev/null || refuse 1 "merge_mode=$mode needs the GitHub CLI (gh auth login)"
  git -C "$IWT" push -q -u origin "$JOB_BRANCH" || die "push of $JOB_BRANCH failed"
  local url; url="$(jq -r '.pr.url // empty' "$JOBJ")"
  if [[ -z $url ]]; then
    url="$("$GH" pr create --base "$base" --head "$JOB_BRANCH" --title "$(jq -r .title "$JOBJ")" --body-file "$JOB_DIR/report.md" | tail -1)" || die "gh pr create failed"
    log_event pr "opened $url"
  else log_event pr "updated $url"; fi
  jq_inplace "$JOBJ" --arg u "$url" --arg t "$(now)" '.pr = ((.pr // {}) + {"url":$u,"state":"OPEN","at":$t}) | .phase="awaiting_pr_merge"'
  case $mode in
    human) echo "PR: $url — waiting for the human to review and merge (merge_mode=human)." ;;
    semi)
      "$GH" pr merge "$url" --auto --merge >/dev/null 2>&1 && log_event pr "auto-merge armed" \
        || echo "dl: warning — could not arm auto-merge (repo setting 'Allow auto-merge' off?); the human merges after approving" >&2
      echo "PR: $url — auto-merge armed: GitHub merges once a human approves and required checks pass (merge_mode=semi)." ;;
    auto)
      local checks rc=0; checks="$("$GH" pr checks "$url" --watch 2>&1)" || rc=$?
      if [[ $rc -ne 0 && $checks != *"no checks"* ]]; then
        log_event pr "checks failed"; echo "PR: $url — CI FAILED, not merged. Add a fix card (dl phase executing), then dl ship again."; echo "$checks" | tail -15; exit 1
      fi
      "$GH" pr merge "$url" --merge >/dev/null || die "gh pr merge failed — see the PR"
      jq_inplace "$JOBJ" '.pr.state="MERGED" | .shipped=true | .phase="done"'
      log_event pr "merged (auto)"; echo "SHIPPED: $url merged automatically after green checks (merge_mode=auto). Phase: done — dl cleanup" ;;
  esac
  reset_stop_guard
}

cmd_pr() {
  load_job
  local url; url="$(jq -r '.pr.url // empty' "$JOBJ")"; [[ -n $url ]] || die "no PR yet — dl ship"
  local st; st="$("$GH" pr view "$url" --json state,reviewDecision,mergeStateStatus -q '"\(.state) \(.reviewDecision) \(.mergeStateStatus)"')" || die "gh pr view failed"
  read -r state review mstate <<<"$st"
  jq_inplace "$JOBJ" --arg s "$state" '.pr.state=$s'
  case $state in
    MERGED) jq_inplace "$JOBJ" '.shipped=true | .phase="done"'; log_event pr "merged"; echo "MERGED: $url — phase done (dl cleanup)" ;;
    CLOSED) jq_inplace "$JOBJ" '.phase="aborted"'; log_event pr "closed without merge"; echo "CLOSED: $url was closed without merging — job aborted" ;;
    *) echo "OPEN: $url  review=${review:-none}  merge-state=${mstate:-?}" ;;
  esac
}

# The instructions of an agent definition, without its Claude Code frontmatter (kit agents, or ECC's from the plugin cache).
agent_body() {
  local a=$1 f=""
  if [[ $a == ecc:* ]]; then f="$(ls -d "$HOME"/.claude/plugins/cache/ecc/*/*/agents/"${a#ecc:}".md 2>/dev/null | tail -1)"
  else for d in "$SKILL_DIR/../../agents" "$HOME/.claude/agents" "$ROOT/.claude/agents"; do [[ -f $d/$a.md ]] && { f="$d/$a.md"; break; }; done; fi
  if [[ -n $f ]]; then awk 'BEGIN{fm=0} /^---$/ && fm<2 {fm++; next} fm>=2 || fm==0' "$f"
  else echo "(agent definition '$a' not found on this machine — follow the role card above)"; fi
}

# Munder Difflin: start a role for a card as an ephemeral worker on the office floor (spawn-request).
# The objective = the role card generated by dl roles (rules + project facts) + the prompt file.
cmd_md_dispatch() {
  load_job
  local card=${1:-} pfile=${2:-} role=${3:-}
  [[ -n $card && -f $pfile ]] || die "usage: dl md-dispatch <card> <prompt-file> [role]   (role default: the card's role)"
  card_exists "$card"
  local hive="${HIVE_ROOT:-$(setting munder.hive_root)}"
  [[ -n $hive && -d $hive ]] || die "HIVE_ROOT is not set — md-dispatch only works inside Munder Difflin (or set settings.munder.hive_root)"
  role=${role:-$(card_get "$card" .role)}
  local state agent; state="$(card_get "$card" .state)"
  agent="$(jq -r --arg r "$role" '.roles[] | select(.role==$r) | .agent' "$JOBJ" | awk 'NR==1')"
  [[ -n $agent ]] || refuse 1 "role '$role' is not selected for this job"
  if [[ $role == "$(card_get "$card" .role)" ]]; then
    [[ $state == running ]] || refuse 1 "dispatch the dev with dl wt add $card first (state now: $state)"
  else
    [[ $state == review ]] || refuse 1 "$role works on cards in review (state now: $state)"
  fi
  local rolecard="$JOB_DIR/roles/$role.md"
  [[ -f $rolecard ]] || cmd_roles >/dev/null
  local wt attempt req model cmd cap provider
  wt="$(card_get "$card" .worktree)"; attempt="$(card_get "$card" .attempts)"
  req="$(printf 'dl-%s-%s-%s-a%s' "${JOB:4:13}" "$card" "$role" "$attempt" | tr -c 'A-Za-z0-9._-' '-')"
  # Model-agnostic: each role may run on any CLI Munder Difflin supports (job.roles[].provider / .model).
  provider="$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | .provider // "claude"] | first' "$JOBJ")"
  model="$(jq -r --arg r "$role" '[.roles[] | select(.role==$r) | .model // empty] | first // empty' "$JOBJ")"; model=${model:-$(setting munder.model)}
  cap="$(setting munder.token_cap)"
  [[ " $MD_PROVIDERS " == *" $provider "* ]] || refuse 1 "provider '$provider' is not one Munder Difflin runs ($MD_PROVIDERS)"
  mkdir -p "$hive/spawn-requests"
  local objective
  if [[ $provider == claude ]]; then
    cmd="$(setting munder.claude_command)"; cmd="${cmd:-claude} --agent $agent"
    objective="$(cat "$rolecard"; printf '\n---\n\n'; cat "$pfile")"
  else
    # Other CLIs have no --agent: the agent definition's instructions travel inside the objective, after the role card.
    cmd=""
    objective="$(cat "$rolecard"; printf '\n---\n\n## Your role instructions (%s)\n\n' "$agent"; agent_body "$agent"; printf '\n---\n\n'; cat "$pfile")"
  fi
  local character accent
  character="$(node "$BIN_DIR/roles.mjs" catalog | jq -r --arg r "$role" '.roles[$r].floor.character // empty')"
  accent="$(node "$BIN_DIR/roles.mjs" catalog | jq -r --arg r "$role" '.roles[$r].floor.accent // empty')"
  jq -n --arg id "$req" --arg obj "$objective" --arg cwd "$wt" --arg name "$card $role" \
        --arg cmd "$cmd" --arg model "$model" --argjson cap "${cap:-0}" --arg ch "$character" --arg ac "$accent" \
    --arg prov "$provider" \
    '{id:$id, objective:$obj, cwd:$cwd, name:$name, isolate:false}
     + (if $cmd != "" then {command:$cmd} else {provider:$prov} end)
     + (if $model != "" then {model:$model} else {} end) + (if $cap > 0 then {tokenCap:$cap} else {} end)
     + (if $ch != "" then {character:$ch} else {} end) + (if $ac != "" then {accent:$ac} else {} end)' \
    > "$hive/spawn-requests/.$req.tmp" && mv "$hive/spawn-requests/.$req.tmp" "$hive/spawn-requests/$req.json"
  card_set "$card" '(.cards[] | select(.id==$id)).md_workers += [{"role":$r,"worker":$w,"provider":$p,"at":$t}]' --arg r "$role" --arg w "worker-$req" --arg p "$provider" --arg t "$(now)"
  log_event md-dispatch "$card $role → worker-$req ($provider${model:+ $model})"
  echo "worker-$req  (request: $hive/spawn-requests/$req.json)"
}

cmd_cleanup() {
  load_job
  local d
  for d in "$JOB_DIR"/wt/*; do
    [[ -d $d && $(basename "$d") != _integration ]] && git -C "$ROOT" worktree remove --force "$d"
  done
  if [[ ${1:-} == --all ]]; then git -C "$ROOT" worktree remove --force "$IWT" 2>/dev/null || true; fi
  [[ "$(cat "$WORK/ACTIVE" 2>/dev/null)" == "$JOB" ]] && rm -f "$WORK/ACTIVE"
  rm -f "$REG/$JOB"
  git -C "$ROOT" worktree prune
  log_event cleanup "${1:-}"; echo "cleaned up: $JOB (branches kept)"
}

# Seat utilisation: which role seats are busy, which are idle — and for each idle one, the work it should take.
SEATS_JQ='. as $b | ($j.roles | map(select(.count != null) | {role, count})) as $caps
  | [ $caps[] as $c | range(1; $c.count + 1) as $n | ($c.role + "#" + ($n|tostring)) as $seat
      | ([$b.cards[] | select(.state=="running" and .seat==$seat) | .id] | first) as $busy
      | ([$b.cards[] | select(.state=="ready" and .role==$c.role and .attempts < $max
            and all((.depends_on // [])[]; . as $d | ([$b.cards[] | select(.id==$d) | .state] | first) == "merged")) | .id]) as $ready
      | ([$b.cards[] | select(.state=="ready" and .role==$c.role) | .id]) as $waiting
      | {seat:$seat, role:$c.role, busy:$busy, ready:$ready, waiting:$waiting} ]'
seats_json() { jq --argjson j "$(cat "$JOBJ")" --argjson max "$(setting max_attempts)" "$SEATS_JQ" "$BOARD"; }
cmd_seats() {
  load_job
  seats_json | jq -r '(["SEAT","STATE","CARD / NEXT"] | @tsv), (.[] | [.seat, (if .busy then "busy" else "IDLE" end),
     (if .busy then .busy elif (.ready|length)>0 then "→ assign " + (.ready|join(", ")) elif (.waiting|length)>0 then "waiting on dependencies of " + (.waiting|join(", ")) else "no work for this role" end)] | @tsv)' | table
  jq -r '[.roles[] | select(.count == null) | .role] | if length>0 then "(roles without a seat count share max_parallel: " + join(", ") + ")" else empty end' "$JOBJ"
}

cmd_kanban() {
  load_job
  node "$BIN_DIR/tracker-cli.mjs" kanban "$JOB_DIR" "$@"
  echo; echo "tracker: $(jq -r '.settings.tracker.kind // "local"' "$JOBJ")$(jq -r '.tracker.url // empty | " · " + .' "$JOBJ")  · html: $JOB_DIR/kanban.html"
}
cmd_tracker() { load_job; case ${1:-sync} in open|sync) with_lock board.json node "$BIN_DIR/tracker-cli.mjs" "${1:-sync}" "$JOB_DIR"; seal "$BOARD"; seal "$JOBJ" ;; *) die "usage: dl tracker [open|sync]" ;; esac; }
cmd_reseal() { # human only (bash-guard): accept the current job.json/board.json after inspecting an outside change
  human_only "dl reseal"; DL_NO_SEAL_CHECK=1 load_job
  local reason=${1:-}; [[ -n $reason ]] || die 'usage: dl reseal "<what was changed outside dl and why it is accepted>"'
  seal "$JOBJ"; seal "$BOARD"; log_event reseal "${DELIVER_APPROVER:-${USER:-human}}: $reason"; echo "resealed"
}

cmd_jobs() {
  [[ -d $REG ]] || { echo "no jobs registered"; return 0; }
  local f id root
  for f in "$REG"/*; do
    [[ -f $f ]] || continue
    id="$(basename "$f")"; root="$(cat "$f")"
    printf '%s\t%s\t%s\n' "$id" "$(jq -r .phase "$root/.work/$id/job.json" 2>/dev/null || echo missing)" "$root"
  done | table
}

main() {
  local c=${1:-help}; shift || true
  case $c in
    new) cmd_new "$@" ;;
    status) cmd_status ;;
    next) cmd_next ;;
    board) cmd_board ;;
    phase) cmd_phase "$@" ;;
    jobset) cmd_jobset "$@" ;;
    validate) cmd_validate ;;
    roles) cmd_roles ;;
    readiness) cmd_readiness ;;
    clarify) cmd_clarify "$@" ;;
    decide) cmd_decide "$@" ;;
    unfreeze) cmd_unfreeze "$@" ;;
    reseal) cmd_reseal "$@" ;;
    learn) cmd_learn "$@" ;;
    knowledge) cmd_knowledge "$@" ;;
    ready) cmd_ready ;;
    wt) cmd_wt "$@" ;;
    card) cmd_card "$@" ;;
    gate) cmd_gate "$@" ;;
    qa) cmd_qa "$@" ;;
    review) cmd_review "$@" ;;
    integrate) cmd_integrate "$@" ;;
    verify-all) cmd_verify_all ;;
    ship) cmd_ship ;;
    pr) cmd_pr ;;
    approve) cmd_approve "$@" ;;
    reject) cmd_reject "$@" ;;
    md-dispatch) cmd_md_dispatch "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    jobs) cmd_jobs ;;
    kanban) cmd_kanban "$@" ;;
    seats) cmd_seats ;;
    tracker) cmd_tracker "$@" ;;
    help|-h|--help) sed -n '2,54p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $c (dl help)" ;;
  esac
}
main "$@"
